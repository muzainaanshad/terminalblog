{
  "name": "seo-ai-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "content-gate": "node scripts/content-gate.cjs",
    "content-gate:strict": "node scripts/content-gate.cjs --strict",
    "quality-check": "node scripts/quality-check.cjs",
    "ping-seo": "node scripts/ping-search-engines.cjs",
    "leaderboard:note": "node scripts/gen-weekly-leaderboard-note.cjs",
    "leaderboard:post": "node scripts/gen-weekly-leaderboard-note.cjs --write-mdx",
    "prepublish-content": "node scripts/content-gate.cjs --strict && node scripts/quality-check.cjs",
    "seo:learn": "node scripts/seo-learn.cjs",
    "debt:report": "node scripts/clear-historical-debt.cjs",
    "debt:fix-tools": "node scripts/clear-historical-debt.cjs --fix-tools",
    "debt:archive-thin": "node scripts/clear-historical-debt.cjs --archive-thin",
    "gsc:setup": "node scripts/setup-gsc-service-account.cjs",
    "gsc:setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-gsc-service-account.ps1",
    "newsletter:draft": "node scripts/send-weekly-beehiiv.cjs",
    "newsletter:send": "node scripts/send-weekly-beehiiv.cjs --send",
    "telegram": "node scripts/telegram-notify.cjs",
    "telegram:digest": "node scripts/telegram-ops-digest.cjs",
    "health": "node scripts/site-health.cjs",
    "content:refresh": "node scripts/content-refresh.cjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@vercel/og": "^0.11.1",
    "astro": "^7.0.6",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.2"
  }
}
