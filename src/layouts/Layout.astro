---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const { title, description, image } = Astro.props as any;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || `/api/og?title=${encodeURIComponent(title)}&description=${encodeURIComponent(description || '')}`;
const isArticle = Astro.url.pathname.startsWith('/blog/');
const pubDate = (Astro.props as any).pubDate;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
    <link rel="author" href="https://github.com/Anshad2u" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title === SITE_TITLE ? SITE_TITLE : `${title} — ${SITE_TITLE}`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="wtyhcMT8NKkGU9vPXOvVvEshhid3dFRK1z7GAZ_0DvI" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G9YFDJFKD3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G9YFDJFKD3');
    </script>
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {isArticle && pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE_TITLE,
        url: Astro.site?.href,
        logo: new URL('/favicon.svg', Astro.site).href,
        sameAs: [
          'https://github.com/Anshad2u/terminalblog',
          'https://github.com/Anshad2u/terminalblog-cli',
        ],
      })}
    </script>

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
          ...(isArticle ? [
            { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', Astro.site).href },
            { '@type': 'ListItem', position: 3, name: title, item: canonicalURL.href },
          ] : []),
          ...(Astro.url.pathname.startsWith('/tool/') ? [
            { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/about/', Astro.site).href },
            { '@type': 'ListItem', position: 3, name: title, item: canonicalURL.href },
          ] : []),
        ],
      })}
    </script>

    <!-- JSON-LD: Article (for blog posts) -->
    {isArticle && pubDate ? (
      <script type="application/ld+json">
        {JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: title,
          description: description,
          datePublished: new Date(pubDate).toISOString(),
          author: {
            '@type': 'Person',
            name: 'Anshad',
            url: 'https://github.com/Anshad2u',
          },
          publisher: {
            '@type': 'Organization',
            name: SITE_TITLE,
          },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
        })}
      </script>
    ) : null}

    <style is:global>
      html, body { min-height: 100vh; }
      body { display: flex; flex-direction: column; }
      main { flex: 1; }
    </style>
  </head>
  <body>
    <header style="border-bottom:1px solid var(--border);background:var(--bg-alt);">
      <nav style="max-width:860px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;gap:1.5rem;height:48px;">
        <a href="/" style="font-family:var(--font-mono);font-size:0.9rem;font-weight:700;color:var(--fg-bright);text-decoration:none;letter-spacing:-0.02em;">
          ~/<span style="color:var(--green);">{SITE_TITLE}</span>
        </a>
        <div style="display:flex;gap:1rem;margin-left:auto;">
          <a href="/" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">home</a>
          <a href="/blog" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">articles</a>
          <a href="/cli" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--green);text-decoration:none;">$ npx terminalblog</a>
          <a href="/about" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">about</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer style="border-top:1px solid var(--border);background:var(--bg-alt);padding:1.5rem;text-align:center;">
      <div class="social-row" style="display:flex;justify-content:center;gap:1rem;margin-bottom:0.8rem;flex-wrap:wrap;">
        <a href="https://github.com/Anshad2u/terminalblog-cli" target="_blank" rel="noopener" title="GitHub" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12 24 5.37 18.63 0 12 0z"/></svg>
        </a>
        <a href="https://x.com/terminalblog_en" target="_blank" rel="noopener" title="X / Twitter" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/terminalblog" target="_blank" rel="noopener" title="LinkedIn" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.facebook.com/terminalblog" target="_blank" rel="noopener" title="Facebook" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.instagram.com/terminalblog" target="_blank" rel="noopener" title="Instagram" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
      <p style="font-family:var(--font-mono);font-size:0.7rem;color:var(--fg-dim);margin:0;">
        {SITE_TITLE} — honest coding agent ecosystem coverage<br/>
        <a href="https://github.com/Anshad2u/terminalblog" style="color:var(--fg-dim);">source</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/rss.xml" style="color:var(--fg-dim);">rss</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/llms.txt" style="color:var(--fg-dim);">llms.txt</a>
      </p>
    </footer>
  </body>
</html>
