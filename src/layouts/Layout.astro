---
import '../styles/global.css';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import StickyBar from '../components/StickyBar.astro';
import ExitPopup from '../components/ExitPopup.astro';
import WelcomeOverlay from '../components/WelcomeOverlay.astro';
import {
  SITE_TITLE,
  SITE_TITLE_HOME,
  SITE_DESCRIPTION,
  EDITOR_NAME,
  EDITOR_URL,
} from '../consts';
import { SITE_URL, SITE_NAME, buildHomeGraph, buildPostGraph } from '../utils/schema';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  robots = 'index, follow',
} = Astro.props as any;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || `/api/og?title=${encodeURIComponent(title)}&description=${encodeURIComponent(description || '')}`;
// Truncate meta description to ≤155 chars for SEO
const metaDescription = (description || '').length > 155
  ? (description || '').slice(0, 152).replace(/\s+\S*$/, '') + '...'
  : description || '';
const isArticle = Astro.url.pathname.startsWith('/blog/');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const pubDate = (Astro.props as any).pubDate;
const updatedDate = (Astro.props as any).updatedDate;
const tags = (Astro.props as any).tags || [];

const pageTitle =
  title === SITE_TITLE || isHome
    ? SITE_TITLE_HOME
    : (() => {
        const dateSuffix = isArticle && pubDate
          ? ` (${new Date(pubDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })})`
          : '';
        const baseSuffix = ` — ${SITE_TITLE}`;
        
        // Try with date first
        const withDate = `${title}${dateSuffix}${baseSuffix}`;
        if (withDate.length <= 60) return withDate;
        
        // Fall back to without date
        const withoutDate = `${title}${baseSuffix}`;
        if (withoutDate.length <= 60) return withoutDate;
        
        // Truncate title to fit
        const maxTitle = 60 - baseSuffix.length;
        return `${title.slice(0, maxTitle)}${baseSuffix}`;
      })();

// Build JSON-LD graph
const graph = isArticle && pubDate
  ? buildPostGraph({
      url: canonicalURL.href,
      title,
      description: description || '',
      publishDate: new Date(pubDate),
      updateDate: updatedDate ? new Date(updatedDate) : undefined,
      tags,
      image: image ? new URL(image.src || image, Astro.site).href : undefined,
    })
  : buildHomeGraph();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <Seo
      title={pageTitle}
      titleTemplate={isHome ? '%s' : '%s'}
      description={metaDescription}
      canonical={canonicalURL.href}
      ogType={isArticle ? 'article' : 'website'}
      ogImage={new URL(ogImage, Astro.site).href}
      ogImageAlt={title}
      ogImageWidth={1200}
      ogImageHeight={630}
      siteName={SITE_NAME}
      twitter={{ site: '@terminalblog_en', card: 'summary_large_image' }}
      article={isArticle && pubDate ? {
        publishedTime: new Date(pubDate),
        modifiedTime: updatedDate ? new Date(updatedDate) : new Date(pubDate),
        authors: [EDITOR_NAME],
        tags,
        section: 'AI Coding Agents',
      } : undefined}
      author={EDITOR_NAME}
      graph={graph}
      robots={robots}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        { rel: 'alternate', type: 'application/rss+xml', title: SITE_TITLE, href: new URL('rss.xml', Astro.site).href },
        { rel: 'author', href: EDITOR_URL },
      ]}
      extraMeta={[
        { name: 'google-site-verification', content: 'wtyhcMT8NKkGU9vPXOvVvEshhid3dFRK1z7GAZ_0DvI' },
      ]}
    />
    <!-- Microsoft Clarity -->
    <script>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", "xnu95lnc4t");
    </script>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G9YFDJFKD3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G9YFDJFKD3');
    </script>
    <style is:global>
      html, body { min-height: 100vh; }
      body { display: flex; flex-direction: column; }
      main { flex: 1; }
    </style>
  </head>
  <body>
    <header style="border-bottom:1px solid var(--border);background:var(--bg-alt);">
      <nav style="max-width:860px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;gap:1.5rem;height:48px;">
        <a href="/" style="font-family:var(--font-mono);font-size:0.9rem;font-weight:700;color:var(--fg-bright);text-decoration:none;letter-spacing:-0.02em;">
          ~/<span style="color:var(--green);">{SITE_TITLE}</span>
        </a>
        <div style="display:flex;gap:1rem;margin-left:auto;align-items:center;">
          <a href="/" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">home</a>
          <a href="/blog" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">articles</a>
          <a href="/leaderboard" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--fg-dim);text-decoration:none;">leaderboard</a>
          <a href="/cli" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--green);text-decoration:none;">cli</a>
          <a href="/search" style="color:var(--fg-dim);text-decoration:none;" title="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer style="border-top:1px solid var(--border);background:var(--bg-alt);padding:1.5rem;text-align:center;">
      <div class="social-row" style="display:flex;justify-content:center;gap:1rem;margin-bottom:0.5rem;">
        <a href="https://github.com/muzainaanshad/terminalblog" target="_blank" rel="noopener" title="GitHub" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.41 9.8 8.11 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61C3.66 18.06 3.05 17.86 3.05 17.86c-1.07-.73.08-.71.08-.71 1.19.08 1.81 1.22 1.81 1.22 1.05 1.79 2.76 1.28 3.44.99.11-.78.41-1.28.75-1.57-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.65 1.65.24 2.87.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1 0.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.7.825.58A12.014 12.014 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://x.com/terminalblog_en" target="_blank" rel="noopener" title="X / Twitter" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/terminalblog" target="_blank" rel="noopener" title="LinkedIn" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.facebook.com/terminalblog" target="_blank" rel="noopener" title="Facebook" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.instagram.com/terminalblog" target="_blank" rel="noopener" title="Instagram" style="color:var(--fg-dim);text-decoration:none;opacity:0.6;transition:opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
      <p style="font-family:var(--font-mono);font-size:0.7rem;color:var(--fg-dim);margin:0;">
        {SITE_TITLE} — honest coding agent ecosystem coverage<br/>
        Edited by <a href={EDITOR_URL} style="color:var(--fg-dim);">{EDITOR_NAME}</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/writers" style="color:var(--fg-dim);">writers</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/about" style="color:var(--fg-dim);">about</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/" style="color:var(--fg-dim);">{SITE_TITLE}</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/rss.xml" style="color:var(--fg-dim);">rss</a>
        <span style="margin:0 0.5rem;">·</span>
        <a href="/llms.txt" style="color:var(--fg-dim);">llms.txt</a>
      </p>
    </footer>
    <StickyBar />
    <ExitPopup />
    <WelcomeOverlay />
  </body>
</html>
