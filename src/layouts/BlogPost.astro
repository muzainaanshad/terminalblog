---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="content">
    <header style="margin-bottom:2.5rem;">
      <p style="font-family:var(--font-lipi-sans);font-size:0.8rem;color:var(--muted-foreground);margin-bottom:0.5rem;">
        <FormattedDate date={pubDate} />
        {updatedDate && <span style="margin-left:0.75rem;">· Updated <FormattedDate date={updatedDate} /></span>}
      </p>
      <h1 style="font-size:2rem;margin:0;">{title}</h1>
    </header>
    <slot />
  </article>
</Layout>
