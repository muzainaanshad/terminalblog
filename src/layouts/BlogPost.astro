---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { authors } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'] & {
  slug?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
};
const { title, description, pubDate, updatedDate, tags, tool, image, slug, relatedPosts, author: authorId } = Astro.props;

const toolNames: Record<string, string> = {
  hermes: 'Hermes Agent', opencode: 'OpenCode', mimo: 'Mimo Code',
  kilo: 'Kilo Code CLI', 'pi-dot-dev': 'pi.dev', 'gitlawb-zero': 'Gitlawb Zero',
  'oh-my-pi': 'Oh My Pi', 'claude-code': 'Claude Code', goose: 'Goose',
  openclaw: 'OpenClaw', codebuff: 'Codebuff', cursor: 'Cursor',
  codex: 'OpenAI Codex', ampcode: 'AmpCode', 'copilot-cli': 'GitHub Copilot CLI',
};

const author = authors[authorId] || authors.kira;
const articleUrl = `https://terminalblog.com/blog/${slug || ''}/`;
const shareText = encodeURIComponent(`${title} — terminalblog`);
const shareUrl = encodeURIComponent(articleUrl);
---

<Layout title={title} description={description || ''} image={image} pubDate={pubDate} updatedDate={updatedDate} tags={tags}>
  <article class="content" style="max-width:860px;margin:0 auto;padding:0 1.5rem;">
    <header style="margin-bottom:2rem;">
      <p style="font-family:var(--font-mono);font-size:0.75rem;color:var(--fg-dim);margin-bottom:0.5rem;">
        <FormattedDate date={pubDate} />
        {updatedDate && <span style="margin-left:0.75rem;">· Updated <FormattedDate date={updatedDate} /></span>}
      </p>
      <h1 style="font-size:1.8rem;margin:0;line-height:1.3;">{title}</h1>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:1rem;">
        {tool && <a href={`/tool/${tool}/`} class="tool-badge">{toolNames[tool] || tool}</a>}
        {(tags || []).map(tag => (
          <a href={`/blog/tag/${tag}/`} class="tag-badge">#{tag}</a>
        ))}
      </div>
    </header>

    <div class="post-body">
      <slot />
    </div>

    <!-- Inline affiliate CTA (randomly selected per article) -->
    <div class="inline-affiliate" style="margin:2rem 0;padding:1rem 1.2rem;border:1px solid var(--border);border-left:3px solid var(--amber);border-radius:6px;background:var(--bg-alt);">
      <script is:inline>
        const __affs = [
          { name: 'ShipKit', desc: 'Production-ready Better Auth starter for SaaS — shipped in an afternoon.', url: 'https://betterauth.app?via=TerminalBlog', cta: 'Check ShipKit →' },
          { name: 'RankPill', desc: 'AI writes daily SEO articles and builds backlinks automatically.', url: 'https://rankpill.com?via=TerminalBlog', cta: 'Check RankPill →' },
          { name: 'aiFiesta', desc: 'Discover and compare AI tools — updated daily.', url: 'https://aifiesta.link/muhammed-anshad', cta: 'Browse aiFiesta →' },
          { name: 'ScrollLaunch', desc: 'Launch your product and get discovered by early adopters.', url: 'https://www.scrolllaunch.com/?via=TerminalBlog', cta: 'Check ScrollLaunch →' }
        ];
        const __a = __affs[Math.floor(Math.random() * __affs.length)];
        document.write(`<div style="font-family:var(--font-mono);font-size:0.7rem;color:var(--amber);margin-bottom:0.3rem;">RECOMMENDED</div><div style="font-size:0.85rem;margin-bottom:0.3rem;">${__a.desc}</div><a href="${__a.url}" target="_blank" rel="noopener nofollow" style="font-family:var(--font-mono);font-size:0.8rem;color:var(--green);text-decoration:none;">${__a.cta}</a>`);
      </script>
    </div>

    <!-- Affiliate disclosure (site-wide; some posts include partner CTAs) -->
    <aside class="affiliate-disclosure" role="note">
      <strong>Disclosure:</strong> Some articles include affiliate links. We may earn a commission if you buy through them. Rankings and recommendations are not sold.
      See <a href="/about/">about</a> for editorial policy.
    </aside>

    <!-- AUTHOR CARD -->
    <section class="author-card">
      <div class="author-avatar" style={`background: ${author.avatar}`}>
        <span class="author-initial">{author.name[0]}</span>
      </div>
      <div class="author-info">
        <div class="author-name">{author.name}</div>
        <div class="author-role">{author.role}</div>
        <div class="author-bio">{author.bio}</div>
      </div>
    </section>

    <!-- SOCIAL SHARE -->
    <section class="social-share">
      <span class="share-label">Share this article</span>
      <div class="share-buttons">
        <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" class="share-btn share-x" title="Share on X">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" class="share-btn share-linkedin" title="Share on LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={`https://news.ycombinator.com/submitlink?u=${shareUrl}&t=${shareText}`} target="_blank" rel="noopener" class="share-btn share-hn" title="Share on Hacker News">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M0 0v24h24V0H0zm12.7 13.5v6.1h-1.5v-6.1L7 4.4h1.7l3.4 6.5 3.4-6.5H17l-4.3 9.1z"/></svg>
        </a>
        <a href={`https://reddit.com/submit?url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener" class="share-btn share-reddit" title="Share on Reddit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
        </a>
        <button class="share-btn share-copy" title="Copy link" onclick={`navigator.clipboard.writeText('${articleUrl}').then(()=>{this.innerHTML='<svg width=\\'16\\' height=\\'16\\' viewBox=\\'0 0 24 24\\' fill=\\'none\\' stroke=\\'#22c55e\\' stroke-width=\\'2\\'><polyline points=\\'20 6 9 17 4 12\\'/></svg>';setTimeout(()=>{this.innerHTML='<svg width=\\'16\\' height=\\'16\\' viewBox=\\'0 0 24 24\\' fill=\\'none\\' stroke=\\'currentColor\\' stroke-width=\\'2\\' stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\'><path d=\\'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\\'/><path d=\\'M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\\'/></svg>'},2000)})`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
      </div>
    </section>

    {relatedPosts && relatedPosts.length > 0 && (
      <section style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);">
        <h2 style="font-size:1.1rem;margin-bottom:1rem;">Related articles</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.8rem;">
          {relatedPosts.map(p => (
            <a href={`/blog/${p.id}/`} class="related-card">
              <div class="related-meta">
                {new Date(p.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </div>
              <div class="related-title">{p.data.title}</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <style>
    .affiliate-disclosure {
      margin: 1.5rem 0 0;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-left: 3px solid var(--green);
      border-radius: 4px;
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--fg-dim);
      font-family: var(--font-mono);
    }
    .affiliate-disclosure a { color: var(--green); }
    .affiliate-disclosure strong { color: var(--fg); font-weight: 600; }
    .tool-badge {
      font-family:var(--font-mono);font-size:0.7rem;
      background:var(--green);color:#000;
      padding:0.15rem 0.6rem;border-radius:4px;text-decoration:none;
    }
    .tag-badge {
      font-family:var(--font-mono);font-size:0.7rem;
      background:var(--border);color:var(--fg-dim);
      padding:0.15rem 0.6rem;border-radius:4px;text-decoration:none;
    }
    .tag-badge:hover { color:var(--green); }
    .related-card {
      display:block;padding:0.75rem;
      border:1px solid var(--border);border-radius:6px;
      text-decoration:none;transition:border-color 0.15s;
    }
    .related-card:hover { border-color:var(--green); }
    .related-meta {
      font-family:var(--font-mono);font-size:0.6rem;
      color:var(--fg-dim);margin-bottom:0.3rem;
    }
    .related-title {
      font-size:0.8rem;color:var(--fg);line-height:1.3;
    }
    .post-body h2 { font-size:1.2rem;margin:1.5rem 0 0.75rem; }
    .post-body h3 { font-size:1rem;margin:1.2rem 0 0.5rem; }
    .post-body p { line-height:1.7;margin:0 0 1rem; }
    .post-body table { width:100%;border-collapse:collapse;margin:1rem 0;font-size:0.8rem; }
    .post-body th, .post-body td { padding:0.4rem 0.6rem;border:1px solid var(--border);text-align:left; }
    .post-body th { background:var(--bg-alt);font-family:var(--font-mono);font-size:0.75rem; }
    .post-body td { font-family:var(--font-mono);font-size:0.75rem; }

    /* Author Card */
    .author-card {
      display:flex;gap:1rem;align-items:flex-start;
      margin-top:2.5rem;padding:1.2rem;
      border:1px solid var(--border);border-radius:8px;
      background:var(--bg-alt);
    }
    .author-avatar { 
      flex-shrink:0;
      width:44px;height:44px;
      border-radius:8px;
      display:flex;align-items:center;justify-content:center;
    }
    .author-initial {
      font-family:var(--font-mono);
      font-size:1rem;font-weight:700;
      color:#fff;
    }
    .author-info { flex:1; }
    .author-name {
      font-family:var(--font-mono);font-size:0.9rem;
      color:var(--green);font-weight:600;margin-bottom:0.1rem;
    }
    .author-role {
      font-family:var(--font-mono);font-size:0.7rem;
      color:var(--fg-dim);margin-bottom:0.5rem;
    }
    .author-bio {
      font-size:0.8rem;color:var(--fg);line-height:1.5;
      font-style:italic;
    }

    /* Social Share */
    .social-share {
      display:flex;align-items:center;gap:0.75rem;
      margin-top:1.5rem;padding-top:1.5rem;
      border-top:1px solid var(--border);
    }
    .share-label {
      font-family:var(--font-mono);font-size:0.7rem;
      color:var(--fg-dim);white-space:nowrap;
    }
    .share-buttons {
      display:flex;gap:0.4rem;flex-wrap:wrap;
    }
    .share-btn {
      display:inline-flex;align-items:center;justify-content:center;
      width:32px;height:32px;border-radius:6px;
      border:1px solid var(--border);background:transparent;
      color:var(--fg-dim);cursor:pointer;text-decoration:none;
      transition:all 0.15s;
    }
    .share-btn:hover { border-color:var(--green);color:var(--green); }
    .share-x:hover { border-color:#1da1f2;color:#1da1f2; }
    .share-linkedin:hover { border-color:#0077b5;color:#0077b5; }
    .share-hn:hover { border-color:#ff6600;color:#ff6600; }
    .share-reddit:hover { border-color:#ff4500;color:#ff4500; }
    .share-copy:hover { border-color:var(--green);color:var(--green); }
  </style>
</Layout>
