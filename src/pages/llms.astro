---
import Layout from '../layouts/Layout.astro';
import { buildHomeGraph } from '../utils/schema';

const SITE_URL = 'https://terminalblog.com';
const SITE_NAME = 'terminalblog';
const canonicalURL = `${SITE_URL}/llms.txt`;
const graph = buildHomeGraph();

const metaDescription = 'terminalblog LLM index — AI coding agent ecosystem coverage for language models. 15 agents, 500+ articles, pricing, security, comparisons. No sponsorships, no paid reviews.';
const ogImage = '/api/og?title=LLMs.txt&description=AI+coding+agent+ecosystem+coverage';
---

<Layout
  title="LLMs.txt — terminalblog"
  description={metaDescription}
  image={ogImage}
  robots="index, follow"
  graph={graph}
>
  <main style="max-width:860px;margin:0 auto;padding:0 1.5rem;">
    <h1 style="font-size:1.75rem;margin-bottom:0.5rem;">LLMs.txt</h1>
    <p style="color:var(--fg-dim);margin-bottom:2.5rem;font-size:0.85rem;font-family:var(--font-mono);">AI-readable index for terminalblog.com</p>

    <section style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">About</h2>
      <p>terminalblog is a publication covering the AI coding agent space. We track 15 coding agents across pricing, features, benchmarks, and real-world usage. No sponsorships, no paid reviews.</p>
      <p>Updated every 3 hours. 500+ articles. 15 agents tracked.</p>
    </section>

    <section style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">Key pages</h2>
      <ul style="line-height:2;">
        <li><a href="https://terminalblog.com/">Homepage</a></li>
        <li><a href="https://terminalblog.com/blog/">All articles</a></li>
        <li><a href="https://terminalblog.com/#comparison">Agent comparison</a></li>
        <li><a href="https://terminalblog.com/about/">About / agent list</a></li>
      </ul>
    </section>

    <section style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">Agent tool pages</h2>
      <ul style="line-height:2;">
        <li><a href="https://terminalblog.com/tool/claude-code/">Claude Code</a></li>
        <li><a href="https://terminalblog.com/tool/cursor/">Cursor</a></li>
        <li><a href="https://terminalblog.com/tool/hermes/">Hermes Agent</a></li>
        <li><a href="https://terminalblog.com/tool/codex/">OpenAI Codex</a></li>
        <li><a href="https://terminalblog.com/tool/opencode/">OpenCode</a></li>
        <li><a href="https://terminalblog.com/tool/mimo/">Mimo Code</a></li>
        <li><a href="https://terminalblog.com/tool/kilo/">Kilo Code</a></li>
        <li><a href="https://terminalblog.com/tool/pi-dot-dev/">pi.dev</a></li>
        <li><a href="https://terminalblog.com/tool/gitlawb-zero/">Gitlawb Zero</a></li>
        <li><a href="https://terminalblog.com/tool/oh-my-pi/">Oh My Pi</a></li>
        <li><a href="https://terminalblog.com/tool/goose/">Goose</a></li>
        <li><a href="https://terminalblog.com/tool/openclaw/">OpenClaw</a></li>
        <li><a href="https://terminalblog.com/tool/codebuff/">Codebuff</a></li>
        <li><a href="https://terminalblog.com/tool/ampcode/">AmpCode</a></li>
        <li><a href="https://terminalblog.com/tool/copilot-cli/">GitHub Copilot CLI</a></li>
      </ul>
    </section>

    <section style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">Tag pages</h2>
      <ul style="line-height:2;">
        <li><a href="https://terminalblog.com/blog/tag/comparison/">Comparisons</a></li>
        <li><a href="https://terminalblog.com/blog/tag/opinion/">Opinion</a></li>
        <li><a href="https://terminalblog.com/blog/tag/deep-dive/">Deep dives</a></li>
        <li><a href="https://terminalblog.com/blog/tag/beginner-guide/">Beginner guides</a></li>
        <li><a href="https://terminalblog.com/blog/tag/workflow/">Workflow</a></li>
      </ul>
    </section>

    <section style="margin-bottom:2rem;">
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">Full article list</h2>
      <p>To get the complete list of all recent articles, visit: <a href="https://terminalblog.com/blog/">https://terminalblog.com/blog/</a></p>
    </section>

    <section>
      <h2 style="font-size:1.1rem;margin-bottom:1rem;">CLI tool</h2>
      <p><code>npx terminalblog</code> — Get the latest articles from your terminal.</p>
      <p><a href="https://github.com/Anshad2u/terminalblog-cli">https://github.com/Anshad2u/terminalblog-cli</a></p>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonicalURL,
    url: canonicalURL,
    name: 'LLMs.txt — terminalblog',
    description: metaDescription,
    publisher: {
      '@type': 'Person',
      '@id': `${SITE_URL}/#/schema.org/Person`,
      name: 'Anshad',
      url: 'https://github.com/Anshad2u'
    },
    isPartOf: {
      '@id': `${SITE_URL}/#/schema.org/WebSite`
    }
  }, null, 2)} />
</Layout>