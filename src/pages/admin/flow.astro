---
import { checkAuth } from '../../middleware/auth';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

// Redirect flow page to main dashboard automation section
return Astro.redirect('/admin#automation');
---
<html><head><meta http-equiv="refresh" content="0;url=/admin#automation" /></head><body>
<script>window.location.href = '/admin#automation';</script>
<p>Redirecting to <a href="/admin#automation">/admin#automation</a>...</p>
</body></html>
