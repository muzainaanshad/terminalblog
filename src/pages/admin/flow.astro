---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';
import fs from 'fs';
import path from 'path';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

// Read cron state
let cronData = [];
try {
  const stateFile = path.join(process.cwd(), 'tmp', 'cron-state.json');
  if (fs.existsSync(stateFile)) {
    cronData = JSON.parse(fs.readFileSync(stateFile, 'utf8'));
  }
} catch {}

// Read article memory
let articleMemory = { articles: [], topics: {} };
try {
  const memFile = path.join(process.cwd(), 'src', 'data', 'article-memory.json');
  if (fs.existsSync(memFile)) {
    articleMemory = JSON.parse(fs.readFileSync(memFile, 'utf8'));
  }
} catch {}

// Count articles
let articleCount = 0;
try {
  const blogDir = path.join(process.cwd(), 'src', 'content', 'blog');
  articleCount = fs.readdirSync(blogDir).filter(f => f.endsWith('.mdx')).length;
} catch {}
---

