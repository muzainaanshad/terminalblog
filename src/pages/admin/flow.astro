---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';

export const prerender = false;

// Auth check
const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Automation Flow - terminalblog">
  <div class="min-h-screen bg-[#0a0a0a]">
    <!-- Header -->
    <header class="bg-[#111] border-b border-[#22c55e]/20 p-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <span class="text-[#22c55e] text-2xl">⚡</span>
          <h1 class="text-xl font-mono text-[#22c55e]">terminalblog</h1>
          <span class="text-[#f59e0b] text-sm">Automation Flow</span>
        </div>
        <a href="/admin" class="px-4 py-2 bg-[#22c55e]/20 text-[#22c55e] rounded hover:bg-[#22c55e]/30 font-mono text-sm">
          ← Back to Dashboard
        </a>
      </div>
    </header>

    <main class="max-w-7xl mx-auto p-6">
      <!-- Flow Legend -->
      <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-4 mb-8">
        <h2 class="text-lg font-mono text-[#22c55e] mb-4">How Your Automations Work</h2>
        <div class="flex flex-wrap gap-4 text-sm">
          <div class="flex items-center space-x-2">
            <div class="w-4 h-4 bg-green-500 rounded"></div>
            <span class="text-gray-400">Running Successfully</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-4 h-4 bg-yellow-500 rounded"></div>
            <span class="text-gray-400">Paused</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-4 h-4 bg-red-500 rounded"></div>
            <span class="text-gray-400">Error</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-4 h-4 bg-blue-500 rounded"></div>
            <span class="text-gray-400">Scheduled (Next Run)</span>
          </div>
        </div>
      </div>

      <!-- Flow Diagram -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Content Pipeline -->
        <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-6">
          <h3 class="text-lg font-mono text-[#22c55e] mb-4">📝 Content Pipeline</h3>
          <div class="space-y-4">
            <!-- Step 1 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#22c55e]/20 rounded-full flex items-center justify-center text-[#22c55e] font-mono text-sm">1</div>
              <div class="flex-1">
                <div class="text-white font-mono">Commit Watcher</div>
                <div class="text-gray-500 text-sm">Monitors 19 agent repos</div>
                <div class="text-xs text-gray-600">Every 3h → Finds releases</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#22c55e]/30 h-4"></div>
            <!-- Step 2 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#22c55e]/20 rounded-full flex items-center justify-center text-[#22c55e] font-mono text-sm">2</div>
              <div class="flex-1">
                <div class="text-white font-mono">Article Generator</div>
                <div class="text-gray-500 text-sm">Creates blog posts</div>
                <div class="text-xs text-gray-600">3 PM daily → 1 article max</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#22c55e]/30 h-4"></div>
            <!-- Step 3 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#22c55e]/20 rounded-full flex items-center justify-center text-[#22c55e] font-mono text-sm">3</div>
              <div class="flex-1">
                <div class="text-white font-mono">Quality Improver</div>
                <div class="text-gray-500 text-sm">Fixes thin articles</div>
                <div class="text-xs text-gray-600">4 AM daily → ≤2 updates</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#22c55e]/30 h-4"></div>
            <!-- Step 4 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#22c55e]/20 rounded-full flex items-center justify-center text-[#22c55e] font-mono text-sm">4</div>
              <div class="flex-1">
                <div class="text-white font-mono">Deploy to Vercel</div>
                <div class="text-gray-500 text-sm">Auto-deploys on push</div>
                <div class="text-xs text-gray-600">Instant → terminalblog.com</div>
              </div>
            </div>
          </div>
        </div>

        <!-- SEO Pipeline -->
        <div class="bg-[#111] border border-blue-500/20 rounded-lg p-6">
          <h3 class="text-lg font-mono text-blue-400 mb-4">🔍 SEO Pipeline</h3>
          <div class="space-y-4">
            <!-- Step 1 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-sm">1</div>
              <div class="flex-1">
                <div class="text-white font-mono">Ping Search Engines</div>
                <div class="text-gray-500 text-sm">Notifies Google, Bing, Yandex</div>
                <div class="text-xs text-gray-600">Every 6h → IndexNow + sitemap</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-blue-500/30 h-4"></div>
            <!-- Step 2 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-sm">2</div>
              <div class="flex-1">
                <div class="text-white font-mono">SEO Autopilot</div>
                <div class="text-gray-500 text-sm">Monitors rankings</div>
                <div class="text-xs text-gray-600">6 AM daily → Score tracking</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-blue-500/30 h-4"></div>
            <!-- Step 3 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-sm">3</div>
              <div class="flex-1">
                <div class="text-white font-mono">Weekly Monitor</div>
                <div class="text-gray-500 text-sm">DA, rankings, audits</div>
                <div class="text-xs text-gray-600">Monday 9 AM → Full report</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-blue-500/30 h-4"></div>
            <!-- Step 4 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-sm">4</div>
              <div class="flex-1">
                <div class="text-white font-mono">Backlink Outreach</div>
                <div class="text-gray-500 text-sm">Finds link opportunities</div>
                <div class="text-xs text-gray-600">10 AM daily → HARO + mentions</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Pipeline -->
        <div class="bg-[#111] border border-[#f59e0b]/20 rounded-lg p-6">
          <h3 class="text-lg font-mono text-[#f59e0b] mb-4">🐦 Social Pipeline</h3>
          <div class="space-y-4">
            <!-- Step 1 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-sm">1</div>
              <div class="flex-1">
                <div class="text-white font-mono">MyMarky Daily</div>
                <div class="text-gray-500 text-sm">AI generates posts</div>
                <div class="text-xs text-gray-600">8 AM daily → Twitter/LinkedIn</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#f59e0b]/30 h-4"></div>
            <!-- Step 2 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-sm">2</div>
              <div class="flex-1">
                <div class="text-white font-mono">Terminal Tool Tweets</div>
                <div class="text-gray-500 text-sm">Viral format posts</div>
                <div class="text-xs text-gray-600">Mon/Wed/Fri 12 PM → X/Twitter</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#f59e0b]/30 h-4"></div>
            <!-- Step 3 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-sm">3</div>
              <div class="flex-1">
                <div class="text-white font-mono">Cross-post to Dev.to</div>
                <div class="text-gray-500 text-sm">Blog articles shared</div>
                <div class="text-xs text-gray-600">With each new article</div>
              </div>
            </div>
            <!-- Arrow -->
            <div class="ml-4 border-l-2 border-[#f59e0b]/30 h-4"></div>
            <!-- Step 4 -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-sm">4</div>
              <div class="flex-1">
                <div class="text-white font-mono">Ops Digest (Telegram)</div>
                <div class="text-gray-500 text-sm">Daily summary</div>
                <div class="text-xs text-gray-600">1 PM UTC → Telegram notification</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline View -->
      <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-6 mb-8">
        <h3 class="text-lg font-mono text-[#22c55e] mb-6">📅 Daily Timeline (Saudi Time)</h3>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-[#22c55e]/20"></div>
          
          <!-- 2 AM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-mono text-xs z-10">2AM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Adoption Tracker</div>
              <div class="text-gray-500 text-sm">Snapshots agent data (npm, GitHub)</div>
            </div>
          </div>
          
          <!-- 4 AM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-mono text-xs z-10">4AM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Article Quality Improver</div>
              <div class="text-gray-500 text-sm">Expands thin articles, fixes staleness</div>
            </div>
          </div>
          
          <!-- 6 AM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-xs z-10">6AM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">SEO Autopilot + Daily Summary</div>
              <div class="text-gray-500 text-sm">Rank tracking + GHA summary</div>
            </div>
          </div>
          
          <!-- 8 AM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-xs z-10">8AM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">MyMarky Social Posts</div>
              <div class="text-gray-500 text-sm">AI generates + schedules posts</div>
            </div>
          </div>
          
          <!-- 10 AM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-xs z-10">10AM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Backlink Outreach</div>
              <div class="text-gray-500 text-sm">Finds HARO + mention opportunities</div>
            </div>
          </div>
          
          <!-- 12 PM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-[#f59e0b]/20 rounded-full flex items-center justify-center text-[#f59e0b] font-mono text-xs z-10">12PM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Terminal Tool Tweets</div>
              <div class="text-gray-500 text-sm">Viral format posts (Mon/Wed/Fri)</div>
            </div>
          </div>
          
          <!-- 1 PM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-purple-500/20 rounded-full flex items-center justify-center text-purple-400 font-mono text-xs z-10">1PM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Ops Digest (Telegram)</div>
              <div class="text-gray-500 text-sm">Combined daily summary</div>
            </div>
          </div>
          
          <!-- 3 PM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-mono text-xs z-10">3PM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Blog Article Generator</div>
              <div class="text-gray-500 text-sm">Creates 1 quality article</div>
            </div>
          </div>
          
          <!-- 4 PM -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-mono text-xs z-10">4PM</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">GitHub Issues Watcher</div>
              <div class="text-gray-500 text-sm">Monitors 19 agent repos for issues</div>
            </div>
          </div>
          
          <!-- Every 3h -->
          <div class="flex items-start mb-6">
            <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center text-green-400 font-mono text-xs z-10">3h</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Commit Watcher (Every 3h)</div>
              <div class="text-gray-500 text-sm">Releases, breaking changes, features</div>
            </div>
          </div>
          
          <!-- Every 6h -->
          <div class="flex items-start">
            <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-mono text-xs z-10">6h</div>
            <div class="ml-4 flex-1">
              <div class="text-white font-mono">Ping Search Engines (Every 6h)</div>
              <div class="text-gray-500 text-sm">IndexNow + Bing + Google/Yandex</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Overview -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Recent Activity -->
        <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-6">
          <h3 class="text-lg font-mono text-[#22c55e] mb-4">📊 Recent Activity</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">3 PM: Article Generator</span>
              <span class="text-green-400">✓ Created "Beware: EDR Rules"</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">8 AM: MyMarky</span>
              <span class="text-green-400">✓ 2 posts scheduled</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">6 AM: SEO Autopilot</span>
              <span class="text-green-400">✓ Rankings stable</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">4 AM: Quality Improver</span>
              <span class="text-green-400">✓ 2 articles expanded</span>
            </div>
          </div>
        </div>

        <!-- System Health -->
        <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-6">
          <h3 class="text-lg font-mono text-[#22c55e] mb-4">💚 System Health</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">Bynara API (5M tokens/day)</span>
              <span class="text-green-400">✓ Healthy</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">GitHub API (5K req/hour)</span>
              <span class="text-green-400">✓ Healthy</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">Telegram Bot</span>
              <span class="text-green-400">✓ Active</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">MyMarky API</span>
              <span class="text-green-400">✓ Active</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-400">Vercel Deploy</span>
              <span class="text-green-400">✓ Auto-deploy</span>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
