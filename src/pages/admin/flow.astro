---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Automation Flow - terminalblog">
  <div style="min-height:100vh;background:#0a0a0a;color:#e0e0e0;font-family:'JetBrains Mono',monospace;">
    <!-- Top bar -->
    <div style="position:sticky;top:0;z-index:100;background:#111;border-bottom:1px solid #22c55e20;padding:0.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <a href="/admin" style="color:#22c55e;text-decoration:none;font-size:0.8rem;">← Dashboard</a>
        <span style="color:#f59e0b;font-size:0.85rem;">Automation Flow</span>
      </div>
      <span style="color:#555;font-size:0.7rem;">terminalblog.com</span>
    </div>

    <!-- Canvas -->
    <div style="padding:2rem;overflow-x:auto;">
      <div style="max-width:1400px;margin:0 auto;">
        
        <!-- Title -->
        <div style="text-align:center;margin-bottom:2rem;">
          <h1 style="font-size:1.4rem;color:#22c55e;margin:0;">End-to-End Automation Flow</h1>
          <p style="font-size:0.75rem;color:#666;margin:0.5rem 0 0;">How terminalblog.com runs autonomously — from code commit to published article</p>
        </div>

        <!-- Flow container -->
        <div style="display:grid;grid-template-columns:1fr;gap:2rem;">
          
          <!-- ═══ CONTENT PIPELINE ═══ -->
          <div style="border:1px solid #22c55e30;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#22c55e;color:#000;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">01</span>
              <h2 style="font-size:0.9rem;color:#22c55e;margin:0;">Content Pipeline</h2>
              <span style="font-size:0.65rem;color:#666;margin-left:auto;">Every 3h + daily</span>
            </div>
            
            <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;">
              <!-- Node 1 -->
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">📡 TRIGGER</div>
                <div style="font-size:0.75rem;color:#fff;">Commit Watcher</div>
                <div style="font-size:0.6rem;color:#666;">Every 3h · 19 repos</div>
              </div>
              
              <div style="color:#22c55e;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <!-- Node 2 -->
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">🧠 DECIDE</div>
                <div style="font-size:0.75rem;color:#fff;">Article Memory</div>
                <div style="font-size:0.6rem;color:#666;">361 indexed · dedup check</div>
              </div>
              
              <div style="color:#22c55e;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <!-- Node 3 -->
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">✍️ WRITE</div>
                <div style="font-size:0.75rem;color:#fff;">Article Generator</div>
                <div style="font-size:0.6rem;color:#666;">3 PM daily · 1 max</div>
              </div>
              
              <div style="color:#22c55e;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <!-- Node 4 -->
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">✅ GATE</div>
                <div style="font-size:0.75rem;color:#fff;">Content Gate</div>
                <div style="font-size:0.6rem;color:#666;">≥600w · no duplicates</div>
              </div>
              
              <div style="color:#22c55e;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <!-- Node 5 -->
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">🚀 DEPLOY</div>
                <div style="font-size:0.75rem;color:#fff;">Vercel Auto</div>
                <div style="font-size:0.6rem;color:#666;">git push → live</div>
              </div>
            </div>
          </div>

          <!-- ═══ QUALITY PIPELINE ═══ -->
          <div style="border:1px solid #f59e0b30;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#f59e0b;color:#000;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">02</span>
              <h2 style="font-size:0.9rem;color:#f59e0b;margin:0;">Quality Pipeline</h2>
              <span style="font-size:0.65rem;color:#666;margin-left:auto;">Daily 4 AM</span>
            </div>
            
            <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;">
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">🔍 SCAN</div>
                <div style="font-size:0.75rem;color:#fff;">Find Thin Articles</div>
                <div style="font-size:0.6rem;color:#666;">&lt;600w · stale &gt;45d</div>
              </div>
              
              <div style="color:#f59e0b;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">📝 EXPAND</div>
                <div style="font-size:0.75rem;color:#fff;">Quality Improver</div>
                <div style="font-size:0.6rem;color:#666;">4 AM daily · 2 max</div>
              </div>
              
              <div style="color:#f59e0b;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:140px;">
                <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">🔄 MEMORY</div>
                <div style="font-size:0.75rem;color:#fff;">Update Article Memory</div>
                <div style="font-size:0.6rem;color:#666;">tags, topics, links</div>
              </div>
            </div>
          </div>

          <!-- ═══ SEO PIPELINE ═══ -->
          <div style="border:1px solid #3b82f630;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#3b82f6;color:#fff;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">03</span>
              <h2 style="font-size:0.9rem;color:#3b82f6;margin:0;">SEO Pipeline</h2>
              <span style="font-size:0.65rem;color:#666;margin-left:auto;">Every 6h + daily + weekly</span>
            </div>
            
            <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;">
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#3b82f6;margin-bottom:0.2rem;">📡 PING</div>
                <div style="font-size:0.75rem;color:#fff;">Search Engines</div>
                <div style="font-size:0.6rem;color:#666;">Every 6h · IndexNow</div>
              </div>
              
              <div style="color:#3b82f6;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#3b82f6;margin-bottom:0.2rem;">📊 TRACK</div>
                <div style="font-size:0.75rem;color:#fff;">SEO Autopilot</div>
                <div style="font-size:0.6rem;color:#666;">6 AM daily · scores</div>
              </div>
              
              <div style="color:#3b82f6;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#3b82f6;margin-bottom:0.2rem;">🔗 BUILD</div>
                <div style="font-size:0.75rem;color:#fff;">Backlink Outreach</div>
                <div style="font-size:0.6rem;color:#666;">10 AM daily · HARO</div>
              </div>
              
              <div style="color:#3b82f6;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#3b82f6;margin-bottom:0.2rem;">📈 AUDIT</div>
                <div style="font-size:0.75rem;color:#fff;">Weekly Monitor</div>
                <div style="font-size:0.6rem;color:#666;">Monday 9 AM · DA + rankings</div>
              </div>
            </div>
          </div>

          <!-- ═══ SOCIAL PIPELINE ═══ -->
          <div style="border:1px solid #a855f730;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#a855f7;color:#fff;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">04</span>
              <h2 style="font-size:0.9rem;color:#a855f7;margin:0;">Social Pipeline</h2>
              <span style="font-size:0.65rem;color:#666;margin-left:auto;">Daily + weekly batch</span>
            </div>
            
            <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;">
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#a855f7;margin-bottom:0.2rem;">🤖 GENERATE</div>
                <div style="font-size:0.75rem;color:#fff;">MyMarky AI</div>
                <div style="font-size:0.6rem;color:#666;">8 AM daily · 3 posts</div>
              </div>
              
              <div style="color:#a855f7;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#a855f7;margin-bottom:0.2rem;">📱 POST</div>
                <div style="font-size:0.75rem;color:#fff;">Twitter / LinkedIn</div>
                <div style="font-size:0.6rem;color:#666;">Auto-publish</div>
              </div>
              
              <div style="color:#a855f7;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#a855f7;margin-bottom:0.2rem;">🔧 TOOL TWEETS</div>
                <div style="font-size:0.75rem;color:#fff;">Terminal Tools</div>
                <div style="font-size:0.6rem;color:#666;">Mon/Wed/Fri · weekly batch</div>
              </div>
              
              <div style="color:#a855f7;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#a855f7;margin-bottom:0.2rem;">📝 CROSSPOST</div>
                <div style="font-size:0.75rem;color:#fff;">Dev.to</div>
                <div style="font-size:0.6rem;color:#666;">With each article</div>
              </div>
            </div>
          </div>

          <!-- ═══ MONITORING PIPELINE ═══ -->
          <div style="border:1px solid #ef444430;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#ef4444;color:#fff;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">05</span>
              <h2 style="font-size:0.9rem;color:#ef4444;margin:0;">Monitoring + Reporting</h2>
              <span style="font-size:0.65rem;color:#666;margin-left:auto;">Daily + real-time</span>
            </div>
            
            <div style="display:flex;align-items:center;gap:0;flex-wrap:wrap;">
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#ef4444;margin-bottom:0.2rem;">📊 SNAPSHOTS</div>
                <div style="font-size:0.75rem;color:#fff;">Adoption Tracker</div>
                <div style="font-size:0.6rem;color:#666;">2 AM daily · npm + GitHub</div>
              </div>
              
              <div style="color:#ef4444;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#ef4444;margin-bottom:0.2rem;">⚠️ ISSUES</div>
                <div style="font-size:0.75rem;color:#fff;">Issues Watcher</div>
                <div style="font-size:0.6rem;color:#666;">4 PM daily · 19 repos</div>
              </div>
              
              <div style="color:#ef4444;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#ef4444;margin-bottom:0.2rem;">📋 DIGEST</div>
                <div style="font-size:0.75rem;color:#fff;">Ops Digest</div>
                <div style="font-size:0.6rem;color:#666;">1 PM UTC · Telegram</div>
              </div>
              
              <div style="color:#ef4444;font-size:1.2rem;padding:0 0.3rem;">→</div>
              
              <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem 0.8rem;min-width:130px;">
                <div style="font-size:0.65rem;color:#ef4444;margin-bottom:0.2rem;">💬 TELEGRAM</div>
                <div style="font-size:0.75rem;color:#fff;">Notifications</div>
                <div style="font-size:0.6rem;color:#666;">7 messages/day max</div>
              </div>
            </div>
          </div>

          <!-- ═══ DAILY TIMELINE ═══ -->
          <div style="border:1px solid #22c55e30;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#22c55e;color:#000;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">⏰</span>
              <h2 style="font-size:0.9rem;color:#22c55e;margin:0;">Daily Timeline (Saudi Time)</h2>
            </div>
            
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.6rem;">
              {[
                { time: '2 AM', name: 'Adoption Tracker', color: '#ef4444', desc: 'npm + GitHub snapshots' },
                { time: '4 AM', name: 'Quality Improver', color: '#f59e0b', desc: 'Expand thin articles' },
                { time: '6 AM', name: 'SEO Autopilot', color: '#3b82f6', desc: 'Score tracking' },
                { time: '7 AM', name: 'Daily Insights', color: '#22c55e', desc: 'Telegram summary' },
                { time: '8 AM', name: 'MyMarky Posts', color: '#a855f7', desc: 'AI social posts' },
                { time: '10 AM', name: 'Backlink Outreach', color: '#3b82f6', desc: 'HARO + mentions' },
                { time: '12 PM', name: 'Tool Tweets', color: '#a855f7', desc: 'Mon/Wed/Fri' },
                { time: '1 PM', name: 'Ops Digest', color: '#22c55e', desc: 'Telegram report' },
                { time: '3 PM', name: 'Article Generator', color: '#22c55e', desc: '1 quality article' },
                { time: '4 PM', name: 'Issues Watcher', color: '#ef4444', desc: '19 agent repos' },
                { time: 'Every 3h', name: 'Commit Watcher', color: '#22c55e', desc: 'Releases + features' },
                { time: 'Every 6h', name: 'Ping Engines', color: '#3b82f6', desc: 'IndexNow + Bing' },
              ].map(item => (
                <div style={`background:#0a0a0a;border:1px solid ${item.color}30;border-radius:6px;padding:0.5rem 0.7rem;border-left:3px solid ${item.color};`}>
                  <div style={`font-size:0.65rem;color:${item.color};margin-bottom:0.15rem;font-weight:700;`}>{item.time}</div>
                  <div style="font-size:0.75rem;color:#fff;">{item.name}</div>
                  <div style="font-size:0.6rem;color:#666;">{item.desc}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- ═══ TELEGRAM FORMAT ═══ -->
          <div style="border:1px solid #22c55e30;border-radius:8px;padding:1.5rem;background:#111;">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;">
              <span style="background:#22c55e;color:#000;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.7rem;font-weight:700;">💬</span>
              <h2 style="font-size:0.9rem;color:#22c55e;margin:0;">Telegram Message Format</h2>
            </div>
            
            <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:1rem;font-size:0.75rem;line-height:1.6;max-width:500px;">
              <div style="color:#22c55e;font-weight:700;margin-bottom:0.5rem;">📋 Articles Management</div>
              <div style="color:#fff;">1- 2 new articles created</div>
              <div style="color:#888;padding-left:1rem;">• Beware: Codex encrypts subagent instructions</div>
              <div style="color:#888;padding-left:1rem;">• Beware: Gitlawb Zero MCP trust boundary</div>
              <div style="color:#fff;">2- 1 existing article updated</div>
              <div style="color:#888;padding-left:1rem;">• Claude Code lock issues fix (refreshed data)</div>
              <div style="color:#fff;">3- 0 Articles deleted</div>
              <div style="color:#fff;">4- 3 New Interlinks</div>
              <div style="margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid #333;">
                <div style="color:#f59e0b;font-weight:700;">Others</div>
                <div style="color:#888;">1- new seo learning (omitted)</div>
                <div style="color:#888;">2- leaderboard updates (omitted)</div>
                <div style="color:#888;">3- automation errors (omitted)</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>
