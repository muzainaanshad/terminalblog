---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

// ── Helpers ──────────────────────────────────────────────
const ROOT = path.resolve(process.cwd());
function safeJson(rel: string): any {
  try { return JSON.parse(fs.readFileSync(path.join(ROOT, rel), 'utf-8')); } catch { return null; }
}

// ── Cron data ────────────────────────────────────────────
const crons = [
  { name: 'Content Refresh Queue', slug: 'content-refresh', schedule: '0 5 * * 3', scheduleLabel: 'Wed 05:00 UTC', category: 'content', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Refresh evergreen articles flagged for update. Read article-memory.json for needsUpdate=true entries, pick the top-priority ones, rewrite with fresh data and examples. Gate-check each output before saving.', lastRun: '2026-07-16T05:00:00Z', nextRun: '2026-07-23T05:00:00Z' },
  { name: 'Daily Summary', slug: 'daily-summary', schedule: '0 3 * * *', scheduleLabel: 'Daily 06:00 AST', category: 'ops', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Compile daily summary of all cron runs, article publications, and site metrics. Send formatted report to Telegram in Articles Management format.', lastRun: '2026-07-17T03:00:00Z', nextRun: '2026-07-18T03:00:00Z' },
  { name: 'Leaderboard Snapshot', slug: 'leaderboard-snapshot', schedule: '0 12 * * *', scheduleLabel: 'Daily 12:00 UTC', category: 'monitoring', status: 'active', model: 'none', prompt: 'Take daily adoption leaderboard snapshot. Fetch current star counts, contributor stats, and trending repos. Save historical data for trend analysis.', lastRun: '2026-07-17T12:00:00Z', nextRun: '2026-07-18T12:00:00Z' },
  { name: 'Ops Digest', slug: 'ops-digest', schedule: '0 13 * * *', scheduleLabel: 'Daily 13:00 UTC', category: 'ops', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Generate Telegram ops digest in Articles Management format. Summarize: new articles published, updates made, cron successes/failures, site health status. Include action items if any.', lastRun: '2026-07-17T13:00:00Z', nextRun: '2026-07-18T13:00:00Z' },
  { name: 'SEO Learn', slug: 'seo-learn', schedule: '0 6 * * 1', scheduleLabel: 'Mon 06:00 UTC', category: 'seo', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Weekly SEO learnings report. Analyze Search Console data, identify top-performing queries, click-through patterns, and pages needing optimization. Generate actionable recommendations.', lastRun: '2026-07-14T06:00:00Z', nextRun: '2026-07-21T06:00:00Z' },
  { name: 'Site Health', slug: 'site-health', schedule: '0 */6 * * *', scheduleLabel: 'Every 6 hours', category: 'monitoring', status: 'active', model: 'none', prompt: 'Run automated site health checks: verify all published URLs return 200, check for broken internal links, validate RSS feed, test OG images, and confirm sitemap freshness.', lastRun: '2026-07-17T12:00:00Z', nextRun: '2026-07-17T18:00:00Z' },
  { name: 'Weekly Newsletter', slug: 'weekly-newsletter', schedule: '0 14 * * 1', scheduleLabel: 'Mon 14:00 UTC', category: 'content', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Compile weekly Coding Agent digest for Beehiiv newsletter. Pick top 5-7 articles from the week, write editorial intro, format for email delivery. Send via Beehiiv API.', lastRun: '2026-07-14T14:00:00Z', nextRun: '2026-07-21T14:00:00Z' },
  { name: 'Deploy Notify', slug: 'deploy-notify', schedule: 'on push', scheduleLabel: 'Vercel auto', category: 'ops', status: 'muted', model: 'none', prompt: 'MUTED — Deploy notifications disabled per user request. Vercel handles deployment via Git integration. No Telegram ping on deploy.', lastRun: '2026-07-17T00:00:00Z', nextRun: '—' },
];

const categoryColors: Record<string, string> = {
  content: '#22c55e',
  seo: '#3b82f6',
  social: '#a855f7',
  ops: '#f59e0b',
  monitoring: '#06b6d4',
};
const categoryLabels: Record<string, string> = {
  content: '📝 Content',
  seo: '🔍 SEO',
  social: '🐦 Social',
  ops: '⚙️ Ops',
  monitoring: '📡 Monitoring',
};
const categoryOrder = ['content', 'seo', 'social', 'ops', 'monitoring'];

// Group crons by category
const cronGroups: Record<string, typeof crons> = {};
for (const c of crons) {
  if (!cronGroups[c.category]) cronGroups[c.category] = [];
  cronGroups[c.category].push(c);
}

// ── Article memory for daily progress ────────────────────
const mem = safeJson('src/data/article-memory.json');
const memArticles: Record<string, any> = mem?.articles ?? {};
const totalInMemory = Object.keys(memArticles).length;
const needsUpdateCount = Object.values(memArticles).filter((v: any) => v.needsUpdate).length;
const blogDir = path.join(ROOT, 'src', 'content', 'blog');
let totalMdx = 0;
try { totalMdx = fs.readdirSync(blogDir).filter(f => f.endsWith('.mdx')).length; } catch {}

// ── Today's date for progress section ────────────────────
const today = new Date().toISOString().split('T')[0];
---

