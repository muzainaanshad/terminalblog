---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

const affiliates = [
  {
    name: 'aiFiesta',
    url: 'https://aifiesta.link/muhammed-anshad',
    description: 'AI tools directory and discovery platform',
    commission: '10% lifetime recurring',
    category: 'ai-tools',
    placements: ['leaderboard', 'compare', 'tool-pages'],
    status: 'active'
  },
  {
    name: 'ShipKit (Better Auth)',
    url: 'https://betterauth.app?via=TerminalBlog',
    description: 'Production-ready Better Auth starter kit for SaaS. Orgs, billing, admin panel.',
    commission: '30% per sale ($53 Solo / $149 Agency)',
    category: 'developer-tools',
    placements: ['tool-pages', 'blog-posts', 'homepage'],
    status: 'active'
  },
  {
    name: 'RankPill',
    url: 'https://rankpill.com?via=TerminalBlog',
    description: 'AI-powered SEO automation. Daily articles, backlinks, keyword research.',
    commission: 'Recurring (check program)',
    category: 'seo-tools',
    placements: ['blog-posts', 'guides', 'homepage'],
    status: 'active'
  },
  {
    name: 'ScrollLaunch',
    url: 'https://www.scrolllaunch.com/?via=TerminalBlog',
    description: 'Product launch platform for indie makers. Weekly rankings, backlinks, exposure.',
    commission: 'Per sale (check program)',
    category: 'launch-tools',
    placements: ['blog-posts', 'guides'],
    status: 'active'
  }
];
---

<Layout title="Affiliates - terminalblog Admin">
  <div style="min-height:100vh;background:#0a0a0a;color:#e0e0e0;font-family:'JetBrains Mono',monospace;">
    <!-- Top bar -->
    <div style="position:sticky;top:0;z-index:100;background:#111;border-bottom:1px solid #22c55e20;padding:0.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:1rem;">
        <a href="/admin" style="color:#22c55e;text-decoration:none;font-size:0.8rem;">← Dashboard</a>
        <a href="/admin/flow" style="color:#f59e0b;text-decoration:none;font-size:0.8rem;">Flow</a>
        <span style="color:#fff;font-size:0.85rem;">Affiliates</span>
      </div>
      <span style="color:#555;font-size:0.7rem;">terminalblog.com</span>
    </div>

    <div style="max-width:900px;margin:0 auto;padding:2rem;">
      <h1 style="font-size:1.2rem;color:#22c55e;margin:0 0 0.5rem;">Affiliate Partners</h1>
      <p style="font-size:0.75rem;color:#666;margin:0 0 2rem;">All affiliate links used across terminalblog.com. Links use <code style="color:#f59e0b;">rel="nofollow"</code> and are labeled "Recommended" (never "Sponsored").</p>

      <div style="display:grid;gap:1rem;">
        {affiliates.map(aff => (
          <div style="background:#111;border:1px solid #22c55e20;border-radius:8px;padding:1.2rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;">
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <span style="background:#22c55e;color:#000;padding:0.15rem 0.5rem;border-radius:4px;font-size:0.65rem;font-weight:700;">{aff.category}</span>
                <span style="font-size:0.9rem;color:#fff;font-weight:600;">{aff.name}</span>
              </div>
              <span style="background:#22c55e20;color:#22c55e;padding:0.15rem 0.5rem;border-radius:4px;font-size:0.65rem;">{aff.status}</span>
            </div>
            <p style="font-size:0.8rem;color:#ccc;margin:0 0 0.5rem;">{aff.description}</p>
            <div style="display:flex;gap:1.5rem;font-size:0.7rem;">
              <div>
                <span style="color:#666;">Commission: </span>
                <span style="color:#f59e0b;">{aff.commission}</span>
              </div>
              <div>
                <span style="color:#666;">Placements: </span>
                <span style="color:#aaa;">{aff.placements.join(', ')}</span>
              </div>
            </div>
            <div style="margin-top:0.5rem;">
              <a href={aff.url} target="_blank" rel="noopener nofollow" style="color:#22c55e;font-size:0.75rem;text-decoration:none;">
                {aff.url} ↗
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Usage Stats -->
      <div style="margin-top:2rem;background:#111;border:1px solid #22c55e20;border-radius:8px;padding:1.2rem;">
        <h2 style="font-size:0.9rem;color:#22c55e;margin:0 0 1rem;">Usage Across Site</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.8rem;">
          <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem;">
            <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">HOMEPAGE</div>
            <div style="font-size:0.75rem;color:#fff;">ShipKit + RankPill</div>
            <div style="font-size:0.6rem;color:#666;">Banner sections</div>
          </div>
          <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem;">
            <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">EVERY ARTICLE</div>
            <div style="font-size:0.75rem;color:#fff;">Random 1 of 4</div>
            <div style="font-size:0.6rem;color:#666;">Inline CTA after content</div>
          </div>
          <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem;">
            <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">LEADERBOARD</div>
            <div style="font-size:0.75rem;color:#fff;">aiFiesta</div>
            <div style="font-size:0.6rem;color:#666;">Tool comparison links</div>
          </div>
          <div style="background:#0a0a0a;border:1px solid #333;border-radius:6px;padding:0.6rem;">
            <div style="font-size:0.65rem;color:#f59e0b;margin-bottom:0.2rem;">TOOL PAGES</div>
            <div style="font-size:0.75rem;color:#fff;">ShipKit + aiFiesta</div>
            <div style="font-size:0.6rem;color:#666;">Contextual recommendations</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
