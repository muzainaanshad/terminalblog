---
/**
 * /admin/stats — Affiliate link analytics dashboard
 *
 * Shows click stats for all affiliate links.
 * Reads from Vercel KV (Upstash Redis).
 *
 * Setup: Enable KV in Vercel dashboard → Settings → Storage → Create Database
 *        Env vars auto-set: KV_REST_API_URL + KV_REST_API_TOKEN
 *
 * Usage: Visit /admin/stats to see analytics
 */

export const prerender = false;

import affiliates from '../../data/affiliates.json';

// Try to import Vercel KV
let kv: any = null;
try {
  const kvModule = await import('@vercel/kv');
  kv = kvModule.kv;
} catch {
  // KV not installed
}

interface ClickEntry {
  slug: string;
  timestamp: string;
  ip: string;
  userAgent: string;
  referrer: string;
}

let totalClicks = 0;
let bySlug: Record<string, number> = {};
let byDay: Record<string, number> = {};
let byReferrer: Record<string, number> = {};
let recentClicks: ClickEntry[] = [];

if (kv) {
  // Read from KV
  totalClicks = parseInt(await kv.get('clicks:count:total') || '0');

  // Per-affiliate counts
  for (const aff of affiliates.affiliates) {
    const count = parseInt(await kv.get(`clicks:count:${aff.id}`) || '0');
    if (count > 0) bySlug[aff.id] = count;
  }

  // Recent clicks (last 20)
  const raw = await kv.lrange('clicks:all', 0, 19);
  recentClicks = (raw || []).map((r: string) => {
    try { return JSON.parse(r); } catch { return null; }
  }).filter(Boolean);

  // Derive daily and referrer stats from recent clicks
  // (For full stats, would need to iterate — keeping it lightweight)
  recentClicks.forEach((c: ClickEntry) => {
    const day = c.timestamp.split('T')[0];
    byDay[day] = (byDay[day] || 0) + 1;
    const ref = c.referrer === 'direct' ? 'direct' : (() => { try { return new URL(c.referrer).hostname; } catch { return c.referrer; } })();
    byReferrer[ref] = (byReferrer[ref] || 0) + 1;
  });
}

const affMap = Object.fromEntries(affiliates.affiliates.map(a => [a.id, a]));
const topSlugs = Object.entries(bySlug).sort((a, b) => b[1] - a[1]);
const topDays = Object.entries(byDay).sort((a, b) => b[0].localeCompare(a[0])).slice(0, 14);
const topReferrers = Object.entries(byReferrer).sort((a, b) => b[1] - a[1]).slice(0, 10);
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, follow">
  <title>Affiliate Stats — terminalblog</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'SF Mono', 'Fira Code', monospace;
      background: #0a0a0a;
      color: #e5e5e5;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    h1 { color: #22c55e; font-size: 1.5rem; margin-bottom: 0.5rem; }
    .subtitle { color: #666; font-size: 0.8rem; margin-bottom: 2rem; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .stat-card {
      background: #111;
      border: 1px solid #222;
      border-radius: 8px;
      padding: 1.25rem;
    }
    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #666;
      margin-bottom: 0.5rem;
    }
    .stat-value { font-size: 2rem; font-weight: 700; color: #22c55e; }
    .stat-sub { font-size: 0.75rem; color: #888; margin-top: 0.25rem; }
    .section { margin-bottom: 2rem; }
    .section-title {
      font-size: 1rem;
      color: #f5f5f5;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #222;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid #1a1a1a;
    }
    th {
      color: #22c55e;
      font-weight: 600;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    td { color: #ccc; }
    tr:hover td { background: #111; }
    .bar {
      height: 6px;
      background: #22c55e;
      border-radius: 3px;
      margin-top: 0.3rem;
    }
    .click-row {
      display: grid;
      grid-template-columns: 100px 80px 1fr 1fr 120px;
      gap: 0.5rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid #1a1a1a;
      font-size: 0.75rem;
    }
    .click-row:hover { background: #111; }
    .click-time { color: #666; font-family: monospace; }
    .click-slug { color: #22c55e; font-weight: 600; }
    .click-ref { color: #888; }
    .click-ua { color: #555; }
    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #555;
    }
    .empty-state h2 { color: #333; font-size: 1.2rem; margin-bottom: 0.5rem; }
    a { color: #22c55e; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .note {
      background: #111;
      border: 1px solid #222;
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 2rem;
      font-size: 0.8rem;
      color: #888;
      line-height: 1.6;
    }
    .note code { color: #22c55e; }
  </style>
</head>
<body>
  <h1>📊 Affiliate Link Analytics</h1>
  <p class="subtitle">terminalblog.com — {totalClicks.toLocaleString()} total clicks tracked</p>

  {!kv ? (
    <div class="note">
      <strong>⚠️ Vercel KV not configured.</strong><br />
      Clicks are logged to console only. To enable persistent storage and this dashboard:<br />
      1. Go to <a href="https://vercel.com/dashboard/stores" target="_blank">Vercel Dashboard → Storage</a><br />
      2. Create a KV database (Upstash Redis, free tier)<br />
      3. Connect it to your project — env vars auto-set<br />
      4. Redeploy<br /><br />
      <strong>Usage:</strong> Link to <code>/api/go/aifiesta</code> instead of the raw affiliate URL.
    </div>
  ) : null}

  {totalClicks === 0 && kv ? (
    <div class="empty-state">
      <h2>No clicks yet</h2>
      <p>Clicks will appear here once users start clicking /api/go/ links.</p>
      <p style="margin-top: 1rem; color: #444;">
        Usage: Link to <code>/api/go/aifiesta</code> instead of the raw affiliate URL.
      </p>
    </div>
  ) : (
    <>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Total Clicks</div>
          <div class="stat-value">{totalClicks.toLocaleString()}</div>
          <div class="stat-sub">all time</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Unique Days</div>
          <div class="stat-value">{Object.keys(byDay).length}</div>
          <div class="stat-sub">days with clicks</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Top Affiliate</div>
          <div class="stat-value">{topSlugs[0]?.[0] || '—'}</div>
          <div class="stat-sub">{topSlugs[0]?.[1] || 0} clicks</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Active Affiliates</div>
          <div class="stat-value">{topSlugs.length}</div>
          <div class="stat-sub">with clicks</div>
        </div>
      </div>

      {topSlugs.length > 0 && (
        <div class="section">
          <h2 class="section-title">Clicks by Affiliate</h2>
          <table>
            <thead>
              <tr>
                <th>Affiliate</th>
                <th>Clicks</th>
                <th>% of Total</th>
                <th>Commission</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {topSlugs.map(([slug, count]) => {
                const aff = affMap[slug];
                const pct = ((count / totalClicks) * 100).toFixed(1);
                return (
                  <tr>
                    <td>
                      <strong>{aff?.name || slug}</strong>
                      <br />
                      <span style="color:#555;font-size:0.7rem;">/api/go/{slug}</span>
                    </td>
                    <td>
                      {count.toLocaleString()}
                      <div class="bar" style={`width: ${Math.min(count / topSlugs[0][1] * 100, 100)}%`}></div>
                    </td>
                    <td>{pct}%</td>
                    <td style="font-size:0.7rem;color:#888;">{aff?.commission || '—'}</td>
                    <td>
                      <span style={`color: ${aff?.status === 'active' ? '#22c55e' : '#f59e0b'}`}>
                        {aff?.status || 'unknown'}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {topDays.length > 0 && (
        <div class="section">
          <h2 class="section-title">Recent Activity (Last 14 Days)</h2>
          <table>
            <thead>
              <tr><th>Date</th><th>Clicks</th><th></th></tr>
            </thead>
            <tbody>
              {topDays.map(([day, count]) => (
                <tr>
                  <td>{day}</td>
                  <td>{count}</td>
                  <td>
                    <div class="bar" style={`width: ${Math.min(count / Math.max(...topDays.map(d => d[1])) * 100, 100)}%`}></div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {topReferrers.length > 0 && (
        <div class="section">
          <h2 class="section-title">Top Referrers</h2>
          <table>
            <thead>
              <tr><th>Source</th><th>Clicks</th><th>%</th></tr>
            </thead>
            <tbody>
              {topReferrers.map(([ref, count]) => (
                <tr>
                  <td>{ref}</td>
                  <td>{count}</td>
                  <td>{((count / totalClicks) * 100).toFixed(1)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {recentClicks.length > 0 && (
        <div class="section">
          <h2 class="section-title">Recent Clicks (Last 20)</h2>
          {recentClicks.map((click: ClickEntry) => {
            const time = new Date(click.timestamp);
            const timeStr = time.toLocaleString('en-US', {
              month: 'short', day: 'numeric',
              hour: '2-digit', minute: '2-digit', hour12: false,
            });
            const refHost = click.referrer === 'direct' ? 'direct' : (() => { try { return new URL(click.referrer).hostname; } catch { return click.referrer; } })();
            return (
              <div class="click-row">
                <span class="click-time">{timeStr}</span>
                <span class="click-slug">{click.slug}</span>
                <span class="click-ref">{refHost}</span>
                <span class="click-ua">{click.userAgent?.substring(0, 60)}</span>
                <span style="color:#444;font-size:0.7rem;">{click.ip?.substring(0, 15)}</span>
              </div>
            );
          })}
        </div>
      )}
    </>
  )}

  <script>
    setTimeout(() => location.reload(), 30000);
  </script>
</body>
</html>
