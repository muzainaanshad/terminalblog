---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

// ── Helpers ──────────────────────────────────────────────
const ROOT = path.resolve(process.cwd());
function safeJson(rel: string): any {
  try { return JSON.parse(fs.readFileSync(path.join(ROOT, rel), 'utf-8')); } catch { return null; }
}
function countMdx(dir: string): number {
  try { return fs.readdirSync(dir).filter(f => f.endsWith('.mdx')).length; } catch { return 0; }
}
function parseFrontmatter(content: string) {
  const fm: Record<string, string> = {};
  const lines = content.split('\n');
  let inFm = false;
  for (const line of lines) {
    if (line.trim() === '---') { if (inFm) break; inFm = true; continue; }
    if (inFm) {
      const idx = line.indexOf(':');
      if (idx > -1) fm[line.slice(0, idx).trim()] = line.slice(idx + 1).trim().replace(/^["']|["']$/g, '');
    }
  }
  return fm;
}
function wordCount(content: string): number {
  const body = content.replace(/^---[\s\S]*?---/, '').trim();
  return body.split(/\s+/).filter(Boolean).length;
}

// ── 1. MDX files ────────────────────────────────────────
const blogDir = path.join(ROOT, 'src', 'content', 'blog');
const totalMdx = countMdx(blogDir);
const mdxFiles: string[] = (() => {
  try { return fs.readdirSync(blogDir).filter(f => f.endsWith('.mdx')); } catch { return []; }
})();

// ── 2. Tag counts from MDX frontmatter ──────────────────
const tagCounts: Record<string, number> = {};
for (const f of mdxFiles) {
  const content = fs.readFileSync(path.join(blogDir, f), 'utf-8');
  const fm = parseFrontmatter(content);
  const tags = (fm.tags ?? '').replace(/[\[\]"\\]/g, '').split(',').map(t => t.trim()).filter(Boolean);
  for (const t of tags) tagCounts[t] = (tagCounts[t] || 0) + 1;
}
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 15);
const maxTagCount = sortedTags.length > 0 ? sortedTags[0][1] : 1;
const tagColors = ['#22c55e', '#3b82f6', '#f59e0b', '#a855f7', '#06b6d4', '#ec4899', '#14b8a6', '#f97316', '#8b5cf6', '#ef4444', '#6366f1', '#84cc16', '#e879f9', '#2dd4bf', '#fb923c'];

// ── 3. Recent articles (last 10 by mtime) ───────────────
interface RecentArticle {
  filename: string; title: string; date: string; tool: string;
  tags: string; wordCount: number; mtime: string;
}
let recentArticles: RecentArticle[] = [];
try {
  const withTime = mdxFiles.map(f => ({
    file: f,
    mtime: fs.statSync(path.join(blogDir, f)).mtimeMs,
  }));
  withTime.sort((a, b) => b.mtime - a.mtime);
  recentArticles = withTime.slice(0, 10).map(({ file, mtime }) => {
    const content = fs.readFileSync(path.join(blogDir, file), 'utf-8');
    const fm = parseFrontmatter(content);
    return {
      filename: file,
      title: fm.title ?? file.replace(/\.mdx$/, ''),
      date: fm.pubDate ?? fm.date ?? '',
      tool: fm.tool ?? '',
      tags: fm.tags ?? '',
      wordCount: wordCount(content),
      mtime: new Date(mtime).toISOString(),
    };
  });
} catch {}

// ── 4. Article memory (for keywords + stats) ────────────
const mem = safeJson('src/data/article-memory.json');
const memArticles: Record<string, any> = mem?.articles ?? {};
const totalInMemory = Object.keys(memArticles).length;
const needsUpdateCount = Object.values(memArticles).filter((v: any) => v.needsUpdate).length;

// Top 10 keywords
import { Counter } from 'node:os';
const kwCounter: Record<string, number> = {};
for (const a of Object.values(memArticles) as any[]) {
  for (const kw of (a.keywords ?? [])) {
    kwCounter[kw] = (kwCounter[kw] || 0) + 1;
  }
}
const topKeywords = Object.entries(kwCounter)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);

// ── 5. Content gate ─────────────────────────────────────
const gate = safeJson('content-gate-report.json');
const thinArticles = gate?.warnings ?? 0;

// ── 6. Cron counts ──────────────────────────────────────
const crons = [
  { name: 'Content Refresh Queue', status: 'active' },
  { name: 'Daily Summary', status: 'active' },
  { name: 'Leaderboard Snapshot', status: 'active' },
  { name: 'Ops Digest', status: 'active' },
  { name: 'SEO Learn', status: 'active' },
  { name: 'Site Health', status: 'active' },
  { name: 'Weekly Newsletter', status: 'active' },
  { name: 'Deploy Notify', status: 'muted' },
];
const activeCrons = crons.filter(c => c.status === 'active').length;
const telegramCrons = 4;

// ── 7. Affiliates ───────────────────────────────────────
const affData = safeJson('src/data/affiliates.json');
const affiliates: any[] = affData?.affiliates ?? [];

// ── 8. Recent activity (last 5 articles by mtime) ───────
const activityFeed = recentArticles.slice(0, 5).map(a => ({
  type: 'article' as const,
  title: a.title,
  time: a.mtime,
}));
---

<Layout title="Admin Dashboard - terminalblog">
  <div class="admin-layout">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="sidebar-brand-icon">⚡</span>
        <span class="sidebar-brand-text">terminalblog</span>
      </div>
      <nav class="sidebar-nav">
        <a href="#dashboard" class="sidebar-link active">📊 Dashboard</a>
        <a href="#articles" class="sidebar-link">📝 Articles</a>
        <a href="#affiliates" class="sidebar-link">💰 Affiliates</a>
        <a href="/admin/flow" class="sidebar-link">🔄 Flow →</a>
      </nav>
      <div class="sidebar-footer">
        <button id="refresh-btn" class="sidebar-btn">↻ Refresh</button>
        <span class="sidebar-updated" id="last-updated">--</span>
      </div>
    </aside>

    <!-- Mobile hamburger -->
    <button class="mobile-toggle" id="mobile-toggle">☰</button>

    <!-- MAIN CONTENT -->
    <main class="main-content">
      <header class="topbar">
        <h1 class="topbar-title">Admin Dashboard</h1>
        <div class="topbar-actions">
          <a href="/admin/flow" class="flow-btn">View Flow →</a>
          <span class="topbar-updated" id="last-updated-bar">Last updated: --</span>
        </div>
      </header>

      <!-- ═══ DASHBOARD ═══ -->
      <section id="dashboard" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Overview</h2>
        <p class="section-desc">Key metrics at a glance.</p>
        <div class="stat-grid">
          <div class="stat-card">
            <p class="stat-label">Total Articles</p>
            <p class="stat-value green">{totalMdx}</p>
            <p class="stat-sub">.mdx files in /content/blog</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">Active Crons</p>
            <p class="stat-value green">{activeCrons}</p>
            <p class="stat-sub">running on schedule</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">Telegram Msgs/Day</p>
            <p class="stat-value amber">{telegramCrons}</p>
            <p class="stat-sub">daily cron reports</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">API Health</p>
            <p class="stat-value green">5/5</p>
            <p class="stat-sub">all services online</p>
          </div>
        </div>

        <!-- Recent Activity -->
        <div class="card" style="margin-top: 20px;">
          <h3 class="card-title">Recent Activity</h3>
          <div class="activity-feed">
            {activityFeed.map(a => {
              const diff = Date.now() - new Date(a.time).getTime();
              const hrs = Math.floor(diff / 3600000);
              const timeAgo = hrs < 1 ? `${Math.floor(diff / 60000)}m ago` : hrs < 24 ? `${hrs}h ago` : `${Math.floor(hrs / 24)}d ago`;
              return (
                <div class="activity-row">
                  <span class="activity-dot green"></span>
                  <span class="activity-text">New article: <strong>{a.title}</strong></span>
                  <span class="activity-time">{timeAgo}</span>
                </div>
              );
            })}
            {activityFeed.length === 0 && <p class="muted" style="font-size:13px;">No recent activity.</p>}
          </div>
        </div>
      </section>

      <!-- ═══ ARTICLES ═══ -->
      <section id="articles" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Articles</h2>
        <p class="section-desc">Tags, recent articles, keywords, and content health.</p>

        <!-- Tag bar chart -->
        <div class="card mb-6">
          <h3 class="card-title">Articles by Tag <span class="card-subtitle">(top 15 from MDX)</span></h3>
          <div class="tag-bars">
            {sortedTags.length > 0 ? sortedTags.map(([tag, count], i) => (
              <div class="tag-bar-row">
                <span class="tag-bar-label">{tag}</span>
                <div class="tag-bar-track">
                  <div class="tag-bar-fill" style={`width: ${(count / maxTagCount) * 100}%; background: ${tagColors[i % tagColors.length]}`}></div>
                </div>
                <span class="tag-bar-count">{count}</span>
              </div>
            )) : (
              <p class="muted" style="font-size:13px;">No tags found in MDX frontmatter.</p>
            )}
          </div>
        </div>

        <!-- Top Keywords + Content Gate -->
        <div class="grid-2col">
          <div class="card">
            <h3 class="card-title purple">Top 10 Keywords</h3>
            <div class="gate-stats">
              {topKeywords.length > 0 ? topKeywords.map(([kw, count]) => (
                <div class="gate-row"><span>{kw}</span><span class="mono white">{count}</span></div>
              )) : (
                <p class="muted" style="font-size:13px;">No keywords in article memory.</p>
              )}
            </div>
          </div>
          <div class="card">
            <h3 class="card-title amber">Content Health</h3>
            <div class="gate-stats">
              <div class="gate-row"><span>MDX files on disk</span><span class="mono white">{totalMdx}</span></div>
              <div class="gate-row"><span>Indexed in memory</span><span class="mono white">{totalInMemory}</span></div>
              <div class="gate-row"><span>Needs update</span><span class={`mono ${needsUpdateCount > 0 ? 'amber' : 'green'}`}>{needsUpdateCount}</span></div>
              <div class="gate-row"><span>Thin articles</span><span class={`mono ${thinArticles > 0 ? 'amber' : 'green'}`}>{thinArticles}</span></div>
              <div class="gate-row"><span>Unique tags</span><span class="mono white">{Object.keys(tagCounts).length}</span></div>
            </div>
          </div>
        </div>

        <!-- Recent Articles Table -->
        <div class="card">
          <h3 class="card-title">Recent Articles <span class="card-subtitle">(last 10 by edit time)</span></h3>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr><th>Title</th><th>Date</th><th>Words</th><th>Tool</th><th>Edited</th></tr>
              </thead>
              <tbody>
                {recentArticles.map(a => {
                  const wordColor = a.wordCount < 600 ? '#f59e0b' : a.wordCount < 1000 ? '#e5e5e5' : '#22c55e';
                  const mtime = new Date(a.mtime);
                  const diff = Date.now() - mtime.getTime();
                  const hrs = Math.floor(diff / 3600000);
                  const timeAgo = hrs < 1 ? `${Math.floor(diff / 60000)}m ago` : hrs < 24 ? `${hrs}h ago` : `${Math.floor(hrs / 24)}d ago`;
                  return (
                    <tr>
                      <td class="td-title" title={a.title}>{a.title}</td>
                      <td class="td-date">{a.date ? new Date(a.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'}</td>
                      <td class="td-words" style={`color: ${wordColor}`}>{a.wordCount.toLocaleString()}</td>
                      <td>{a.tool ? <span class="badge green-badge">{a.tool}</span> : <span class="muted">—</span>}</td>
                      <td class="td-date" title={mtime.toISOString()}>{timeAgo}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {thinArticles > 0 && (
            <div class="card-warning">⚠ {thinArticles} thin article{thinArticles !== 1 ? 's' : ''} below word minimum.</div>
          )}
        </div>
      </section>

      <!-- ═══ AFFILIATES ═══ -->
      <section id="affiliates" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Affiliates</h2>
        <p class="section-desc">{affiliates.length} active affiliate{affiliates.length !== 1 ? 's' : ''}.</p>
        <div class="affiliate-grid">
          {affiliates.length > 0 ? affiliates.map(aff => (
            <div class="affiliate-card">
              <div class="aff-header">
                <h4 class="aff-name">{aff.name}</h4>
                <span class={`aff-status ${aff.status === 'active' ? 'aff-active' : 'aff-paused'}`}>{aff.status}</span>
              </div>
              <p class="aff-desc">{aff.description}</p>
              <div class="aff-meta">
                <span class="aff-commission">💰 {aff.commission}</span>
                <a href={aff.url} target="_blank" rel="noopener" class="aff-link">↗ View</a>
              </div>
            </div>
          )) : (
            <p class="muted" style="font-size:13px;">No affiliates found in src/data/affiliates.json.</p>
          )}
        </div>
      </section>
    </main>
  </div>

  <script>
    const ts = new Date().toLocaleTimeString();
    document.getElementById('last-updated').textContent = ts;
    document.getElementById('last-updated-bar').textContent = `Last updated: ${ts}`;
    document.getElementById('refresh-btn')?.addEventListener('click', () => window.location.reload());

    const sections = document.querySelectorAll('.admin-section');
    const links = document.querySelectorAll('.sidebar-link');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach(l => l.classList.remove('active'));
          const active = document.querySelector(`.sidebar-link[href="#${id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => observer.observe(s));

    document.getElementById('mobile-toggle')?.addEventListener('click', () => {
      document.getElementById('sidebar')?.classList.toggle('open');
    });
    links.forEach(l => l.addEventListener('click', () => {
      document.getElementById('sidebar')?.classList.remove('open');
    }));
  </script>

  <style>
    .admin-layout { display: flex; min-height: 100vh; background: #0a0a0a; font-family: 'JetBrains Mono','Fira Code','Cascadia Code', monospace; color: #e5e5e5; }
    .sidebar { position: fixed; top: 0; left: 0; width: 240px; height: 100vh; background: #0d0d0d; border-right: 1px solid rgba(34,197,94,0.15); display: flex; flex-direction: column; z-index: 100; overflow-y: auto; }
    .sidebar-brand { padding: 20px 16px; border-bottom: 1px solid rgba(34,197,94,0.1); display: flex; align-items: center; gap: 10px; }
    .sidebar-brand-icon { font-size: 22px; color: #22c55e; }
    .sidebar-brand-text { font-size: 15px; color: #22c55e; font-weight: 600; }
    .sidebar-nav { flex: 1; padding: 12px 0; display: flex; flex-direction: column; gap: 2px; }
    .sidebar-link { display: block; padding: 10px 16px; color: #888; text-decoration: none; font-size: 13px; transition: all 0.15s; border-left: 3px solid transparent; }
    .sidebar-link:hover { color: #22c55e; background: rgba(34,197,94,0.05); }
    .sidebar-link.active { color: #22c55e; background: rgba(34,197,94,0.08); border-left-color: #22c55e; }
    .sidebar-footer { padding: 16px; border-top: 1px solid rgba(34,197,94,0.1); display: flex; flex-direction: column; gap: 8px; }
    .sidebar-btn { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.2); border-radius: 6px; padding: 8px; cursor: pointer; font-family: inherit; font-size: 13px; transition: background 0.15s; }
    .sidebar-btn:hover { background: rgba(34,197,94,0.25); }
    .sidebar-updated { color: #555; font-size: 11px; text-align: center; }
    .mobile-toggle { display: none; position: fixed; top: 12px; left: 12px; z-index: 200; background: #111; border: 1px solid rgba(34,197,94,0.3); color: #22c55e; font-size: 20px; width: 40px; height: 40px; border-radius: 8px; cursor: pointer; font-family: inherit; }
    .main-content { margin-left: 240px; flex: 1; min-height: 100vh; }
    .topbar { padding: 16px 32px; border-bottom: 1px solid rgba(34,197,94,0.1); display: flex; align-items: center; justify-content: space-between; background: #0d0d0d; position: sticky; top: 0; z-index: 50; }
    .topbar-title { font-size: 16px; color: #f59e0b; font-weight: 600; }
    .topbar-actions { display: flex; align-items: center; gap: 16px; }
    .topbar-updated { font-size: 12px; color: #555; }
    .flow-btn { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); border-radius: 6px; padding: 6px 14px; font-size: 12px; font-weight: 600; text-decoration: none; transition: all 0.15s; font-family: inherit; }
    .flow-btn:hover { background: rgba(34,197,94,0.25); border-color: rgba(34,197,94,0.5); }
    .admin-section { padding: 32px; border-bottom: 1px solid rgba(34,197,94,0.06); }
    .section-title { font-size: 18px; color: #22c55e; font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
    .section-arrow { color: #f59e0b; }
    .section-desc { font-size: 13px; color: #666; margin-bottom: 20px; }
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .stat-card { background: #111; border: 1px solid rgba(34,197,94,0.15); border-radius: 8px; padding: 20px; }
    .stat-label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .stat-value { font-size: 32px; font-weight: 700; line-height: 1.2; }
    .stat-value.green { color: #22c55e; }
    .stat-value.amber { color: #f59e0b; }
    .stat-sub { font-size: 11px; color: #555; margin-top: 4px; }
    .card { background: #111; border: 1px solid rgba(34,197,94,0.15); border-radius: 8px; padding: 20px; }
    .mb-6 { margin-bottom: 24px; }
    .card-title { font-size: 14px; color: #22c55e; font-weight: 600; margin-bottom: 4px; }
    .card-title.amber { color: #f59e0b; }
    .card-title.purple { color: #a855f7; }
    .card-subtitle { font-size: 12px; color: #666; font-weight: 400; }
    .card-warning { margin-top: 12px; padding: 10px 14px; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); border-radius: 6px; font-size: 12px; color: #f59e0b; }
    .tag-bars { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
    .tag-bar-row { display: flex; align-items: center; gap: 12px; }
    .tag-bar-label { width: 140px; font-size: 12px; color: #aaa; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tag-bar-track { flex: 1; height: 20px; background: rgba(255,255,255,0.03); border-radius: 4px; overflow: hidden; }
    .tag-bar-fill { height: 100%; border-radius: 4px; transition: width 0.3s; min-width: 2px; }
    .tag-bar-count { width: 36px; font-size: 13px; color: #22c55e; font-weight: 600; }
    .gate-stats { display: flex; flex-direction: column; gap: 8px; }
    .gate-row { display: flex; justify-content: space-between; font-size: 13px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .gate-row:last-child { border-bottom: none; }
    .gate-row span:first-child { color: #888; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
    .green-badge { color: #22c55e; background: rgba(34,197,94,0.15); }
    .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .table-wrap { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead { border-bottom: 1px solid rgba(34,197,94,0.15); }
    .data-table th { text-align: left; padding: 10px 12px; font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
    .data-table td { padding: 10px 12px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .data-table tbody tr:hover { background: rgba(34,197,94,0.04); }
    .td-title { color: #e5e5e5; max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .td-date { font-size: 12px; color: #888; white-space: nowrap; }
    .td-words { font-weight: 600; white-space: nowrap; }
    .muted { color: #555; }
    .mono { font-family: inherit; }
    .green { color: #22c55e; }
    .amber { color: #f59e0b; }
    .purple { color: #a855f7; }
    .red { color: #ef4444; }
    .white { color: #e5e5e5; }

    /* ── Activity Feed ── */
    .activity-feed { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
    .activity-row { display: flex; align-items: center; gap: 10px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .activity-row:last-child { border-bottom: none; }
    .activity-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .activity-dot.green { background: #22c55e; }
    .activity-text { flex: 1; color: #ccc; }
    .activity-text strong { color: #e5e5e5; }
    .activity-time { font-size: 12px; color: #555; white-space: nowrap; }

    /* ── Affiliates ── */
    .affiliate-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .affiliate-card { background: #111; border: 1px solid rgba(34,197,94,0.15); border-radius: 8px; padding: 20px; transition: border-color 0.15s; }
    .affiliate-card:hover { border-color: rgba(34,197,94,0.3); }
    .aff-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .aff-name { font-size: 15px; color: #22c55e; font-weight: 600; margin: 0; }
    .aff-status { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; text-transform: uppercase; }
    .aff-active { color: #22c55e; background: rgba(34,197,94,0.15); }
    .aff-paused { color: #f59e0b; background: rgba(245,158,11,0.15); }
    .aff-desc { font-size: 13px; color: #888; margin: 0 0 12px 0; line-height: 1.5; }
