    </main>
  </div>

  <script>
    // Update last updated time
    document.getElementById('last-updated').textContent = `Last updated: ${new Date().toLocaleTimeString()}`;

    // Refresh button
    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      window.location.reload();
    });

    // Prompt expand/collapse
    document.querySelectorAll('.prompt-toggle').forEach(el => {
      el.addEventListener('click', () => {
        const textEl = el.querySelector('.prompt-text');
        const full = el.getAttribute('data-full');
        const short = el.getAttribute('data-short');
        const expandLabel = el.querySelector('span:last-child');

        if (textEl.textContent === short) {
          textEl.textContent = full;
          if (expandLabel) expandLabel.textContent = '[collapse]';
        } else {
          textEl.textContent = short;
          if (expandLabel) expandLabel.textContent = '[expand]';
        }
      });
    });
  </script>
</Layout>
