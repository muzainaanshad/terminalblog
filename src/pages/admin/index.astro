  <script>
    // ── Last updated timestamp ──
    const ts = new Date().toLocaleTimeString();
    document.getElementById('last-updated').textContent = ts;
    document.getElementById('last-updated-bar').textContent = `Last updated: ${ts}`;

    // ── Refresh button ──
    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      window.location.reload();
    });

    // ── Sidebar active link tracking ──
    const sections = document.querySelectorAll('.admin-section');
    const links = document.querySelectorAll('.sidebar-link');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach(l => l.classList.remove('active'));
          const active = document.querySelector(`.sidebar-link[href="#${id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => observer.observe(s));

    // ── Mobile sidebar toggle ──
    document.getElementById('mobile-toggle')?.addEventListener('click', () => {
      document.getElementById('sidebar')?.classList.toggle('open');
    });

    // Close sidebar on link click (mobile)
    links.forEach(l => l.addEventListener('click', () => {
      document.getElementById('sidebar')?.classList.remove('open');
    }));

    // ── Cron row click to expand prompt ──
    document.querySelectorAll('.cron-row').forEach(row => {
      row.style.cursor = 'pointer';
      row.addEventListener('click', () => {
        const prompt = row.getAttribute('data-prompt');
        const slug = (row.querySelector('.td-sub') as HTMLElement)?.textContent?.trim();
        if (!slug) return;
        const expand = document.getElementById(`prompt-${slug}`);
        if (!expand) return;
        // Close all others
        document.querySelectorAll('.prompt-expand').forEach((e: HTMLElement) => {
          if (e !== expand) e.style.display = 'none';
        });
        expand.style.display = expand.style.display === 'none' ? 'block' : 'none';
      });
    });

    // Close prompt on X button
    document.querySelectorAll('.prompt-close').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slug = btn.getAttribute('data-close');
        const el = document.getElementById(`prompt-${slug}`);
        if (el) el.style.display = 'none';
      });
    });
  </script>

