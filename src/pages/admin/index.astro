---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';

// Auth check
const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Admin Dashboard - terminalblog">
  <div class="min-h-screen bg-[#0a0a0a]">
    <!-- Header -->
    <header class="bg-[#111] border-b border-[#22c55e]/20 p-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <span class="text-[#22c55e] text-2xl">⚡</span>
          <h1 class="text-xl font-mono text-[#22c55e]">terminalblog</h1>
          <span class="text-[#f59e0b] text-sm">Admin Dashboard</span>
        </div>
        <div class="flex items-center space-x-4">
          <button id="refresh-btn" class="px-4 py-2 bg-[#22c55e]/20 text-[#22c55e] rounded hover:bg-[#22c55e]/30 font-mono text-sm">
            ↻ Refresh
          </button>
          <span class="text-gray-500 text-sm" id="last-updated">Last updated: --</span>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto p-6">
      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Active Crons</p>
              <p class="text-3xl font-mono text-[#22c55e]" id="active-count">15</p>
            </div>
            <span class="text-2xl">✅</span>
          </div>
        </div>
        <div class="bg-[#111] border border-[#f59e0b]/20 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Paused</p>
              <p class="text-3xl font-mono text-[#f59e0b]" id="paused-count">2</p>
            </div>
            <span class="text-2xl">⏸️</span>
          </div>
        </div>
        <div class="bg-[#111] border border-red-500/20 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Errors</p>
              <p class="text-3xl font-mono text-red-500" id="error-count">0</p>
            </div>
            <span class="text-2xl">❌</span>
          </div>
        </div>
        <div class="bg-[#111] border border-blue-500/20 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Today's Runs</p>
              <p class="text-3xl font-mono text-blue-500" id="runs-count">12</p>
            </div>
            <span class="text-2xl">📊</span>
          </div>
        </div>
      </div>

      <!-- Crons Table -->
      <div class="bg-[#111] border border-[#22c55e]/20 rounded-lg overflow-hidden">
        <div class="p-4 border-b border-[#22c55e]/20">
          <h2 class="text-lg font-mono text-[#22c55e]">Automation Crons</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-[#0a0a0a]">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-mono text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-mono text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-mono text-gray-500 uppercase tracking-wider">Schedule</th>
