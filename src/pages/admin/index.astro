---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../middleware/auth';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

// Auth check
const isAuth = await checkAuth(Astro.request);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

// ── Helpers ──────────────────────────────────────────────
const ROOT = path.resolve(process.cwd());
function safeJson(rel: string): any {
  try { return JSON.parse(fs.readFileSync(path.join(ROOT, rel), 'utf-8')); } catch { return null; }
}
function countMdx(dir: string): number {
  try { return fs.readdirSync(dir).filter(f => f.endsWith('.mdx')).length; } catch { return 0; }
}
function parseFrontmatter(content: string) {
  const fm: Record<string, string> = {};
  const lines = content.split('\n');
  let inFm = false;
  for (const line of lines) {
    if (line.trim() === '---') { if (inFm) break; inFm = true; continue; }
    if (inFm) {
      const idx = line.indexOf(':');
      if (idx > -1) fm[line.slice(0, idx).trim()] = line.slice(idx + 1).trim().replace(/^["']|["']$/g, '');
    }
  }
  return fm;
}
function wordCount(content: string): number {
  const body = content.replace(/^---[\s\S]*?---/, '').trim();
  return body.split(/\s+/).filter(Boolean).length;
}

// ── 1. Article Memory ───────────────────────────────────
const mem = safeJson('src/data/article-memory.json');
const memArticles: Record<string, any> = mem?.articles ?? {};

function extractTypes(articles: Record<string, any>): Record<string, number> {
  const types: Record<string, number> = {};
  for (const [, v] of Object.entries(articles)) {
    const rawTags: string[] = v.tags ?? [];
    for (const t of rawTags) {
      const clean = t.replace(/[\[\]"\\]/g, '').trim();
      if (clean) types[clean] = (types[clean] || 0) + 1;
    }
  }
  return types;
}
function extractTopics(articles: Record<string, any>): Record<string, number> {
  const topics: Record<string, number> = {};
  for (const [, v] of Object.entries(articles)) {
    const kws: string[] = v.keywords ?? [];
    for (const k of kws) {
      const clean = k.replace(/[\[\]"\\]/g, '').trim().toLowerCase();
      if (clean && clean.length > 2) topics[clean] = (topics[clean] || 0) + 1;
    }
  }
  return topics;
}
const articleTypes = extractTypes(memArticles);
const topicsMap = extractTopics(memArticles);
const topTopics = Object.entries(topicsMap).sort((a, b) => b[1] - a[1]).slice(0, 10);
const needsUpdateCount = Object.values(memArticles).filter((v: any) => v.needsUpdate).length;
const totalInMemory = Object.keys(memArticles).length;

// ── 2. Content Gate ─────────────────────────────────────
const gate = safeJson('content-gate-report.json');
const thinArticles = gate?.warnings ?? 0;
const gateChecked = gate?.checked ?? 0;

// ── 3. MDX files ────────────────────────────────────────
const blogDir = path.join(ROOT, 'src', 'content', 'blog');
const totalMdx = countMdx(blogDir);

interface RecentArticle {
  filename: string;
  title: string;
  date: string;
  tool: string;
  tags: string;
  wordCount: number;
  mtime: string;
}
let recentArticles: RecentArticle[] = [];
try {
  const files = fs.readdirSync(blogDir).filter(f => f.endsWith('.mdx'));
  const withTime = files.map(f => ({
    file: f,
    mtime: fs.statSync(path.join(blogDir, f)).mtimeMs,
  }));
  withTime.sort((a, b) => b.mtime - a.mtime);
  recentArticles = withTime.slice(0, 10).map(({ file, mtime }) => {
    const content = fs.readFileSync(path.join(blogDir, file), 'utf-8');
    const fm = parseFrontmatter(content);
    return {
      filename: file,
      title: fm.title ?? file.replace(/\.mdx$/, ''),
      date: fm.pubDate ?? fm.date ?? '',
      tool: fm.tool ?? '',
      tags: fm.tags ?? '',
      wordCount: wordCount(content),
      mtime: new Date(mtime).toISOString(),
    };
  });
} catch {}

// ── 4. Cron config ──────────────────────────────────────
const crons = [
  { name: 'Content Refresh Queue', slug: 'content-refresh', schedule: '0 5 * * 3 (Wed 05:00 UTC)', category: 'content', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Refresh evergreen articles flagged for update. Read article-memory.json for needsUpdate=true entries, pick the top-priority ones, rewrite with fresh data and examples. Gate-check each output before saving.', lastRun: '2026-07-16T05:00:00Z', nextRun: '2026-07-23T05:00:00Z' },
  { name: 'Daily Summary', slug: 'daily-summary', schedule: '0 3 * * * (Daily 06:00 AST)', category: 'ops', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Compile daily summary of all cron runs, article publications, and site metrics. Send formatted report to Telegram in Articles Management format.', lastRun: '2026-07-17T03:00:00Z', nextRun: '2026-07-18T03:00:00Z' },
  { name: 'Leaderboard Snapshot', slug: 'leaderboard-snapshot', schedule: '0 12 * * * (Daily 12:00 UTC)', category: 'monitoring', status: 'active', model: 'none', prompt: 'Take daily adoption leaderboard snapshot. Fetch current star counts, contributor stats, and trending repos. Save historical data for trend analysis.', lastRun: '2026-07-17T12:00:00Z', nextRun: '2026-07-18T12:00:00Z' },
  { name: 'Ops Digest', slug: 'ops-digest', schedule: '0 13 * * * (Daily 13:00 UTC)', category: 'ops', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Generate Telegram ops digest in Articles Management format. Summarize: new articles published, updates made, cron successes/failures, site health status. Include action items if any.', lastRun: '2026-07-17T13:00:00Z', nextRun: '2026-07-18T13:00:00Z' },
  { name: 'SEO Learn', slug: 'seo-learn', schedule: '0 6 * * 1 (Mon 06:00 UTC)', category: 'seo', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Weekly SEO learnings report. Analyze Search Console data, identify top-performing queries, click-through patterns, and pages needing optimization. Generate actionable recommendations.', lastRun: '2026-07-14T06:00:00Z', nextRun: '2026-07-21T06:00:00Z' },
  { name: 'Site Health', slug: 'site-health', schedule: '0 */6 * * * (Every 6 hours)', category: 'monitoring', status: 'active', model: 'none', prompt: 'Run automated site health checks: verify all published URLs return 200, check for broken internal links, validate RSS feed, test OG images, and confirm sitemap freshness.', lastRun: '2026-07-17T12:00:00Z', nextRun: '2026-07-17T18:00:00Z' },
  { name: 'Weekly Newsletter', slug: 'weekly-newsletter', schedule: '0 14 * * 1 (Mon 14:00 UTC)', category: 'content', status: 'active', model: 'anthropic/claude-sonnet-4', prompt: 'Compile weekly Coding Agent digest for Beehiiv newsletter. Pick top 5-7 articles from the week, write editorial intro, format for email delivery. Send via Beehiiv API.', lastRun: '2026-07-14T14:00:00Z', nextRun: '2026-07-21T14:00:00Z' },
  { name: 'Deploy Notify', slug: 'deploy-notify', schedule: 'on push (Vercel auto)', category: 'ops', status: 'muted', model: 'none', prompt: 'MUTED — Deploy notifications disabled per user request. Vercel handles deployment via Git integration. No Telegram ping on deploy.', lastRun: '2026-07-17T00:00:00Z', nextRun: '—' },
];

// Group crons by category
const cronGroups: Record<string, typeof crons> = {};
for (const c of crons) {
  if (!cronGroups[c.category]) cronGroups[c.category] = [];
  cronGroups[c.category].push(c);
}
const categoryOrder = ['content', 'seo', 'social', 'ops', 'monitoring'];
const categoryLabels: Record<string, string> = {
  content: '📝 Content',
  seo: '🔍 SEO',
  social: '🐦 Social',
  ops: '⚙️ Ops',
  monitoring: '📡 Monitoring',
};
const categoryColors: Record<string, string> = {
  content: '#22c55e',
  seo: '#3b82f6',
  social: '#f59e0b',
  ops: '#a855f7',
  monitoring: '#06b6d4',
};

// ── 5. Derived stats ────────────────────────────────────
const activeCrons = crons.filter(c => c.status === 'active').length;
const telegramCrons = crons.filter(c => c.status === 'active' && (c.prompt.includes('Telegram') || c.category === 'ops')).length;
const now = new Date().toISOString();

// ── 6. Tag breakdown for bar chart ──────────────────────
const sortedTags = Object.entries(articleTypes).sort((a, b) => b[1] - a[1]).slice(0, 12);
const maxTagCount = sortedTags.length > 0 ? sortedTags[0][1] : 1;
const tagColors = ['#22c55e', '#3b82f6', '#f59e0b', '#a855f7', '#06b6d4', '#ec4899', '#14b8a6', '#f97316', '#8b5cf6', '#ef4444', '#6366f1', '#84cc16'];
---

<Layout title="Admin Dashboard - terminalblog">
  <div class="admin-layout">
    <!-- ═══════════════════════════════════════════════════════
         SIDEBAR
         ═══════════════════════════════════════════════════════ -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="sidebar-brand-icon">⚡</span>
        <span class="sidebar-brand-text">terminalblog</span>
      </div>
      <nav class="sidebar-nav">
        <a href="#dashboard" class="sidebar-link active">📊 Dashboard</a>
        <a href="#articles" class="sidebar-link">📝 Articles</a>
        <a href="#automation" class="sidebar-link">🤖 Automation</a>
        <a href="#telegram" class="sidebar-link">💬 Telegram</a>
        <a href="#system" class="sidebar-link">🔧 System</a>
        <a href="#content-policy" class="sidebar-link">📋 Content Policy</a>
      </nav>
      <div class="sidebar-footer">
        <button id="refresh-btn" class="sidebar-btn">↻ Refresh</button>
        <span class="sidebar-updated" id="last-updated">--</span>
      </div>
    </aside>

    <!-- Mobile hamburger -->
    <button class="mobile-toggle" id="mobile-toggle">☰</button>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════ -->
    <main class="main-content">

      <!-- Top bar -->
      <header class="topbar">
        <h1 class="topbar-title">Admin Dashboard</h1>
        <span class="topbar-updated" id="last-updated-bar">Last updated: --</span>
      </header>

      <!-- ════════════════════════════════════════════════════
           SECTION: Dashboard Overview
           ════════════════════════════════════════════════════ -->
      <section id="dashboard" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Overview</h2>
        <p class="section-desc">Key metrics at a glance. These numbers update whenever you refresh.</p>
        <div class="stat-grid">
          <div class="stat-card">
            <p class="stat-label">Total Articles</p>
            <p class="stat-value green">{totalMdx}</p>
            <p class="stat-sub">.mdx files in /content/blog</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">Active Crons</p>
            <p class="stat-value green">{activeCrons}</p>
            <p class="stat-sub">running on schedule</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">Telegram Messages/Day</p>
            <p class="stat-value amber">{telegramCrons}</p>
            <p class="stat-sub">daily cron reports</p>
          </div>
          <div class="stat-card">
            <p class="stat-label">API Health</p>
            <p class="stat-value green">5/5</p>
            <p class="stat-sub">all services online</p>
          </div>
        </div>
      </section>

      <!-- ════════════════════════════════════════════════════
           SECTION: Articles
           ════════════════════════════════════════════════════ -->
      <section id="articles" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Articles</h2>
        <p class="section-desc">Breakdown of all articles by tag, top keywords, and the 10 most recently edited files.</p>

        <!-- Tag bar chart -->
        <div class="card mb-6">
          <h3 class="card-title">Articles by Tag</h3>
          <p class="card-desc">Each bar shows how many articles carry that tag. Longer bar = more articles.</p>
          <div class="tag-bars">
            {sortedTags.map(([tag, count], i) => (
              <div class="tag-bar-row">
                <span class="tag-bar-label">{tag}</span>
                <div class="tag-bar-track">
                  <div class="tag-bar-fill" style={`width: ${(count / maxTagCount) * 100}%; background: ${tagColors[i % tagColors.length]}`}></div>
                </div>
                <span class="tag-bar-count">{count}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="grid-2col">
          <!-- Top 10 Keywords -->
          <div class="card">
            <h3 class="card-title amber">Top 10 Keywords</h3>
            <p class="card-desc">Most frequently used keywords across all articles.</p>
            <div class="keyword-list">
              {topTopics.map(([topic, count], i) => (
                <div class="keyword-row">
                  <span class="keyword-rank">{i + 1}.</span>
                  <span class="keyword-name">{topic}</span>
                  <span class="keyword-count">{count}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Content Gate Quick Stats -->
          <div class="card">
            <h3 class="card-title purple">Content Gate Report</h3>
            <p class="card-desc">Quality checks run before every publish. Warnings = articles below word minimum.</p>
            <div class="gate-stats">
              <div class="gate-row"><span>Articles checked</span><span class="mono white">{gateChecked}</span></div>
              <div class="gate-row"><span>Errors</span><span class={`mono ${gate?.errors ? 'red' : 'green'}`}>{gate?.errors ?? 0}</span></div>
              <div class="gate-row"><span>Warnings (thin)</span><span class={`mono ${thinArticles > 0 ? 'amber' : 'green'}`}>{thinArticles}</span></div>
              <div class="gate-row"><span>Throttle hits</span><span class="mono amber">{gate?.throttle?.length ?? 0}</span></div>
              <div class="gate-row"><span>Needs update</span><span class={`mono ${needsUpdateCount > 0 ? 'amber' : 'green'}`}>{needsUpdateCount}</span></div>
            </div>
          </div>
        </div>

        <!-- Recent Articles Table -->
        <div class="card">
          <h3 class="card-title">Recent Articles <span class="card-subtitle">(last 10 by edit time)</span></h3>
          <p class="card-desc">Articles sorted by most recently modified. Word count color: orange = thin, white = normal, green = thorough.</p>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Date</th>
                  <th>Words</th>
                  <th>Tool</th>
                  <th>Edited</th>
                </tr>
              </thead>
              <tbody>
                {recentArticles.map((a) => {
                  const wordColor = a.wordCount < 600 ? '#f59e0b' : a.wordCount < 1000 ? '#e5e5e5' : '#22c55e';
                  const mtime = new Date(a.mtime);
                  const timeAgo = (() => {
                    const diff = Date.now() - mtime.getTime();
                    const hrs = Math.floor(diff / 3600000);
                    if (hrs < 1) return `${Math.floor(diff / 60000)}m ago`;
                    if (hrs < 24) return `${hrs}h ago`;
                    return `${Math.floor(hrs / 24)}d ago`;
                  })();
                  return (
                    <tr>
                      <td class="td-title" title={a.title}>{a.title}</td>
                      <td class="td-date">{a.date ? new Date(a.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'}</td>
                      <td class="td-words" style={`color: ${wordColor}`}>{a.wordCount.toLocaleString()}</td>
                      <td>{a.tool ? <span class="badge green-badge">{a.tool}</span> : <span class="muted">—</span>}</td>
                      <td class="td-date" title={mtime.toISOString()}>{timeAgo}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {thinArticles > 0 && (
            <div class="card-warning">
              ⚠ {thinArticles} thin article{thinArticles !== 1 ? 's' : ''} below word minimum. Content Refresh Queue will expand them on next run.
            </div>
          )}
        </div>
      </section>

      <!-- ════════════════════════════════════════════════════
           SECTION: Automation
           ════════════════════════════════════════════════════ -->
      <section id="automation" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Automation</h2>
        <p class="section-desc">All scheduled cron jobs grouped by category. Click any row to see the full AI prompt.</p>

        {categoryOrder.filter(cat => cronGroups[cat]?.length).map(cat => {
          const color = categoryColors[cat];
          const jobs = cronGroups[cat];
          return (
            <div class="card mb-6" style={`border-left: 3px solid ${color}`}>
              <h3 class="card-title" style={`color: ${color}`}>{categoryLabels[cat]}</h3>
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Schedule</th>
                      <th>Status</th>
                      <th>Model</th>
                      <th>Last Run</th>
                      <th>Next Run</th>
                    </tr>
                  </thead>
                  <tbody>
                    {jobs.map((cron) => {
                      const statColor = cron.status === 'active' ? '#22c55e' : cron.status === 'muted' ? '#6b7280' : '#f59e0b';
                      const statBg = cron.status === 'active' ? 'rgba(34,197,94,0.15)' : cron.status === 'muted' ? 'rgba(107,114,128,0.15)' : 'rgba(245,158,11,0.15)';
                      return (
                        <tr class="cron-row" data-prompt={cron.prompt}>
                          <td class="td-title">
                            <span>{cron.name}</span>
                            <span class="td-sub">{cron.slug}</span>
                          </td>
                          <td class="td-date">{cron.schedule}</td>
                          <td><span class="badge" style={`color: ${statColor}; background: ${statBg}`}>{cron.status}</span></td>
                          <td class="td-model">{cron.model}</td>
                          <td class="td-date">{cron.lastRun ? new Date(cron.lastRun).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}</td>
                          <td class="td-date">{cron.nextRun && cron.nextRun !== '—' ? new Date(cron.nextRun).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              {jobs.map((cron) => (
                <div class="prompt-expand" id={`prompt-${cron.slug}`} style="display:none">
                  <div class="prompt-expand-header">
                    <span class="prompt-expand-title">Full Prompt — {cron.name}</span>
                    <button class="prompt-close" data-close={cron.slug}>✕</button>
                  </div>
                  <pre class="prompt-expand-code">{cron.prompt}</pre>
                </div>
              ))}
            </div>
          );
        })}
      </section>

      <!-- ════════════════════════════════════════════════════
           SECTION: Telegram
           ════════════════════════════════════════════════════ -->
      <section id="telegram" class="admin-section">
        <h2 class="section-title"><span class="section-arrow">▸</span> Telegram</h2>
        <p class="section-desc">How the bot formats and delivers messages. This is exactly what you see in the Telegram channel.</p>

        <!-- Message Format Demo -->
        <div class="card mb-6">
          <h3 class="card-title amber">Message Format Demo</h3>
          <p class="card-desc">The "Articles Management" format is used by Daily Summary and Ops Digest. Each section groups related changes.</p>
          <div class="telegram-demo">
            <div class="telegram-header">
              <span class="telegram-bot-icon">🤖</span>
              <span>Coding Agent Bot</span>
            </div>
            <div class="telegram-msg">
              <div class="tg-line"><strong>📋 Articles Management</strong></div>
              <div class="tg-line">1- 2 new articles created</div>
              <div class="tg-line tg-item">• Beware: Codex encrypts subagent instructions</div>
              <div class="tg-line tg-item">• Beware: Gitlawb Zero MCP trust boundary</div>
              <div class="tg-line">2- 1 existing article updated</div>
              <div class="tg-line tg-item">• Claude Code lock issues fix (refreshed data)</div>
              <div class="tg-line">3- 0 Articles deleted</div>
              <div class="tg-line">4- 3 New Interlinks</div>
              <div class="tg-line tg-spacer"></div>
              <div class="tg-line"><strong>Others</strong></div>
              <div class="tg-line tg-muted">1- new seo learning (omitted)</div>
              <div class="tg-line tg-muted">2- leaderboard updates (omitted)</div>
              <div class="tg-line tg-muted">3- automation errors (omitted)</div>
            </div>
          </div>
        </div>

        <div class="grid-2col">
          <!-- Crons that send to Telegram -->
          <div class="card">
            <h3 class="card-title green">Crons → Telegram</h3>
            <p class="card-desc">These cron jobs deliver their output to the Telegram channel.</p>
            <div class="tg-cron-list">
              <div class="tg-cron-item">
                <div class="tg-cron-name">Daily Summary</div>
                <div class="tg-cron-meta">Daily 06:00 AST • Articles Management format</div>
                <span class="badge green-badge">active</span>
              </div>
              <div class="tg-cron-item">
                <div class="tg-cron-name">Ops Digest</div>
                <div class="tg-cron-meta">Daily 13:00 UTC • Combined health report</div>
                <span class="badge green-badge">active</span>
              </div>
              <div class="tg-cron-item">
                <div class="tg-cron-name">SEO Learn</div>
                <div class="tg-cron-meta">Monday 06:00 UTC • Weekly SEO insights</div>
                <span class="badge green-badge">active</span>
              </div>
              <div class="tg-cron-item">
                <div class="tg-cron-name">Content Refresh Queue</div>
                <div class="tg-cron-meta">Wednesday 05:00 UTC • Article updates</div>
                <span class="badge green-badge">active</span>
              </div>
              <div class="tg-cron-item">
                <div class="tg-cron-name">Weekly Newsletter</div>
                <div class="tg-cron-meta">Monday 14:00 UTC • Beehiiv digest</div>
                <span class="badge green-badge">active</span>
              </div>
              <div class="tg-cron-item">
                <div class="tg-cron-name">Deploy Notify</div>
                <div class="tg-cron-meta">On push • Notifications disabled</div>
                <span class="badge muted-badge">muted</span>
              </div>
            </div>
          </div>

          <!-- Daily Schedule -->
          <div class="card">
            <h3 class="card-title">Daily Schedule <span class="card-subtitle">(Saudi / AST)</span></h3>
            <p class="card-desc">When each automation fires during the day. Times shown in AST (UTC+3).</p>
            <div class="schedule-timeline">
              <div class="schedule-item"><div class="schedule-time">03:00</div><div class="schedule-detail"><span class="schedule-name">Daily Summary</span><span class="schedule-desc">Telegram report</span></div></div>
              <div class="schedule-item"><div class="schedule-time">06:00</div><div class="schedule-detail"><span class="schedule-name">SEO Learn</span><span class="schedule-desc">Weekly insights (Mon)</span></div></div>
              <div class="schedule-item"><div class="schedule-time">08:00</div><div class="schedule-detail"><span class="schedule-name">Site Health</span><span class="schedule-desc">Every 6h check</span></div></div>
              <div class="schedule-item"><div class="schedule-time">10:00</div><div class="schedule-detail"><span class="schedule-name">Site Health</span><span class="schedule-desc">Every 6h check</span></div></div>
              <div class="schedule-item"><div class="schedule-time">12:00</div><div class="schedule-detail"><span class="schedule-name">Site Health</span><span class="schedule-desc">Every 6h check</span></div></div>
              <div class="schedule-item"><div class="schedule-time">15:00</div><div class="schedule-detail"><span class="schedule-name">Content Refresh</span><span class="schedule-desc">Expand thin articles (Wed)</span></div></div>
