---
import Layout from '../../../layouts/Layout.astro';
import { buildHomeGraph } from '../../../utils/schema';

const SITE_URL = 'https://terminalblog.com';
const canonicalURL = `${SITE_URL}/api/go/aifiesta`;
const graph = buildHomeGraph();

const metaDescription = 'Redirect to aiFiesta — unified AI model access platform. One subscription, every model: Claude, GPT, Gemini, and more. Compare pricing and capabilities.';

export const prerender = true;
const ogImage = '/api/og?title=aiFiesta+Redirect&description=Unified+AI+model+access+platform';
---

<Layout
  title="Redirecting to aiFiesta..."
  description={metaDescription}
  image={ogImage}
  robots="noindex, nofollow"
  graph={graph}
>
  <main style="max-width:600px;margin:0 auto;padding:0 1.5rem;text-align:center;margin-top:6rem;">
    <h1 style="font-size:1.5rem;margin-bottom:1rem;">Redirecting to aiFiesta</h1>
    <p style="color:var(--fg-dim);margin-bottom:2rem;">One subscription. Every model. No context switching.</p>
    <p style="font-family:var(--font-mono);font-size:0.85rem;color:var(--fg-dim);">
      If you are not redirected automatically, <a href="https://aifiesta.link/muhammed-anshad" target="_blank" rel="noopener" style="color:var(--green);">click here</a>.
    </p>
  </main>

  <script is:inline>
    window.location.href = "https://aifiesta.link/muhammed-anshad";
  </script>
</Layout>