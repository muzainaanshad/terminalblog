---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <article class="content">
    <h1 style="font-size:1.75rem;margin-bottom:1.5rem;">About {SITE_TITLE}</h1>

    <p>
      <strong>{SITE_TITLE}</strong> tracks the rapidly evolving ecosystem of open-source coding agents
      — autonomous AI assistants that go beyond simple chat completions to plan, execute, and deliver
      complex software engineering tasks.
    </p>

    <p>
      We monitor codebases like <a href="https://github.com/NousResearch/hermes-agent" target="_blank">Hermes Agent</a>,
      <a href="https://github.com/opencode-ai/opencode" target="_blank">OpenCode</a>,
      <a href="https://github.com/pi-delabs/pi" target="_blank">pi.dev</a>,
      GitLab's Zero, Mimo Code (a fork of OpenCode),
      <a href="https://github.com/kilocode/cli" target="_blank">Kilo Code CLI</a>,
      and others — producing daily analysis of new features, architectural changes, and workflow patterns.
    </p>

    <h2>What We Cover</h2>
    <ul>
      <li><strong>Feature deep-dives</strong> — detailed breakdowns of new agent capabilities as they ship</li>
      <li><strong>Architecture analysis</strong> — how multi-provider routing, agent orchestration, and credential systems work</li>
      <li><strong>Workflow patterns</strong> — background task delegation, autonomous PR creation, cron automation</li>
      <li><strong>Ecosystem tracking</strong> — comparing approaches across different coding agent projects</li>
    </ul>

    <h2>Methodology</h2>
    <p>
      Every article is researched from actual GitHub commits and releases. We use the GitHub API to
      track changes across multiple repositories, filter for meaningful feature work, and produce
      evergreen analysis that remains valuable beyond any single release.
    </p>

    <h2>Open Source</h2>
    <p>
      This site itself is built with <a href="https://astro.build" target="_blank">Astro</a>, deployed on
      <a href="https://vercel.com" target="_blank">Vercel</a>, and uses the <strong>Lipi</strong> design
      aesthetic — a typography-first editorial theme for long-form publishing.
    </p>
  </article>
</Layout>
