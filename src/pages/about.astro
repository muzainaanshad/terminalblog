---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={"About — " + SITE_TITLE} description={SITE_DESCRIPTION}>
  <article class="content">
    <h1 style="font-size:1.75rem;margin-bottom:1.5rem;">About {SITE_TITLE}</h1>

    <p>
      <strong>{SITE_TITLE}</strong> tracks the rapidly evolving ecosystem of open-source coding agents
      — autonomous AI assistants that go beyond simple chat completions to plan, execute, and deliver
      complex software engineering tasks.
    </p>

    <h2>What We Track</h2>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1.5rem;">
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>Hermes Agent</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">The most full-featured open-source agent. Background tasks, MOA, cron, memory, skills.</p>
        <a href="/tool/hermes/" style="font-size:0.8rem;">View articles →</a>
      </div>
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>OpenCode</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">Skill-driven coding agent with slash command workflows and SKILL.md execution model.</p>
        <a href="/tool/opencode/" style="font-size:0.8rem;">View articles →</a>
      </div>
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>Mimo Code</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">OpenCode fork with vision support and reasoning model integration.</p>
        <a href="/tool/mimo/" style="font-size:0.8rem;">View articles →</a>
      </div>
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>Kilo Code CLI</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">Lightweight LLM orchestrator for quick AI-assisted tasks.</p>
        <a href="/tool/kilo/" style="font-size:0.8rem;">View articles →</a>
      </div>
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>pi.dev</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">Personal intelligence agents with persistent knowledge graphs.</p>
        <a href="/tool/pi-dot-dev/" style="font-size:0.8rem;">View articles →</a>
      </div>
      <div style="padding:1rem;border:1px solid var(--border);border-radius:6px;">
        <strong>GitLab Zero</strong>
        <p style="font-size:0.85rem;margin:0.25rem 0 0;">DevSecOps coding agent for the GitLab ecosystem.</p>
        <a href="/tool/gitlab-zero/" style="font-size:0.8rem;">View articles →</a>
      </div>
    </div>

    <h2>Methodology</h2>
    <p>
      Every article is researched from actual GitHub commits and releases across these repositories.
      We use the GitHub API to track changes, filter for meaningful feature work, and produce
      evergreen analysis that remains valuable beyond any single release.
    </p>

    <h2>Open Source</h2>
    <p>
      This site is built with <a href="https://astro.build">Astro</a>, deployed on
      <a href="https://vercel.com">Vercel</a>, and uses the Lipi design aesthetic.
      Content is generated programmatically from real repository data.
    </p>
  </article>
</Layout>
