---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container" style="padding:3rem 1.5rem 4rem;">
			<article style="max-width:720px;margin:0 auto;">
				<h1 style="font-size:1.75rem;margin-bottom:1.5rem;">About Hermes Agent Blog</h1>

				<p>
					<strong>Hermes Agent Blog</strong> covers the development, architecture, and ecosystem of <a href="https://github.com/NousResearch/hermes-agent" target="_blank">Hermes Agent</a> — the open-source autonomous coding assistant built by <a href="https://nousresearch.com" target="_blank">Nous Research</a>.
				</p>

				<p>
					Hermes Agent is an MIT-licensed, local-first AI assistant that goes beyond simple chat completions. It plans complex goals, delegates tasks to autonomous sub-agents, routes work across multiple LLM providers, and runs scheduled jobs — all from the terminal. It's designed for developers who want real autonomy, not another chat interface.
				</p>

				<h2>What This Blog Covers</h2>
				<ul>
					<li><strong>Feature deep-dives</strong> — detailed breakdowns of new Hermes capabilities as they ship</li>
					<li><strong>Architecture posts</strong> — how multi-provider routing, MOA orchestration, credential guards, and the skill system work under the hood</li>
					<li><strong>Workflow guides</strong> — practical patterns for background task delegation, cron automation, code review, and more</li>
					<li><strong>Release analysis</strong> — what each commit means for real-world usage</li>
				</ul>

				<h2>Open Source</h2>
				<p>
					Hermes Agent is fully open source under the MIT license. <a href="https://github.com/NousResearch/hermes-agent" target="_blank">Star it on GitHub</a>, contribute, or fork it for your own needs.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>
