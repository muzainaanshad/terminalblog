---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`Search — ${SITE_TITLE}`} description="Search terminalblog — honest reviews, comparisons, and guides for AI coding agents like Claude Code, Codex, Cursor, and more. Search across 500+ articles covering security, pricing, adoption data, and workflow guides.">
  <div class="content" style="max-width:700px;margin:0 auto;padding:0 1.5rem 3rem;">

    <div class="search-header">
      <h1 style="font-size:1.3rem;font-family:var(--font-mono);">Search <span style="color:var(--green);">articles</span></h1>
      <p style="color:var(--fg-dim);font-size:0.82rem;margin:0.3rem 0 0;">Search across all articles about coding agents.</p>
    </div>

    <div class="search-intro" style="margin:1.5rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
      <h2 style="font-size:0.85rem;font-family:var(--font-mono);margin:0 0 0.5rem;color:var(--green);">What you can find</h2>
      <ul style="margin:0;padding-left:1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">
        <li><strong>Security Beware posts</strong> — CVEs, sandbox escapes, credential leaks, prompt injections with repro steps</li>
        <li><strong>Agent comparisons</strong> — Head-to-head: Claude Code vs Cursor, Codex vs Goose, OpenCode vs Hermes</li>
        <li><strong>Pricing & adoption data</strong> — Real token costs, npm downloads, GitHub stars, weekly commit velocity</li>
        <li><strong>Workflow guides</strong> — AGENTS.md, MCP servers, hook systems, subagent patterns, local models</li>
        <li><strong>Leaderboard & tool hubs</strong> — 19+ agents ranked by multi-signal adoption score</li>
      </ul>
    </div>

    <div class="search-tips" style="margin:1.5rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
      <h2 style="font-size:0.85rem;font-family:var(--font-mono);margin:0 0 0.5rem;color:var(--green);">Search tips</h2>
      <ul style="margin:0;padding-left:1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">
        <li><strong>Agent names</strong> — "Claude Code", "Cursor", "Codex", "Hermes", "OpenCode", "Goose", "Kilo"</li>
        <li><strong>Topics</strong> — "pricing", "security", "MCP", "AGENTS.md", "subagents", "hooks"</li>
        <li><strong>Tags</strong> — "comparison", "guide", "beware", "deep-dive", "beginner-guide", "workflow"</li>
        <li><strong>Press <kbd>/</kbd></strong> — keyboard shortcut to focus search from anywhere on the page</li>
      </ul>
    </div>

    <div class="popular-searches" style="margin:1.5rem 0;">
      <h2 style="font-size:0.85rem;font-family:var(--font-mono);margin:0 0 0.5rem;color:var(--green);">Popular searches</h2>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <a href="/blog/tag/comparison/" class="search-tag">Agent comparisons</a>
        <a href="/blog/tag/beware/" class="search-tag">Security alerts</a>
        <a href="/blog/tag/pricing/" class="search-tag">Pricing breakdowns</a>
        <a href="/blog/tag/workflow/" class="search-tag">Workflow guides</a>
        <a href="/leaderboard/" class="search-tag">Adoption leaderboard</a>
        <a href="/agents-md/" class="search-tag">AGENTS.md patterns</a>
      </div>
    </div>

    <div class="how-it-works" style="margin:2rem 0;padding:1.5rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
      <h2 style="font-size:0.85rem;font-family:var(--font-mono);margin:0 0 1rem;color:var(--green);">How search works</h2>
      <p style="color:var(--fg-dim);font-size:0.85rem;line-height:1.7;margin:0 0 1rem;">
        terminalblog uses <strong>Pagefind</strong>, a client-side search index built at compile time. No external API calls, no tracking, no server round-trips — the entire index loads in your browser and searches happen locally.
      </p>
      <ul style="margin:0;padding-left:1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">
        <li><strong>Index size</strong> — ~200KB compressed, loads in milliseconds</li>
        <li><strong>Coverage</strong> — Every article, tool hub, tag page, and static page</li>
        <li><strong>Ranking</strong> — Title matches boosted, then headings, then body text</li>
        <li><strong>Privacy</strong> — Your search terms never leave your device</li>
      </ul>
    </div>

    <!-- SEO Content: Search capabilities deep dive -->
    <section class="search-deep-dive" style="margin:3rem 0;padding:2rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:8px;">
      <h2 style="font-size:1.1rem;font-family:var(--font-mono);color:var(--green);margin:0 0 1.5rem;">Advanced Search Capabilities</h2>
      
      <h3 style="font-size:0.9rem;font-family:var(--font-mono);color:var(--fg-bright);margin:1.5rem 0 0.75rem;">Boolean Operators</h3>
      <p style="color:var(--fg-dim);font-size:0.85rem;line-height:1.7;margin:0 0 1rem;">
        Pagefind supports basic boolean logic. Use <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">AND</code>, <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">OR</code>, and <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">NOT</code> (or <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">-</code>) to combine or exclude terms.
      </p>
      <ul style="margin:0 0 1rem 1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.8;">
        <li><code>Claude Code AND security</code> — results containing both terms</li>
        <li><code>Cursor OR Codex</code> — results containing either term</li>
        <li><code>pricing NOT enterprise</code> — pricing results excluding enterprise mentions</li>
      </ul>

      <h3 style="font-size:0.9rem;font-family:var(--font-mono);color:var(--fg-bright);margin:1.5rem 0 0.75rem;">Phrase Search</h3>
      <p style="color:var(--fg-dim);font-size:0.85rem;line-height:1.7;margin:0 0 1rem;">
        Wrap exact phrases in quotes to match word order exactly.
      </p>
      <ul style="margin:0 0 1rem 1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.8;">
        <li><code>"AGENTS.md patterns"</code> — exact phrase match</li>
        <li><code>"prompt injection" security</code> — phrase plus additional term</li>
      </ul>

      <h3 style="font-size:0.9rem;font-family:var(--font-mono);color:var(--fg-bright);margin:1.5rem 0 0.75rem;">Field-Specific Search</h3>
      <p style="color:var(--fg-dim);font-size:0.85rem;line-height:1.7;margin:0 0 1rem;">
        Prefix terms to search specific fields. This is especially powerful for our structured content.
      </p>
      <ul style="margin:0 0 1rem 1.2rem;color:var(--fg-dim);font-size:0.85rem;line-height:1.8;">
        <li><code>tag:comparison</code> — only comparison-tagged articles</li>
        <li><code>tool:claude-code</code> — only Claude Code articles</li>
        <li><code>author:kira</code> — only articles by kira (security focus)</li>
      </ul>

      <h3 style="font-size:0.9rem;font-family:var(--font-mono);color:var(--fg-bright);margin:1.5rem 0 0.75rem;">Filter by Content Type</h3>
      <p style="color:var(--fg-dim);font-size:0.85rem;line-height:1.7;margin:0 0 1rem;">
        Use these quick filters to narrow results by the type of content you need.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0.75rem;">
        <a href="/blog/tag/beware/" style="padding:1rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;text-decoration:none;">
          <strong style="color:var(--green);font-family:var(--font-mono);font-size:0.75rem;">🔴 BEWARE</strong>
          <p style="margin:0.5rem 0 0;color:var(--fg-dim);font-size:0.8rem;">Security vulnerabilities with repro steps</p>
        </a>
        <a href="/blog/tag/comparison/" style="padding:1rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;text-decoration:none;">
          <strong style="color:var(--green);font-family:var(--font-mono);font-size:0.75rem;">⚖️ COMPARISONS</strong>
          <p style="margin:0.5rem 0 0;color:var(--fg-dim);font-size:0.8rem;">Head-to-head agent evaluations</p>
        </a>
        <a href="/blog/tag/guide/" style="padding:1rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;text-decoration:none;">
          <strong style="color:var(--green);font-family:var(--font-mono);font-size:0.75rem;">📚 GUIDES</strong>
          <p style="margin:0.5rem 0 0;color:var(--fg-dim);font-size:0.8rem;">Workflow tutorials and how-tos</p>
        </a>
        <a href="/blog/tag/pricing/" style="padding:1rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;text-decoration:none;">
          <strong style="color:var(--green);font-family:var(--font-mono);font-size:0.75rem;">💰 PRICING</strong>
          <p style="margin:0.5rem 0 0;color:var(--fg-dim);font-size:0.8rem;">Token costs and plan breakdowns</p>
        </a>
      </div>
    </section>

    <!-- FAQ for GEO -->
    <section class="search-faq" style="margin:3rem 0;">
      <h2 style="font-size:1.1rem;font-family:var(--font-mono);color:var(--green);margin:0 0 1.5rem;">Frequently Asked Questions</h2>
      
      <details style="margin:1rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
        <summary style="cursor:pointer;font-family:var(--font-mono);color:var(--fg-bright);font-size:0.9rem;">Does terminalblog search track my queries?</summary>
        <p style="margin:0.75rem 0 0;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">No. Pagefind runs entirely in your browser. The search index (~200KB) downloads once, then all queries execute locally. Nothing is sent to our servers or third parties.</p>
      </details>

      <details style="margin:1rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
        <summary style="cursor:pointer;font-family:var(--font-mono);color:var(--fg-bright);font-size:0.9rem;">How often is the search index updated?</summary>
        <p style="margin:0.75rem 0 0;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">The index rebuilds on every deploy. Since terminalblog publishes multiple times per week, the index is typically fresh within hours of new articles going live.</p>
      </details>

      <details style="margin:1rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
        <summary style="cursor:pointer;font-family:var(--font-mono);color:var(--fg-bright);font-size:0.9rem;">Can I search for specific agents or tags?</summary>
        <p style="margin:0.75rem 0 0;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">Yes. Use <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">tool:claude-code</code> for agent-specific results, or <code style="font-family:var(--font-mono);background:var(--border);padding:0.1rem 0.3rem;border-radius:3px;">tag:security</code> for tag-filtered results. The tag filter links above also work.</p>
      </details>

      <details style="margin:1rem 0;padding:1rem;background:var(--bg-alt);border:1px solid var(--border);border-radius:6px;">
        <summary style="cursor:pointer;font-family:var(--font-mono);color:var(--fg-bright);font-size:0.9rem;">Why don't I see results for a new agent?</summary>
        <p style="margin:0.75rem 0 0;color:var(--fg-dim);font-size:0.85rem;line-height:1.7;">We only index agents we actively cover (19+ tracked agents). If an agent isn't in our ecosystem coverage, it won't appear. Check the <a href="/leaderboard/" style="color:var(--green);">leaderboard</a> for currently tracked agents.</p>
      </details>
    </section>

    <div class="search-wrap">
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="search-input" class="search-input" placeholder="e.g. Claude Code, Cursor, pricing..." autofocus aria-label="Search articles" />
        <kbd class="search-hint">/</kbd>
      </div>
      <div id="search-results" class="search-results"></div>
    </div>

  </div>

  <link rel="preload" href="/pagefind/pagefind-ui.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <link rel="preload" href="/pagefind/pagefind-ui.js" as="script" />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      if (!input || !results) return;

      // Keyboard shortcut: "/" to focus search
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
          e.preventDefault();
          input.focus();
        }
      });

      // Dynamically load pagefind JS then init
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        if (window.PagefindUI) {
          new window.PagefindUI({
            element: '#search-results',
            showImages: false,
            showSubResults: true,
            excerptLength: 20,
            resetStyles: true,
            autofocus: false,
          });
          // Wire custom input to pagefind
          setTimeout(() => {
            const pfInput = document.querySelector('.pagefind-ui__search-input');
            if (pfInput && input) {
              input.addEventListener('input', (e) => {
                pfInput.value = e.target.value;
                pfInput.dispatchEvent(new Event('input', { bubbles: true }));
              });
            }
          }, 100);
        }
      };
      document.body.appendChild(script);
    });
  </script>

  <style is:global>
      .search-header { padding: 2rem 0 1rem; }
      .search-input-wrap { display: flex; align-items: center; gap: 0.5rem; background: #0c0c0c; border: 1px solid #1a1a1a; border-radius: 6px; padding: 0.5rem 0.8rem; }
      .search-icon { font-size: 0.85rem; }
      .search-input { flex: 1; background: none; border: none; outline: none; color: var(--fg-bright); font-family: var(--font-mono); font-size: 0.9rem; }
      .search-input::placeholder { color: var(--fg-dim); }
      .search-hint { font-family: var(--font-mono); font-size: 0.6rem; padding: 0.15rem 0.4rem; border: 1px solid #222; border-radius: 3px; color: #555; }
      .search-results { margin-top: 1rem; }

      .search-tag {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        color: var(--fg-dim);
        text-decoration: none;
        transition: all 0.15s;
        background: var(--bg-alt);
      }
      .search-tag:hover {
        border-color: var(--green);
        color: var(--green);
      }

      .pagefind-ui { --pagefind-ui-font: var(--font-mono); --pagefind-ui-primary: var(--green); --pagefind-ui-text: var(--fg-bright); --pagefind-ui-background: var(--bg-alt); --pagefind-ui-border: var(--border); --pagefind-ui-tag: var(--border); --pagefind-ui-scale: 0.85; }
      .pagefind-ui__search-input { display: none !important; }
      .pagefind-ui__search-clear { display: none !important; }
      .pagefind-ui__search-icon { display: none !important; }
      .pagefind-ui__result-title { font-family: var(--font-mono); }
      .pagefind-ui__result-excerpt { color: var(--fg-dim); }
    </style>
</Layout>
