const faq = [
  {
    q: 'What is AGENTS.md?',
    a: "AGENTS.md is a plain Markdown file in your repository root that tells AI coding agents how to work in your project: build and test commands, code style, commit conventions, and the hard limits you never want crossed. It is the agent-facing counterpart to README.md. The README explains the project to humans, AGENTS.md explains it to the agent, which is why the two should not be merged.",
  },
  {
    q: 'Which AI coding agents read AGENTS.md?',
    a: 'Codex reads AGENTS.md by default, along with AGENTS.override.md for per-directory overrides and ~/.codex/AGENTS.md for personal defaults. OpenCode, Cursor, Aider, goose, Zed, Warp, VS Code, Factory, Jules, Devin and Junie support it too. The two big exceptions are Claude Code, which reads CLAUDE.md instead, and Gemini CLI, which reads GEMINI.md — both can import your AGENTS.md with a one-line @import so you keep a single source of truth.',
  },
  {
    q: 'Where should I put AGENTS.md?',
    a: 'In the repository root, committed to version control, so the whole team and CI get identical rules. Add nested AGENTS.md files in subdirectories for package-specific rules: agents that walk the tree (Codex, Claude Code, Cursor, Gemini CLI) merge them from the root down and the closest file wins. Keep personal preferences in a global file such as ~/.codex/AGENTS.md or ~/.claude/CLAUDE.md where they are never committed.',
  },
  {
    q: 'How do I write a good AGENTS.md?',
    a: 'Write short, imperative, checkable rules. Name the exact command to run instead of "run the tests". Include the prohibitions, because that is where agents fail: never touch .env, never force push, never commit unless asked. Point at files instead of pasting their contents, keep the file in the low hundreds of lines (Codex caps combined instructions at 32 KiB by default and drops the overflow), and update the file the moment an agent does something wrong, so the correction survives the next session.',
  },
];

/* Rules that apply to every file above. */
const universalRules = [
  ['Say what to run, not what to do.', '`pnpm check` beats "make sure the checks pass". A command is verifiable; an intention is not.'],
  ['Write the prohibitions.', 'Half the value of these files is the "never" list. Agents default to plausible, destructive actions when nobody told them otherwise.'],
  ['Reference, do not paste.', 'Point at docs/engineering/style.md instead of copying it in. A pasted copy is stale within a month and nobody notices.'],
  ['Scope it, do not staple it on.', 'A root file for what is true everywhere, one nested file for what is true in one package.'],
  ['Fix the file when the agent errs.', 'The moment you correct an agent, the correction belongs in the rules file, in the same commit.'],
  ['Keep it under a few hundred lines.', 'Long files get skimmed by you and truncated by the tools. Split by concern instead.'],
];

