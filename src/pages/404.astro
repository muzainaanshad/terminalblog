---
import Layout from '../layouts/Layout.astro';
import FuzzyRedirect from '@jdevalk/astro-seo-graph/FuzzyRedirect.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div style="max-width:600px;margin:4rem auto;padding:0 1.5rem;text-align:center;">
    <h1 style="font-size:3rem;font-family:var(--font-mono);color:var(--green);margin-bottom:0.5rem;">404</h1>
    <p style="color:var(--fg-dim);font-size:0.9rem;margin-bottom:2rem;">This page doesn't exist. It may have been moved or the URL is wrong.</p>
    <FuzzyRedirect />
    <a href="/" style="display:inline-block;margin-top:2rem;padding:0.5rem 1.5rem;background:var(--green);color:#000;font-family:var(--font-mono);font-size:0.85rem;border-radius:6px;text-decoration:none;">← Go home</a>
  </div>
</Layout>
