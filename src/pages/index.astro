---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import agents from '../data/agents.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/** Low-signal commit roundups — fine in /blog, deprioritized on homepage hero. */
function isJustShipped(p: (typeof posts)[number]) {
  const tags = p.data.tags || [];
  return (
    p.id.includes('just-shipped') ||
    tags.includes('just-shipped') ||
    tags.includes('shipped')
  );
}

/** Off-niche industry noise — keep off hero; show under Industry only. */
function isIndustryOnly(p: (typeof posts)[number]) {
  const tags = p.data.tags || [];
  const tool = p.data.tool || '';
  if (tool === 'industry' && !tags.includes('security') && !tags.includes('beware') && !tags.includes('pillar')) {
    // pure industry gossip
    if (tags.includes('news') || tags.includes('launches') || tags.includes('industry')) {
      // allow if also coding-agent focused tags
      const agentish = tags.some(t =>
        ['coding-agents', 'comparison', 'security', 'beware', 'guide', 'pillar', 'mcp', 'agents-dot-md'].includes(t)
      );
      if (!agentish) return true;
    }
  }
  // Explicit off-niche slug patterns
  if (/kraken|seedream|trading-bot|internet-court|bytedance-seedream/i.test(p.id)) return true;
  return false;
}

/** Prefer security, opinion, comparison, pillars, and non-roundup news for homepage surface. */
const featurePosts = posts.filter(p => !isJustShipped(p) && !isIndustryOnly(p));
const homepagePosts = featurePosts.length >= 4 ? featurePosts : posts.filter(p => !isJustShipped(p));

// Articles shown in hero + spotlight — filter these from other sections
const heroIds = new Set(homepagePosts.slice(0, 4).map(p => p.id));

const pillars = posts
  .filter(p => (p.data.tags || []).includes('pillar') && !heroIds.has(p.id))
  .slice(0, 4);
const comparisons = posts.filter(p => p.data.tags?.includes('comparison') && !heroIds.has(p.id)).slice(0, 6);
const opinions = posts.filter(p => p.data.tags?.includes('opinion') && !heroIds.has(p.id)).slice(0, 5);
const industry = posts.filter(p => isIndustryOnly(p) && !heroIds.has(p.id)).slice(0, 4);
// Latest feed: coding-agent relevant only (still chronological)
const latestFeed = posts.filter(p => !heroIds.has(p.id) && !isIndustryOnly(p)).slice(0, 8);
const trending = homepagePosts.filter(p => !heroIds.has(p.id)).slice(0, 5);

// Only surface substantial tags in the home nav (thin tags stay reachable from posts)
const tagCounts: Record<string, number> = {};
posts.forEach(p => (p.data.tags || []).forEach(t => {
  tagCounts[t] = (tagCounts[t] || 0) + 1;
}));
const topTags = Object.entries(tagCounts)
  .filter(([, count]) => count >= 3)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15)
  .map(([tag]) => tag);

const hero = homepagePosts[0];
const spot1 = homepagePosts[1];
const spot2 = homepagePosts[2];
const spot3 = homepagePosts[3];

function formatDate(d) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
}
function tagClass(tag) {
  const hash = tag.split('').reduce((s, c) => s + c.charCodeAt(0), 0);
  const colors = ['#22c55e', '#f59e0b', '#3b82f6', '#a855f7', '#ec4899', '#06b6d4', '#f97316', '#84cc16'];
  return colors[hash % colors.length];
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="home-wrap">

    <!-- Header -->
    <header class="home-header">
      <div class="home-header-main">
        <div>
          <h1>terminalblog<span class="cursor-blink">▊</span></h1>
          <p class="home-sub">AI coding agents — security, adoption data, comparisons</p>
        </div>
        <div class="home-stats">
          <span><b>{agents.length}</b> agents</span>
          <span><b>{posts.length}</b> articles</span>
        </div>
      </div>
    </header>

    <!-- Terminal Status Panel -->
    <section class="status-panel" id="status-panel">
      <div class="status-header">
        <span class="status-dot live"></span>
        <span class="status-label">live feed</span>
        <span class="status-sep">|</span>
        <span class="status-line" id="status-line">
          <span class="typing">> scanning for AI agent signals...</span>
          <span class="cursor-thin">▊</span>
        </span>
      </div>
      <div class="status-ticker-wrap">
        <div class="status-ticker" id="status-ticker">
          <span class="ticker-item">🐞 kira_bug_hunter · tracking agent crashes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🚀 dev_explorer · testing latest Codex beta</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">📊 rho_stats · pricing comparison updated</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">👁 sage_watcher · ecosystem trend analysis</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">⚙️ ada_px · workflow optimization notes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🔓 jax_opensrc · reviewing open source commits</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🐞 kira_bug_hunter · tracking agent crashes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🚀 dev_explorer · testing latest Codex beta</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">📊 rho_stats · pricing comparison updated</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">👁 sage_watcher · ecosystem trend analysis</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">⚙️ ada_px · workflow optimization notes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🔓 jax_opensrc · reviewing open source commits</span>
          <span class="ticker-sep">│</span>
        </div>
      </div>
    </section>

    <script>
      // Status messages — no source reveals, just ecosystem chatter
      const statusLines = [
        '> scanning for AI agent signals...',
        '> kira_bug_hunter crashing Claude Code in controlled env',
        '> dev_explorer beta-testing latest release',
        '> rho_stats crunching pricing comparison numbers',
        '> sage_watcher reading 47 HN threads on agent reliability',
        '> ada_px optimizing terminal workflow configs',
        '> jax_opensrc reviewing open source commits',
        '> next post incoming — timer counting down above',
        '> watching the ecosystem for breaking signals',
        '> hermes agent session: analyzing tool call patterns',
        '> tracking the cursor sand agent saga',
        '> grok 4.5 benchmark comparison in progress',
        '> ollama 9M builders — what it means for agents',
        '> compiling weekly coding agent heat map...',
        '> kira_bug_hunter: something feels off about sonnet 5',
        '> signal detected — new agent vulnerability report',
        '> rho_stats: someone spent 3k on Claude Code last month',
        '> checking what\'s going on in the agent ecosystem...',
        '> google AI studio repo import — testing results',
        '> agent health indicators — can we trust them?',
      ];

      // Rotating status line (7s per message — slow and readable)
      let lineIdx = 0;
      const statusEl = document.getElementById('status-line');
      if (statusEl) {
        setInterval(() => {
          lineIdx = (lineIdx + 1) % statusLines.length;
          statusEl.innerHTML = `<span class="typing">${statusLines[lineIdx]}</span><span class="cursor-thin">▊</span>`;
        }, 7000);
      }
    </script>

    <!-- Tag nav -->
    <nav class="tag-nav">
      {topTags.slice(0, 12).map(tag => (
        <a href={`/blog/tag/${tag}/`} class="tag-pill" style={`--tag-color: ${tagClass(tag)};`}>{tag}</a>
      ))}
      <a href="/blog/" class="tag-pill all-link">all →</a>
    </nav>

    <!-- Featured hero (quality-first: skip just-shipped roundups) -->
    <section class="hero-section">
      <a href={`/blog/${hero.id}/`} class="hero-card">
        <div class="hero-meta">
          <span class="hero-badge">latest</span>
          <span>{formatDate(hero.data.pubDate)}</span>
        </div>
        <h2 class="hero-title">{hero.data.title}</h2>
        <p class="hero-desc">{hero.data.description}</p>
        <div class="hero-tags">
          {(hero.data.tags || []).slice(0, 4).map(t => <span class="mini-tag">{t}</span>)}
        </div>
      </a>
    </section>

    <!-- Inline newsletter signup -->
        <section class="home-inline-newsletter">
          <div class="hin-text">
            <span class="hin-label">📬</span>
            <span>Security Bewares, leaderboard moves, and the few posts that matter. Weekly.</span>
          </div>
          <form class="hin-form" id="hin-form">
            <label for="hin-email" class="visually-hidden">Email address</label>
            <input type="email" id="hin-email" name="email" required placeholder="you@company.com" autocomplete="email" />
            <button type="submit" id="hin-btn">Subscribe</button>
          </form>
          <p class="hin-status" id="hin-status" role="status" aria-live="polite"></p>
        </section>

    <script is:inline>
    (function() {
      const form = document.getElementById('hin-form');
      const statusEl = document.getElementById('hin-status');
      const btn = document.getElementById('hin-btn');
      if (!form) return;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('hin-email')?.value?.trim();
        if (!email) return;
        btn.disabled = true;
        btn.textContent = '...';
        try {
          const res = await fetch('/api/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'homepage-inline' }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            statusEl.textContent = '✓ Subscribed';
            statusEl.className = 'hin-status ok';
            form.reset();
            btn.textContent = '✓';
          } else {
            statusEl.textContent = data.error || 'Try again.';
            statusEl.className = 'hin-status err';
            btn.textContent = 'Subscribe';
          }
        } catch {
          statusEl.textContent = 'Network error.';
          statusEl.className = 'hin-status err';
          btn.textContent = 'Subscribe';
        } finally {
          btn.disabled = false;
        }
      });
    })();
    </script>

    <!-- Pillars (SEO money pages) -->
    {pillars.length > 0 && (
      <section class="section-group">
        <div class="section-header">
          <h2>Start here</h2>
          <a href="/blog/tag/pillar/" class="section-more">all pillars →</a>
        </div>
        <div class="mini-grid">
          {pillars.map(p => (
            <a href={`/blog/${p.id}/`} class="mini-card">
              <div class="mini-meta">pillar</div>
              <div class="mini-title">{p.data.title}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Latest feed -->
    <section class="section-group">
      <div class="section-header">
        <h2>Latest</h2>
        <a href="/blog/" class="section-more">all {posts.length} →</a>
      </div>
      <div class="latest-feed">
        {latestFeed.map(p => (
          <a href={`/blog/${p.id}/`} class="latest-item">
            <span class="latest-date">{formatDate(p.data.pubDate)}</span>
            <span class="latest-tags">{(p.data.tags || []).filter(t => t !== 'comparison').slice(0, 2).map(t => t).join(' · ')}</span>
            <span class="latest-title">{p.data.title}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Spotlight grid -->
    <section class="spotlight">
      {spot1 && <a href={`/blog/${spot1.id}/`} class="spotlight-card">
        <div class="spotlight-meta">
          {(spot1.data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(spot1.data.pubDate)}</span>
        </div>
        <h3>{spot1.data.title}</h3>
        <p>{spot1.data.description?.substring(0, 100)}</p>
      </a>}
      {spot2 && <a href={`/blog/${spot2.id}/`} class="spotlight-card">
        <div class="spotlight-meta">
          {(spot2.data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(spot2.data.pubDate)}</span>
        </div>
        <h3>{spot2.data.title}</h3>
        <p>{spot2.data.description?.substring(0, 100)}</p>
      </a>}
      {spot3 && <a href={`/blog/${spot3.id}/`} class="spotlight-card highlight">
        <div class="spotlight-meta">
          {(spot3.data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(spot3.data.pubDate)}</span>
        </div>
        <h3>{spot3.data.title}</h3>
        <p>{spot3.data.description?.substring(0, 100)}</p>
      </a>}
    </section>

    <!-- Industry (gated off hero) -->
    {industry.length > 0 && (
      <section class="section-group">
        <div class="section-header">
          <h2>Industry</h2>
          <a href="/blog/tag/industry/" class="section-more">all →</a>
        </div>
        <div class="compact-list">
          {industry.map(p => (
            <a href={`/blog/${p.id}/`} class="compact-item">
              <span class="compact-date">{formatDate(p.data.pubDate)}</span>
              <span class="compact-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Comparisons -->
    <section class="section-group">
      <div class="section-header">
        <h2>Comparisons</h2>
        <a href="/blog/tag/comparison/" class="section-more">all →</a>
      </div>
      <div class="mini-grid">
        {comparisons.slice(0, 4).map(p => (
          <a href={`/blog/${p.id}/`} class="mini-card">
            <div class="mini-meta">{formatDate(p.data.pubDate)}</div>
            <div class="mini-title">{p.data.title}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Opinion + Trending two-col -->
    <div class="two-col">
      <section class="section-group">
        <div class="section-header"><h2>Opinion</h2><a href="/blog/tag/opinion/" class="section-more">all →</a></div>
        <div class="compact-list">
          {opinions.slice(0, 4).map(p => (
            <a href={`/blog/${p.id}/`} class="compact-item">
              <span class="compact-date">{formatDate(p.data.pubDate)}</span>
              <span class="compact-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </section>
      <section class="section-group">
        <div class="section-header"><h2>Trending</h2></div>
        <div class="compact-list numbered">
          {trending.slice(0, 5).map((p, i) => (
            <a href={`/blog/${p.id}/`} class="compact-item">
              <span class="compact-num">{i + 1}</span>
              <span class="compact-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <Newsletter />

    <!-- Agents table -->
    <details class="agents-section">
      <summary><span style="color:var(--green);font-family:var(--font-mono);margin-right:0.5rem;">#</span> {agents.length} Agents tracked <span class="collapse-hint">expand</span></summary>
      <div style="overflow-x:auto;margin-top:1rem;">
        <table class="compare-table">
          <thead><tr><th>Agent</th><th>Type</th><th>Price</th><th>SWE-b</th><th>Vision</th><th>Cron</th><th>Multi-provider</th><th>Git</th></tr></thead>
          <tbody>{agents.map(a => (<tr><td><a href={`/tool/${a.id}/`} class="agent-link">{a.name}</a></td><td class="td-sm">{a.type}</td><td class="td-mono td-sm">{a.pricing}</td><td class="td-mono td-sm">{a.sweBench}</td>{Object.entries(a.features).slice(0,4).map(([k,v]) => <td class={v ? 'yes' : 'no'}>{v ? 'yes' : '—'}</td>)}</tr>))}</tbody>
        </table>
      </div>
    </details>

    {/* Top 3 by Usage Widget */}
    <section class="top-agents-widget">
      <div class="section-header">
        <h2>Top by Usage</h2>
        <a href="/leaderboard/" class="section-more">full leaderboard →</a>
      </div>
      <div class="top-agents-grid">
        {(() => {
          // Read adoption data
          const fs = require('fs');
          const path = require('path');
          const snapshotsDir = path.join(process.cwd(), 'src', 'data', 'adoption', 'snapshots');
          const snapshots = fs.readdirSync(snapshotsDir).filter(f => f.endsWith('.json')).sort().reverse();
          const latest = snapshots.length > 0 ? JSON.parse(fs.readFileSync(path.join(snapshotsDir, snapshots[0]), 'utf-8')) : null;
          const agents = latest?.agents || [];
          const top3 = agents.slice(0, 3);
          
          function formatNum(n) {
            if (n === null || n === undefined) return '—';
            if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
            if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
            return n.toLocaleString();
          }
          
          return top3.map((agent, i) => (
            <a href={`/tool/${agent.id}/`} class="top-agent-card">
              <div class="top-agent-rank">#{i + 1}</div>
              <div class="top-agent-name">{agent.name}</div>
              <div class="top-agent-stats">
                <span class="npm-stat">{formatNum(agent.npm_downloads)} npm/wk</span>
                <span class="star-stat">{formatNum(agent.github_stars)} ★</span>
              </div>
              <div class="top-agent-score">Score: {agent.growth_score}</div>
            </a>
          ));
        })()}
      </div>
    </section>

    <section class="cli-box">
      <code><span class="green">$</span> npx terminalblog</code>
      <p>Get the latest articles from your terminal. Free &amp; open source.</p>
      <a href="https://github.com/Anshad2u/terminalblog-cli" class="cli-link">github.com/Anshad2u/terminalblog-cli →</a>
    </section>

    <!-- Badge row -->
    <div class=\"badge-row\">
      <a href=\"https://www.scrolllaunch.com/products/terminalblog?utm_source=badge&utm_medium=embed&utm_campaign=terminalblog&ref=scrolllaunch\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"badge-link\">
        <img src=\"https://www.scrolllaunch.com/api/badge/terminalblog\" alt=\"Featured on ScrollLaunch\" width=\"160\" height=\"48\" loading=\"lazy\" class=\"badge-img\" />
      </a>
      <a href=\"https://showmeyour.site\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Listed on ShowMeYourSite\" class=\"badge-link\">
        <img src=\"https://showmeyour.site/badge.svg\" alt=\"Listed on ShowMeYourSite\" width=\"140\" height=\"40\" class=\"badge-img\" />
      </a>
      <a href=\"https://wired.business\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Listed on Wired Business\" class=\"badge-link\">
        <img src=\"https://wired.business/wired-business.png\" alt=\"Listed on Wired Business\" width=\"110\" height=\"40\" class=\"badge-img\" />
      </a>
    </div>

  </div>

  <style is:global>
    @media (max-width: 600px) { .home-wrap { gap: 1.2rem !important; } .spotlight, .two-col, .mini-grid { grid-template-columns: 1fr !important; } .home-header-main { flex-direction: column !important; align-items: flex-start !important; gap: 0.5rem !important; } .hero-title { font-size: 1.3rem !important; } .status-ticker-wrap { display: none !important; } }
    .home-wrap { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.8rem; padding: 0 1rem; }
    .home-header { padding: 2rem 0 0; }
    .home-header-main { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
    .home-header h1 { font-size: 2rem; margin: 0; letter-spacing: -0.02em; }
    .home-sub { font-size: 0.85rem; color: var(--fg-dim); margin: 0.2rem 0 0; }
    .home-stats { display: flex; gap: 1rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-dim); white-space: nowrap; }
    .home-stats b { color: var(--green); }
    .cursor-blink { animation: blink 1s step-end infinite; display: inline-block; color: var(--green); }
    @keyframes blink { 50% { opacity: 0; } }

    /* Status Panel */
    .status-panel { border: 1px solid #1a1a1a; border-radius: 8px; background: #0c0c0c; overflow: hidden; }
    .status-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.8rem; font-family: var(--font-mono); font-size: 0.7rem; border-bottom: 1px solid #1a1a1a; color: #525252; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .status-dot.live { background: #22c55e; box-shadow: 0 0 4px #22c55e88; animation: pulse-dot 2s infinite; }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    .status-label { color: #22c55e; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.6rem; }
    .status-sep { color: #222; }
    .status-line { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #a3a3a3; }
    .status-ticker-wrap { padding: 0.4rem 0.8rem; overflow: hidden; }
    .status-ticker { display: flex; gap: 0; white-space: nowrap; animation: scroll-ticker 60s linear infinite; font-family: var(--font-mono); font-size: 0.68rem; color: #525252; }
    .ticker-item { padding: 0 0.3rem; }
    .ticker-sep { color: #222; padding: 0 0.3rem; }
    @keyframes scroll-ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    .tag-nav { display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.3rem 0; scrollbar-width: none; flex-wrap: nowrap; }
    .tag-nav::-webkit-scrollbar { display: none; }
    .tag-pill { padding: 0.2rem 0.6rem; border-radius: 6px; font-family: var(--font-mono); font-size: 0.7rem; border: 1px solid var(--border); color: var(--fg-dim); white-space: nowrap; text-decoration: none; transition: all 0.15s; }
    .tag-pill:hover { border-color: var(--tag-color, var(--green)); color: var(--tag-color, var(--green)); }
    .all-link { border-color: var(--green); color: var(--green); }
    .hero-section { margin: 0; }
    .hero-card { display: block; padding: 1.5rem; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(135deg, var(--bg-alt) 0%, var(--bg) 100%); text-decoration: none; transition: border-color 0.2s; }
    .hero-card:hover { border-color: var(--green); }
    .hero-meta { display: flex; gap: 0.75rem; align-items: center; font-size: 0.72rem; font-family: var(--font-mono); color: var(--fg-dim); margin-bottom: 0.75rem; }
    .hero-badge { background: var(--green); color: #000; padding: 0.1rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.65rem; text-transform: uppercase; }
    .hero-title { font-size: 1.5rem; margin: 0 0 0.5rem; line-height: 1.3; color: var(--fg-bright); }
    .hero-desc { font-size: 0.85rem; color: var(--fg-dim); margin: 0 0 0.75rem; line-height: 1.5; }
