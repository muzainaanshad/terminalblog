---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import agents from '../data/agents.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featureLabels: Record<string, string> = {
  vision: 'Vision', cron: 'Cron/Schedule', multiProvider: 'Multi-provider',
  gitIntegration: 'Git', pluginSystem: 'Plugins', subagents: 'Subagents',
  bgTasks: 'BG tasks', localFirst: 'Local-first'
};
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="content" style="max-width:860px;">

    <!-- Hero -->
    <section style="text-align:center;padding:3rem 0 1.5rem;">
      <h1 style="font-size:2.5rem;margin:0 0 0.5rem;letter-spacing:-0.02em;">
        terminalblog<span class="cursor-blink"></span>
      </h1>
      <p style="font-size:1rem;color:var(--fg-dim);max-width:30rem;margin:0 auto;line-height:1.6;">
        I test every coding agent so you don't have to. Claude Code, Cursor, Hermes, Codex — honest reviews from someone who actually uses them daily.
      </p>
    </section>

    <!-- Stats -->
    <section class="stat-grid">
      <div class="stat-box">
        <div class="stat-num">10</div>
        <div class="stat-label">Agents tested</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">{posts.length}</div>
        <div class="stat-label">Articles</div>
      </div>
      <div class="stat-box">
        <div class="stat-num" style="font-size:1.15rem;">4</div>
        <div class="stat-label">Open-source</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">24/7</div>
        <div class="stat-label">Updated</div>
      </div>
    </section>

    <!-- Current setup -->
    <section style="margin:2.5rem 0;">
      <div class="term-window">
        <div class="term-bar">
          <span class="term-dot red"></span>
          <span class="term-dot yellow"></span>
          <span class="term-dot green"></span>
          <span class="term-title">~/.terminalblog/current-setup</span>
        </div>
        <div class="term-body" style="font-family:var(--font-mono);font-size:0.82rem;line-height:1.8;color:var(--fg-dim);">
          <span style="color:var(--fg-dim);"># What I'm using right now (updated weekly)</span><br/>
          <span style="color:var(--green);">export</span> PRIMARY_AGENT=<span style="color:var(--amber);">"Claude Code"</span><br/>
          <span style="color:var(--green);">export</span> AUTOMATION=<span style="color:var(--amber);">"Hermes Agent"</span><br/>
          <span style="color:var(--green);">export</span> QUICK_EDITS=<span style="color:var(--amber);">"Cursor"</span><br/>
          <span style="color:var(--green);">export</span> MODEL=<span style="color:var(--amber);">"Claude Opus 4.8"</span><br/>
          <span style="color:var(--green);">export</span> SECONDARY=<span style="color:var(--amber);">"Oh My Pi (Grok 4.5)"</span><br/>
          <span style="color:var(--green);">export</span> COST_MONTH=<span style="color:var(--amber);">"~$180 tokens"</span>
        </div>
      </div>
    </section>

    <!-- Quick picks -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Quick picks</h2>
      <div class="agent-grid">
        <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.25rem;">
          <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--green);margin-bottom:0.3rem;text-transform:uppercase;letter-spacing:0.08em;">Best overall</div>
          <div style="font-size:1.05rem;font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);">Claude Code</div>
          <div style="font-size:0.75rem;color:var(--fg-dim);margin-top:0.15rem;">Terminal agent · $20-200/mo</div>
          <div style="font-size:0.8rem;color:var(--fg);margin-top:0.5rem;">Deep reasoning, strong multi-file refactors, solid plugin system. Expensive but worth it for complex work.</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.25rem;">
          <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--green);margin-bottom:0.3rem;text-transform:uppercase;letter-spacing:0.08em;">Best free</div>
          <div style="font-size:1.05rem;font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);">Hermes Agent</div>
          <div style="font-size:0.75rem;color:var(--fg-dim);margin-top:0.15rem;">Terminal agent · Free (BYO keys)</div>
          <div style="font-size:0.8rem;color:var(--fg);margin-top:0.5rem;">Cron, subagents, multi-provider, credential guard. Most capable open-source agent by far.</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.25rem;">
          <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--green);margin-bottom:0.3rem;text-transform:uppercase;letter-spacing:0.08em;">Best editor</div>
          <div style="font-size:1.05rem;font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);">Cursor</div>
          <div style="font-size:0.75rem;color:var(--fg-dim);margin-top:0.15rem;">AI-native IDE · $20/mo</div>
          <div style="font-size:0.8rem;color:var(--fg);margin-top:0.5rem;">Fastest inline editing. Composer for multi-file. Background agents. Best daily driver.</div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.25rem;">
          <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--green);margin-bottom:0.3rem;text-transform:uppercase;letter-spacing:0.08em;">Best for parallel</div>
          <div style="font-size:1.05rem;font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);">Codex CLI</div>
          <div style="font-size:0.75rem;color:var(--fg-dim);margin-top:0.15rem;">CLI + Cloud · $20-200/mo</div>
          <div style="font-size:0.8rem;color:var(--fg);margin-top:0.5rem;">Parallel Git worktree execution. Fire multiple agents on independent tasks. Best for batch work.</div>
        </div>
      </div>
    </section>

    <!-- Full comparison table -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Full comparison</h2>
      <div style="overflow-x:auto;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Type</th>
              <th>Price</th>
              <th>SWE-B</th>
              {Object.values(featureLabels).slice(0,5).map(l => <th>{l}</th>)}
            </tr>
          </thead>
          <tbody>
            {agents.map(a => (
              <tr>
                <td><a href={`/tool/${a.id}/`} style="font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);font-size:0.78rem;">{a.name}</a></td>
                <td style="font-size:0.7rem;color:var(--fg-dim);">{a.type}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.pricing}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.sweBench}</td>
                {Object.entries(a.features).slice(0,5).map(([k,v]) => (
                  <td class={v ? 'yes' : 'no'}>{v ? 'yes' : '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.7rem;color:var(--fg-dim);margin-top:0.5rem;font-family:var(--font-mono);">
        $ SWE-bench from vendor reports. Compare updated weekly.
      </p>
    </section>

    <!-- Latest posts -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Latest</h2>
      <div>
        {posts.slice(0, 10).map(post => (
          <a href={`/blog/${post.id}/`} class="post-item">
            <div>
              <div class="post-title">{post.data.title}</div>
              <div class="post-meta">
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                {post.data.tags?.includes('opinion') ? <span style="margin-left:0.5rem;color:var(--amber);">opinion</span> : null}
                {post.data.tags?.includes('viral') ? <span style="margin-left:0.3rem;color:var(--green);">popular</span> : null}
              </div>
            </div>
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/blog" style="font-family:var(--font-mono);font-size:0.8rem;color:var(--green);">view all {posts.length} articles →</a>
      </div>
    </section>

    <!-- About blurbs -->
    <section style="margin:2.5rem 0;padding-top:1.5rem;border-top:1px solid var(--border);">
      <p style="font-size:0.8rem;color:var(--fg-dim);font-family:var(--font-mono);line-height:1.7;">
        terminalblog is a collection of honest reviews, comparisons, and opinions about AI coding tools. 
        I test every agent on real projects — not benchmark tasks. 
        <a href="/about">More about this site →</a>
      </p>
    </section>

  </div>
</Layout>
