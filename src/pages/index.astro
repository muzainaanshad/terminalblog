---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import agents from '../data/agents.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];
const second = posts[1];
const third = posts[2];

const comparisons = posts.filter(p => p.data.tags?.includes('comparison')).slice(0, 6);
const opinions = posts.filter(p => p.data.tags?.includes('opinion') && p.id !== latest.id).slice(0, 5);
const trending = posts.slice(0, 5);

const tagCounts = {};
posts.forEach(p => (p.data.tags || []).forEach(t => tagCounts[t] = (tagCounts[t] || 0) + 1));
const topTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 15).map(([tag]) => tag);

function formatDate(d) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function tagClass(tag) {
  const hash = tag.split('').reduce((s, c) => s + c.charCodeAt(0), 0);
  const colors = ['#22c55e', '#f59e0b', '#3b82f6', '#a855f7', '#ec4899', '#06b6d4', '#f97316', '#84cc16'];
  return colors[hash % colors.length];
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="home-wrap">

    <!-- Header -->
    <header class="home-header">
      <div class="home-header-main">
        <div>
          <h1>terminalblog<span class="cursor-blink">▊</span></h1>
          <p class="home-sub">Following the AI coding agent ecosystem</p>
        </div>
        <div class="home-stats">
          <span><b>{agents.length}</b> agents</span>
          <span><b>{posts.length}</b> articles</span>
        </div>
      </div>
    </header>

    <!-- Terminal Status Panel -->
    <section class="status-panel" id="status-panel">
      <div class="status-header">
        <span class="status-dot live"></span>
        <span class="status-label">live feed</span>
        <span class="status-sep">|</span>
        <span class="status-line" id="status-line">
          <span class="typing">> scanning for AI agent signals...</span>
          <span class="cursor-thin">▊</span>
        </span>
        <span class="countdown-badge" id="countdown-badge">
          <span class="countdown-icon">⏰</span>
          <span class="countdown-text" id="countdown-text">—</span>
        </span>
      </div>
      <div class="status-ticker-wrap">
        <div class="status-ticker" id="status-ticker">
          <span class="ticker-item">🐞 kira_bug_hunter · tracking agent crashes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🚀 dev_explorer · testing latest Codex beta</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">📊 rho_stats · pricing comparison updated</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">👁 sage_watcher · ecosystem trend analysis</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">⚙️ ada_px · workflow optimization notes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🔓 jax_opensrc · reviewing open source commits</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🐞 kira_bug_hunter · tracking agent crashes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🚀 dev_explorer · testing latest Codex beta</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">📊 rho_stats · pricing comparison updated</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">👁 sage_watcher · ecosystem trend analysis</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">⚙️ ada_px · workflow optimization notes</span>
          <span class="ticker-sep">│</span>
          <span class="ticker-item">🔓 jax_opensrc · reviewing open source commits</span>
          <span class="ticker-sep">│</span>
        </div>
      </div>
    </section>

    <script>
      // Status messages — no source reveals, just ecosystem chatter
      const statusLines = [
        '> scanning for AI agent signals...',
        '> kira_bug_hunter crashing Claude Code in controlled env',
        '> dev_explorer beta-testing latest release',
        '> rho_stats crunching pricing comparison numbers',
        '> sage_watcher reading 47 HN threads on agent reliability',
        '> ada_px optimizing terminal workflow configs',
        '> jax_opensrc reviewing open source commits',
        '> next post incoming — timer counting down above',
        '> watching the ecosystem for breaking signals',
        '> hermes agent session: analyzing tool call patterns',
        '> tracking the cursor sand agent saga',
        '> grok 4.5 benchmark comparison in progress',
        '> ollama 9M builders — what it means for agents',
        '> compiling weekly coding agent heat map...',
        '> kira_bug_hunter: something feels off about sonnet 5',
        '> signal detected — new agent vulnerability report',
        '> rho_stats: someone spent 3k on Claude Code last month',
        '> checking what\'s going on in the agent ecosystem...',
        '> google AI studio repo import — testing results',
        '> agent health indicators — can we trust them?',
      ];

      // Rotating status line (7s per message — slow and readable)
      let lineIdx = 0;
      const statusEl = document.getElementById('status-line');
      if (statusEl) {
        setInterval(() => {
          lineIdx = (lineIdx + 1) % statusLines.length;
          statusEl.innerHTML = `<span class="typing">${statusLines[lineIdx]}</span><span class="cursor-thin">▊</span>`;
        }, 7000);
      }

      // Countdown timer to next estimated post
      const countdownEl = document.getElementById('countdown-text');
      if (countdownEl) {
        // Get latest article pubDate from a data attribute
        const lastPostStr = '{latest.data.pubDate.valueOf()}';
        const lastPost = new Date(parseInt(lastPostStr));
        // Deterministic random offset between 60-180 minutes based on post date
        const seed = lastPost.getTime();
        const offset = 60 + ((seed % 727) % 120); // 60-180 min deterministic
        // Calculate next post time
        let nextPost = new Date(lastPost.getTime() + offset * 60000);
        // If that time has passed, add another offset
        while (nextPost.getTime() < Date.now()) {
          const seed2 = nextPost.getTime();
          const offset2 = 60 + ((seed2 % 727) % 120);
          nextPost = new Date(nextPost.getTime() + offset2 * 60000);
        }

        function updateCountdown() {
          const now = Date.now();
          const diff = nextPost.getTime() - now;
          if (diff <= 0) {
            countdownEl.textContent = 'soon...';
            return;
          }
          const mins = Math.floor(diff / 60000);
          const secs = Math.floor((diff % 60000) / 1000);
          if (mins >= 60) {
            const h = Math.floor(mins / 60);
            const m = mins % 60;
            countdownEl.textContent = `${h}h ${m}m`;
          } else {
            countdownEl.textContent = `${mins}m ${secs}s`;
          }
        }
        updateCountdown();
        setInterval(updateCountdown, 1000);
      }
    </script>

    <!-- Tag nav -->
    <nav class="tag-nav">
      {topTags.slice(0, 12).map(tag => (
        <a href={`/blog/tag/${tag}/`} class="tag-pill" style={`--tag-color: ${tagClass(tag)};`}>{tag}</a>
      ))}
      <a href="/blog/" class="tag-pill all-link">all →</a>
    </nav>

    <!-- Featured hero -->
    <section class="hero-section">
      <a href={`/blog/${latest.id}/`} class="hero-card">
        <div class="hero-meta">
          <span class="hero-badge">latest</span>
          <span>{formatDate(latest.data.pubDate)}</span>
        </div>
        <h2 class="hero-title">{latest.data.title}</h2>
        <p class="hero-desc">{latest.data.description}</p>
        <div class="hero-tags">
          {(latest.data.tags || []).slice(0, 4).map(t => <span class="mini-tag">{t}</span>)}
        </div>
      </a>
    </section>

    <!-- Latest feed -->
    <section class="section-group">
      <div class="section-header">
        <h2>Latest</h2>
        <a href="/blog/" class="section-more">all {posts.length} →</a>
      </div>
      <div class="latest-feed">
        {posts.slice(0, 8).map(p => (
          <a href={`/blog/${p.id}/`} class="latest-item">
            <span class="latest-date">{formatDate(p.data.pubDate)}</span>
            <span class="latest-tags">{(p.data.tags || []).filter(t => t !== 'comparison').slice(0, 2).map(t => t).join(' · ')}</span>
            <span class="latest-title">{p.data.title}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Spotlight grid -->
    <section class="spotlight">
      <a href={`/blog/${second.id}/`} class="spotlight-card">
        <div class="spotlight-meta">
          {(second.data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(second.data.pubDate)}</span>
        </div>
        <h3>{second.data.title}</h3>
        <p>{second.data.description?.substring(0, 100)}</p>
      </a>
      <a href={`/blog/${third.id}/`} class="spotlight-card">
        <div class="spotlight-meta">
          {(third.data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(third.data.pubDate)}</span>
        </div>
        <h3>{third.data.title}</h3>
        <p>{third.data.description?.substring(0, 100)}</p>
      </a>
      {posts[3] && <a href={`/blog/${posts[3].id}/`} class="spotlight-card highlight">
        <div class="spotlight-meta">
          {(posts[3].data.tags || []).filter(t => t !== 'opinion').slice(0, 2).map(t => <span class="mini-tag">{t}</span>)}
          <span class="spotlight-date">{formatDate(posts[3].data.pubDate)}</span>
        </div>
        <h3>{posts[3].data.title}</h3>
        <p>{posts[3].data.description?.substring(0, 100)}</p>
      </a>}
    </section>

    <!-- Comparisons -->
    <section class="section-group">
      <div class="section-header">
        <h2>Comparisons</h2>
        <a href="/blog/tag/comparison/" class="section-more">all →</a>
      </div>
      <div class="mini-grid">
        {comparisons.slice(0, 4).map(p => (
          <a href={`/blog/${p.id}/`} class="mini-card">
            <div class="mini-meta">{formatDate(p.data.pubDate)}</div>
            <div class="mini-title">{p.data.title}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Opinion + Trending two-col -->
    <div class="two-col">
      <section class="section-group">
        <div class="section-header"><h2>Opinion</h2><a href="/blog/tag/opinion/" class="section-more">all →</a></div>
        <div class="compact-list">
          {opinions.slice(0, 4).map(p => (
            <a href={`/blog/${p.id}/`} class="compact-item">
              <span class="compact-date">{formatDate(p.data.pubDate)}</span>
              <span class="compact-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </section>
      <section class="section-group">
        <div class="section-header"><h2>Trending</h2></div>
        <div class="compact-list numbered">
          {trending.slice(0, 5).map((p, i) => (
            <a href={`/blog/${p.id}/`} class="compact-item">
              <span class="compact-num">{i + 1}</span>
              <span class="compact-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- Agents table -->
    <details class="agents-section">
      <summary><span style="color:var(--green);font-family:var(--font-mono);margin-right:0.5rem;">#</span> {agents.length} Agents tracked <span class="collapse-hint">expand</span></summary>
      <div style="overflow-x:auto;margin-top:1rem;">
        <table class="compare-table">
          <thead><tr><th>Agent</th><th>Type</th><th>Price</th><th>SWE-b</th><th>Vision</th><th>Cron</th><th>Multi-provider</th><th>Git</th></tr></thead>
          <tbody>{agents.map(a => (<tr><td><a href={`/tool/${a.id}/`} class="agent-link">{a.name}</a></td><td class="td-sm">{a.type}</td><td class="td-mono td-sm">{a.pricing}</td><td class="td-mono td-sm">{a.sweBench}</td>{Object.entries(a.features).slice(0,4).map(([k,v]) => <td class={v ? 'yes' : 'no'}>{v ? 'yes' : '—'}</td>)}</tr>))}</tbody>
        </table>
      </div>
    </details>

    <section class="cli-box">
      <code><span class="green">$</span> npx terminalblog</code>
      <p>Get the latest articles from your terminal. Free &amp; open source.</p>
      <a href="https://github.com/Anshad2u/terminalblog-cli" class="cli-link">github.com/Anshad2u/terminalblog-cli →</a>
    </section>

  </div>

  <style is:global>
    @media (max-width: 600px) { .home-wrap { gap: 1.2rem !important; } .spotlight, .two-col, .mini-grid { grid-template-columns: 1fr !important; } .home-header-main { flex-direction: column !important; align-items: flex-start !important; gap: 0.5rem !important; } .hero-title { font-size: 1.3rem !important; } .status-ticker-wrap { display: none !important; } }
    .home-wrap { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.8rem; padding: 0 1rem; }
    .home-header { padding: 2rem 0 0; }
    .home-header-main { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
    .home-header h1 { font-size: 2rem; margin: 0; letter-spacing: -0.02em; }
    .home-sub { font-size: 0.85rem; color: var(--fg-dim); margin: 0.2rem 0 0; }
    .home-stats { display: flex; gap: 1rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-dim); white-space: nowrap; }
    .home-stats b { color: var(--green); }
    .cursor-blink { animation: blink 1s step-end infinite; display: inline-block; color: var(--green); }
    @keyframes blink { 50% { opacity: 0; } }

    /* Status Panel */
    .status-panel { border: 1px solid #1a1a1a; border-radius: 8px; background: #0c0c0c; overflow: hidden; }
    .status-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.8rem; font-family: var(--font-mono); font-size: 0.7rem; border-bottom: 1px solid #1a1a1a; color: #525252; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .status-dot.live { background: #22c55e; box-shadow: 0 0 4px #22c55e88; animation: pulse-dot 2s infinite; }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    .status-label { color: #22c55e; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.6rem; }
    .status-sep { color: #222; }
    .status-line { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #a3a3a3; }
    .status-ticker-wrap { padding: 0.4rem 0.8rem; overflow: hidden; }
    .status-ticker { display: flex; gap: 0; white-space: nowrap; animation: scroll-ticker 60s linear infinite; font-family: var(--font-mono); font-size: 0.68rem; color: #525252; }
    .ticker-item { padding: 0 0.3rem; }
    .ticker-sep { color: #222; padding: 0 0.3rem; }
    @keyframes scroll-ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .countdown-badge { display: flex; align-items: center; gap: 0.3rem; flex-shrink: 0; background: #111; border: 1px solid #1a1a1a; border-radius: 4px; padding: 0.15rem 0.5rem; font-family: var(--font-mono); margin-left: auto; }
    .countdown-icon { font-size: 0.65rem; }
    .countdown-text { color: #22c55e; font-size: 0.65rem; font-weight: 600; min-width: 4.5rem; text-align: right; }

    .tag-nav { display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.3rem 0; scrollbar-width: none; flex-wrap: nowrap; }
    .tag-nav::-webkit-scrollbar { display: none; }
    .tag-pill { padding: 0.2rem 0.6rem; border-radius: 6px; font-family: var(--font-mono); font-size: 0.7rem; border: 1px solid var(--border); color: var(--fg-dim); white-space: nowrap; text-decoration: none; transition: all 0.15s; }
    .tag-pill:hover { border-color: var(--tag-color, var(--green)); color: var(--tag-color, var(--green)); }
    .all-link { border-color: var(--green); color: var(--green); }
    .hero-section { margin: 0; }
    .hero-card { display: block; padding: 1.5rem; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(135deg, var(--bg-alt) 0%, var(--bg) 100%); text-decoration: none; transition: border-color 0.2s; }
    .hero-card:hover { border-color: var(--green); }
    .hero-meta { display: flex; gap: 0.75rem; align-items: center; font-size: 0.72rem; font-family: var(--font-mono); color: var(--fg-dim); margin-bottom: 0.75rem; }
    .hero-badge { background: var(--green); color: #000; padding: 0.1rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.65rem; text-transform: uppercase; }
    .hero-title { font-size: 1.5rem; margin: 0 0 0.5rem; line-height: 1.3; color: var(--fg-bright); }
    .hero-desc { font-size: 0.85rem; color: var(--fg-dim); margin: 0 0 0.75rem; line-height: 1.5; }
    .hero-tags { display: flex; gap: 0.3rem; flex-wrap: wrap; }
    .spotlight { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .spotlight-card { display: block; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; transition: border-color 0.2s; background: var(--bg-alt); }
    .spotlight-card:hover { border-color: var(--green); }
    .spotlight-card h3 { font-size: 0.9rem; margin: 0.4rem 0 0; line-height: 1.4; color: var(--fg); }
    .spotlight-card p { font-size: 0.78rem; color: var(--fg-dim); margin: 0.4rem 0 0; line-height: 1.4; }
    .spotlight-meta { display: flex; gap: 0.3rem; align-items: center; flex-wrap: wrap; }
    .spotlight-date { font-size: 0.65rem; font-family: var(--font-mono); color: var(--fg-dim); }
    .highlight { border-color: var(--amber); }
    .highlight:hover { border-color: var(--green); }
    .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
    .section-header h2 { font-size: 1rem; margin: 0; }
    .section-more { font-size: 0.72rem; font-family: var(--font-mono); color: var(--green); text-decoration: none; }
    .mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .mini-card { display: block; padding: 0.7rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; text-decoration: none; transition: border-color 0.15s; }
    .mini-card:hover { border-color: var(--green); }
    .mini-meta { font-size: 0.65rem; font-family: var(--font-mono); color: var(--fg-dim); margin-bottom: 0.3rem; }
    .mini-title { font-size: 0.78rem; color: var(--fg); line-height: 1.3; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .compact-list { display: flex; flex-direction: column; gap: 0.3rem; }
    .compact-item { display: flex; gap: 0.5rem; align-items: baseline; padding: 0.35rem 0.5rem; border-radius: 4px; text-decoration: none; color: var(--fg); font-size: 0.78rem; transition: background 0.1s; line-height: 1.3; }
    .compact-item:hover { background: var(--bg-alt); }
    .compact-date { font-family: var(--font-mono); font-size: 0.65rem; color: var(--fg-dim); white-space: nowrap; min-width: 3.2rem; }
    .compact-num { font-family: var(--font-mono); font-size: 0.7rem; color: var(--green); min-width: 1.2rem; text-align: right; font-weight: 600; }
    .mini-tag { display: inline-block; font-size: 0.6rem; padding: 0.05rem 0.35rem; border-radius: 4px; background: var(--border); color: var(--fg-dim); font-family: var(--font-mono); }
    .green { color: var(--green); }
    .latest-feed { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .latest-item { display: grid; grid-template-columns: 5rem 6rem 1fr; gap: 0.75rem; padding: 0.6rem 0.8rem; text-decoration: none; color: var(--fg); font-size: 0.8rem; border-bottom: 1px solid var(--border); transition: background 0.1s; align-items: baseline; }
    .latest-item:last-child { border-bottom: none; }
    .latest-item:hover { background: var(--bg-alt); }
    .latest-date { font-family: var(--font-mono); font-size: 0.65rem; color: var(--fg-dim); white-space: nowrap; }
    .latest-tags { font-family: var(--font-mono); font-size: 0.6rem; color: var(--fg-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .latest-title { line-height: 1.4; color: var(--fg-bright); }
    @media (max-width: 600px) { .latest-item { grid-template-columns: 1fr; gap: 0.2rem; } .latest-tags { display: none; } }
    .agents-section { margin: 0.5rem 0; }
    .agents-section summary { cursor: pointer; font-size: 1rem; font-weight: 600; color: var(--fg-bright); padding: 0.4rem 0; list-style: none; }
    .collapse-hint { float: right; font-size: 0.7rem; color: var(--fg-dim); font-weight: normal; }
    .agent-link { font-weight: 600; color: var(--fg-bright); font-family: var(--font-mono); font-size: 0.75rem; }
    .td-sm { font-size: 0.65rem; }
    .td-mono { font-family: var(--font-mono); }
    .cli-box { padding: 1.5rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-alt); text-align: center; }
    .cli-box code { font-family: var(--font-mono); font-size: 0.85rem; }
    .cli-box p { font-size: 0.82rem; color: var(--fg-dim); margin: 0.5rem 0 0.6rem; }
    .cli-link { font-family: var(--font-mono); font-size: 0.75rem; color: var(--green); }
  </style>
</Layout>
