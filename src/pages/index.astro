---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import agents from '../data/agents.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags with counts
const tagCounts: Record<string, number> = {};
posts.forEach(p => {
  (p.data.tags || []).forEach(t => {
    tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});
const allTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));

const featureLabels: Record<string, string> = {
  vision: 'Vision', cron: 'Cron/Schedule', multiProvider: 'Multi-provider',
  gitIntegration: 'Git', pluginSystem: 'Plugins', subagents: 'Subagents',
  bgTasks: 'BG tasks', localFirst: 'Local-first'
};
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="content" style="max-width:860px;">

    <!-- Hero -->
    <section style="text-align:center;padding:2.5rem 0 0.5rem;">
      <h1 style="font-size:2.5rem;margin:0 0 0.5rem;letter-spacing:-0.02em;">
        terminalblog<span class="cursor-blink"></span>
      </h1>
      <p style="font-size:1rem;color:var(--fg-dim);max-width:32rem;margin:0 auto;line-height:1.6;">
        Following the AI coding agent ecosystem — Claude Code, Cursor, Hermes, Codex, and everything in between.
      </p>
      <div style="display:flex;gap:1.5rem;justify-content:center;margin-top:1rem;font-family:var(--font-mono);font-size:0.75rem;color:var(--fg-dim);">
        <span><span style="color:var(--green);">{agents.length}</span> agents tracked</span>
        <span><span style="color:var(--green);">{posts.length}</span> articles</span>
        <span>updated <span style="color:var(--green);">every 3h</span></span>
      </div>
    </section>

    <!-- Tag filter bar -->
    <section style="margin:1.5rem 0;position:sticky;top:0;z-index:10;background:var(--bg);padding:0.5rem 0;border-bottom:1px solid var(--border);">
      <div style="display:flex;gap:0.4rem;overflow-x:auto;padding-bottom:0.3rem;scrollbar-width:none;" id="tag-bar">
        <button class="tag-btn active" data-tag="all">all <span style="opacity:0.5;">{posts.length}</span></button>
        {allTags.slice(0, 20).map(t => (
          <button class="tag-btn" data-tag={t.tag}>{t.tag} <span style="opacity:0.5;">{t.count}</span></button>
        ))}
      </div>
    </section>

    <!-- Latest / Filtered posts -->
    <section style="margin:1.5rem 0;" id="posts-section">
      <div id="posts-list">
        {posts.map(post => (
          <a href={`/blog/${post.id}/`} class="post-item" data-tags={(post.data.tags || []).join(',')}>
            <div style="flex:1;min-width:0;">
              <div class="post-title">{post.data.title}</div>
              <div class="post-meta">
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                {(post.data.tags || []).slice(0, 3).map(t => (
                  <span class="post-tag">{t}</span>
                ))}
              </div>
            </div>
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
      <div id="no-results" style="display:none;text-align:center;padding:2rem;color:var(--fg-dim);font-family:var(--font-mono);font-size:0.85rem;">
        No articles match this filter.
      </div>
    </section>

    <!-- Agent comparison table (collapsed by default) -->
    <details style="margin:2rem 0;">
      <summary style="cursor:pointer;font-size:1.1rem;font-weight:600;color:var(--fg-bright);padding:0.5rem 0;list-style:none;">
        <span style="color:var(--green);font-family:var(--font-mono);margin-right:0.5rem;">#</span> Agent comparison table
        <span style="float:right;font-size:0.75rem;color:var(--fg-dim);font-weight:normal;">click to expand</span>
      </summary>
      <div style="overflow-x:auto;margin-top:1rem;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Type</th>
              <th>Price</th>
              <th>SWE-b</th>
              {Object.values(featureLabels).slice(0,5).map(l => <th>{l}</th>)}
            </tr>
          </thead>
          <tbody>
            {agents.map(a => (
              <tr>
                <td><a href={`/tool/${a.id}/`} style="font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);font-size:0.78rem;">{a.name}</a></td>
                <td style="font-size:0.7rem;color:var(--fg-dim);">{a.type}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.pricing}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.sweBench}</td>
                {Object.entries(a.features).slice(0,5).map(([k,v]) => (
                  <td class={v ? 'yes' : 'no'}>{v ? 'yes' : '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <!-- Agent grid (collapsed) -->
    <details style="margin:2rem 0;">
      <summary style="cursor:pointer;font-size:1.1rem;font-weight:600;color:var(--fg-bright);padding:0.5rem 0;list-style:none;">
        <span style="color:var(--green);font-family:var(--font-mono);margin-right:0.5rem;">#</span> All agents
        <span style="float:right;font-size:0.75rem;color:var(--fg-dim);font-weight:normal;">click to expand</span>
      </summary>
      <div class="agent-grid" style="margin-top:1rem;">
        {agents.map(agent => (
          <a href={`/tool/${agent.id}/`} class="agent-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.4rem;">
              <strong style="font-family:var(--font-mono);font-size:0.9rem;">{agent.name}</strong>
              <span style="font-size:0.65rem;padding:0.1rem 0.4rem;border-radius:4px;background:{agent.openSource ? '#22c55e22' : '#f59e0b22'};color:{agent.openSource ? 'var(--green)' : 'var(--amber)'};white-space:nowrap;font-family:var(--font-mono);">
                {agent.openSource ? 'OSS' : 'commercial'}
              </span>
            </div>
            <div style="font-size:0.72rem;color:var(--fg-dim);margin-bottom:0.5rem;font-family:var(--font-mono);">
              {agent.type} · {agent.pricing}
            </div>
            <div style="font-size:0.78rem;color:var(--fg);line-height:1.4;">
              {agent.bestFor}
            </div>
            {agent.sweBench !== '-' ? (
              <div style="margin-top:0.5rem;font-family:var(--font-mono);font-size:0.7rem;color:var(--green);">
                SWE-bench: {agent.sweBench}
              </div>
            ) : null}
          </a>
        ))}
      </div>
    </details>

    <!-- CLI tool promotion -->
    <section style="margin:2.5rem 0;padding:1.5rem;border:1px solid var(--border);border-radius:10px;background:var(--bg-alt);text-align:center;">
      <p style="font-family:var(--font-mono);font-size:0.8rem;margin:0 0 0.5rem;">
        <span style="color:var(--green);">$</span> npx terminalblog
      </p>
      <p style="font-size:0.85rem;color:var(--fg-dim);margin:0 0 0.8rem;">
        Get the latest articles from your terminal. Free CLI tool — open source.
      </p>
      <a href="https://github.com/Anshad2u/terminalblog-cli" style="font-family:var(--font-mono);font-size:0.78rem;color:var(--green);">
        github.com/Anshad2u/terminalblog-cli →
      </a>
    </section>

  </div>

  <style>
    .tag-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--fg-dim);
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }
    .tag-btn:hover {
      border-color: var(--green);
      color: var(--fg);
    }
    .tag-btn.active {
      background: var(--green);
      color: #000;
      border-color: var(--green);
      font-weight: 600;
    }
    .post-tag {
      display: inline-block;
      font-size: 0.6rem;
      padding: 0.05rem 0.35rem;
      border-radius: 4px;
      background: var(--border);
      color: var(--fg-dim);
      font-family: var(--font-mono);
      margin-left: 0.3rem;
    }
    .post-item {
      transition: background 0.1s;
    }
    .post-item:hover {
      background: var(--bg-alt);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tagBtns = document.querySelectorAll('.tag-btn');
      const posts = document.querySelectorAll('#posts-list .post-item');
      const noResults = document.getElementById('no-results');
      let activeTag = 'all';

      tagBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          activeTag = btn.getAttribute('data-tag') || 'all';
          tagBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          let visible = 0;
          posts.forEach(post => {
            const tags = post.getAttribute('data-tags') || '';
            const match = activeTag === 'all' || tags.split(',').includes(activeTag);
            (post as HTMLElement).style.display = match ? '' : 'none';
            if (match) visible++;
          });

          if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
        });
      });
    });
  </script>
</Layout>
