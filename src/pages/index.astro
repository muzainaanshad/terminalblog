---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import agents from '../data/agents.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featureLabels: Record<string, string> = {
  vision: 'Vision', cron: 'Cron/Schedule', multiProvider: 'Multi-provider',
  gitIntegration: 'Git', pluginSystem: 'Plugins', subagents: 'Subagents',
  bgTasks: 'BG tasks', localFirst: 'Local-first'
};
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="content" style="max-width:860px;">

    <!-- Hero -->
    <section style="text-align:center;padding:3rem 0 1.5rem;">
      <h1 style="font-size:2.5rem;margin:0 0 0.5rem;letter-spacing:-0.02em;">
        terminalblog<span class="cursor-blink"></span>
      </h1>
      <p style="font-size:1rem;color:var(--fg-dim);max-width:32rem;margin:0 auto;line-height:1.6;">
        Following the coding agent ecosystem — what ships, what's debated, and what matters. Claude Code, Cursor, Hermes, Codex, and everything in between.
      </p>
    </section>

    <!-- Real stats -->
    <section class="stat-grid">
      <div class="stat-box">
        <div class="stat-num">{posts.length}</div>
        <div class="stat-label">Articles published</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">{agents.length}</div>
        <div class="stat-label">Agents tracked</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">8</div>
        <div class="stat-label">Sources monitored</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">3h</div>
        <div class="stat-label">Update cycle</div>
      </div>
    </section>

    <!-- What this is -->
    <section style="margin:2.5rem 0;">
      <div class="term-window">
        <div class="term-bar">
          <span class="term-dot red"></span>
          <span class="term-dot yellow"></span>
          <span class="term-dot green"></span>
          <span class="term-title">~/.terminalblog/about</span>
        </div>
        <div class="term-body" style="font-family:var(--font-mono);font-size:0.82rem;line-height:1.8;color:var(--fg-dim);">
          <span style="color:var(--green);">$</span> cat README.md<br/><br/>
          <span style="color:var(--fg);">terminalblog tracks the open-source AI coding agent landscape.</span><br/><br/>
          <span style="color:var(--green);">$</span> ls <span style="color:var(--green);">--sources</span><br/>
          &nbsp;&nbsp;GitHub releases &amp; commits<br/>
          &nbsp;&nbsp;Hacker News discussions<br/>
          &nbsp;&nbsp;Reddit (r/ClaudeCode, r/CodingAI, r/LocalLLaMA)<br/>
          &nbsp;&nbsp;SWE-bench leaderboard<br/><br/>
          <span style="color:var(--green);">$</span> echo <span style="color:var(--amber);">"Published every 3 hours via automated pipeline"</span><br/>
          <span style="color:var(--fg);">→ terminalblog.com</span>
        </div>
      </div>
    </section>

    <!-- Agent comparison table (just the data, no fake opinions) -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Agent comparison</h2>
      <div style="overflow-x:auto;">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Type</th>
              <th>Price</th>
              <th>SWE-b</th>
              {Object.values(featureLabels).slice(0,5).map(l => <th>{l}</th>)}
            </tr>
          </thead>
          <tbody>
            {agents.map(a => (
              <tr>
                <td><a href={`/tool/${a.id}/`} style="font-weight:600;color:var(--fg-bright);font-family:var(--font-mono);font-size:0.78rem;">{a.name}</a></td>
                <td style="font-size:0.7rem;color:var(--fg-dim);">{a.type}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.pricing}</td>
                <td style="font-family:var(--font-mono);font-size:0.7rem;">{a.sweBench}</td>
                {Object.entries(a.features).slice(0,5).map(([k,v]) => (
                  <td class={v ? 'yes' : 'no'}>{v ? 'yes' : '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:0.7rem;color:var(--fg-dim);margin-top:0.5rem;font-family:var(--font-mono);">
        $ SWE-bench scores from vendor reports. Features from docs. Updated regularly.
      </p>
    </section>

    <!-- All agents grid -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">All agents</h2>
      <div class="agent-grid">
        {agents.map(agent => (
          <a href={`/tool/${agent.id}/`} class="agent-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.4rem;">
              <strong style="font-family:var(--font-mono);font-size:0.9rem;">{agent.name}</strong>
              <span style="font-size:0.65rem;padding:0.1rem 0.4rem;border-radius:4px;background:{agent.openSource ? '#22c55e22' : '#f59e0b22'};color:{agent.openSource ? 'var(--green)' : 'var(--amber)'};white-space:nowrap;font-family:var(--font-mono);">
                {agent.openSource ? 'OSS' : 'commercial'}
              </span>
            </div>
            <div style="font-size:0.72rem;color:var(--fg-dim);margin-bottom:0.5rem;font-family:var(--font-mono);">
              {agent.type} · {agent.pricing}
            </div>
            <div style="font-size:0.78rem;color:var(--fg);line-height:1.4;">
              {agent.bestFor}
            </div>
            {agent.sweBench !== '-' ? (
              <div style="margin-top:0.5rem;font-family:var(--font-mono);font-size:0.7rem;color:var(--green);">
                SWE-bench: {agent.sweBench}
              </div>
            ) : null}
          </a>
        ))}
      </div>
    </section>

    <!-- Latest posts -->
    <section style="margin:2.5rem 0;">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Latest</h2>
      <div>
        {posts.slice(0, 10).map(post => (
          <a href={`/blog/${post.id}/`} class="post-item">
            <div>
              <div class="post-title">{post.data.title}</div>
              <div class="post-meta">
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                {post.data.tags?.includes('opinion') ? <span style="margin-left:0.5rem;color:var(--amber);">opinion</span> : null}
              </div>
            </div>
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/blog" style="font-family:var(--font-mono);font-size:0.8rem;color:var(--green);">view all {posts.length} articles →</a>
      </div>
    </section>

  </div>
</Layout>
