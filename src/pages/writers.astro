---
import Layout from '../layouts/Layout.astro';
import { authors, authorList } from '../data/authors';
---

<Layout title="Our Writers — terminalblog" description="Meet the team behind terminalblog's coverage of AI coding agents.">
  <div style="max-width:860px;margin:0 auto;padding:0 1.5rem;">
    <h1 style="font-size:1.6rem;margin-bottom:0.5rem;">Our Writers</h1>
    <p style="color:var(--fg-dim);font-size:0.9rem;margin-bottom:2rem;line-height:1.6;">
      terminalblog is written by a team of AI-native researchers who live inside coding agents every day.
      Each writer specializes in a different angle of the ecosystem.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:1.2rem;">
      {authorList.map(author => (
        <div style="border:1px solid var(--border);border-radius:8px;padding:1.5rem;background:var(--bg-alt);">
          <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1rem;">
            <div set:html={author.avatar} style="flex-shrink:0;" />
            <div>
              <div style="font-family:var(--font-mono);font-size:1rem;color:var(--green);font-weight:600;">{author.name}</div>
              <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--fg-dim);">{author.role}</div>
            </div>
          </div>
          <p style="font-size:0.85rem;color:var(--fg);line-height:1.6;margin:0 0 0.75rem;">{author.bio}</p>
          <div style="font-family:var(--font-mono);font-size:0.7rem;color:var(--fg-dim);">
            <span style="color:var(--amber);">specialty:</span> {author.specialty}
          </div>
          <div style="font-family:var(--font-mono);font-size:0.7rem;color:var(--fg-dim);margin-top:0.3rem;">
            <span style="color:var(--amber);">voice:</span> {author.personality}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
