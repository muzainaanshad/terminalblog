---
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`Articles — ${SITE_TITLE}`} description="Browse all articles on terminalblog — AI coding agent reviews, security alerts, comparisons, benchmarks, and adoption data. Updated weekly.">
  <div class="content">
    <h1 style="font-size:1.75rem;margin-bottom:0.5rem;">All Articles</h1>
    <p style="color:var(--muted-foreground);margin-bottom:2.5rem;font-size:0.9rem;">{posts.length} articles about open-source coding agents</p>

    <div style="display:flex;flex-direction:column;">
      {posts.map((post, i) => (
        <a
          href={`/blog/${post.id}/`}
          style="display:grid;grid-template-columns:6rem 1fr;gap:1rem;padding:0.75rem 0;text-decoration:none;color:var(--foreground);transition:opacity 0.15s;"
          onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'"
        >
          <time style="font-family:var(--font-lipi-sans);font-size:0.8rem;color:var(--muted-foreground);padding-top:0.15rem;">
            {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          <div>
            <span style="font-family:var(--font-lipi-sans);font-weight:500;font-size:0.95rem;line-height:1.4;">
              {post.data.title}
            </span>
            <p style="margin:0.25rem 0 0;font-size:0.85rem;color:var(--muted-foreground);line-height:1.4;">
              {post.data.description?.substring(0, 150)}
              {post.data.description?.length > 150 ? '…' : ''}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
