---
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE } from '../../../consts';
import { getCollection } from 'astro:content';

const toolNames: Record<string, string> = {
  hermes: 'Hermes Agent',
  opencode: 'OpenCode',
  mimo: 'Mimo Code',
  kilo: 'Kilo Code CLI',
  'pi-dot-dev': 'pi.dev',
  'gitlawb-zero': 'Gitlawb Zero',
  'oh-my-pi': 'Oh My Pi',
  'claude-code': 'Claude Code',
  goose: 'Goose',
  openclaw: 'OpenClaw',
  codebuff: 'Codebuff',
  cursor: 'Cursor',
  codex: 'OpenAI Codex',
  ampcode: 'AmpCode',
  'copilot-cli': 'GitHub Copilot CLI',
};

export async function getStaticPaths() {
  // Keep this list inline — Astro isolates getStaticPaths from outer consts
  const toolTags = new Set([
    'hermes', 'opencode', 'mimo', 'kilo', 'pi-dot-dev', 'gitlawb-zero',
    'oh-my-pi', 'claude-code', 'goose', 'openclaw', 'codebuff', 'cursor',
    'codex', 'ampcode', 'copilot-cli',
  ]);
  const posts = await getCollection('blog');
  const tags = new Set<string>();
  for (const p of posts) {
    for (const t of p.data.tags || []) {
      // Tool tags are served by /tool/[id] (see vercel.json redirects)
      if (!toolTags.has(t)) tags.add(t);
    }
  }
  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter(p => (p.data.tags || []).includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Thin tag pages: keep for navigation, but don't waste crawl budget ranking them
const MIN_INDEXABLE_POSTS = 3;
const robots =
  allPosts.length < MIN_INDEXABLE_POSTS ? 'noindex, follow' : 'index, follow';
---

<Layout
  title={`#${tag} — ${SITE_TITLE}`}
  description={`Articles tagged with #${tag} on terminalblog — AI coding agent coverage.`}
  robots={robots}
>
  <div class="content" style="max-width:860px;margin:0 auto;padding:0 1.5rem;">
    <h1 style="font-size:1.75rem;margin-bottom:0.5rem;">#<span style="color:var(--green);">{tag}</span></h1>
    <p style="color:var(--fg-dim);margin-bottom:2.5rem;font-size:0.85rem;font-family:var(--font-mono);">{allPosts.length} article{allPosts.length !== 1 ? 's' : ''}</p>

    <div style="display:flex;flex-direction:column;">
      {allPosts.map(post => (
        <a href={`/blog/${post.id}/`} style="display:grid;grid-template-columns:6rem 1fr;gap:1rem;padding:0.75rem 0;text-decoration:none;color:var(--fg);border-bottom:1px solid var(--border);transition:background 0.1s;" onmouseover="this.style.background='var(--bg-alt)'" onmouseout="this.style.background='transparent'">
          <time style="font-family:var(--font-mono);font-size:0.75rem;color:var(--fg-dim);padding-top:0.1rem;">{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          <div>
            <span style="font-family:var(--font-mono);font-weight:600;font-size:0.85rem;line-height:1.4;color:var(--fg-bright);">{post.data.title}</span>
            <p style="margin:0.25rem 0 0;font-size:0.8rem;color:var(--fg-dim);line-height:1.4;">{post.data.description?.substring(0, 130)}{post.data.description?.length > 130 ? '…' : ''}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
