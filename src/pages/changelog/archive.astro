---
import Layout from '../../layouts/Layout.astro';
import releasesData from '../../data/harness-changelog/releases.json';

const { releases } = releasesData;
const stable = releases.filter(r => !r.prerelease);
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="Harness Changelog — Full Archive" description="Every stable release from the major AI coding harnesses, tracked daily.">
  <main style="max-width:720px;margin:0 auto;padding:2rem 1rem;">
    <h1 style="font-family:var(--font-mono);font-size:1.2rem;">Harness changelog — archive</h1>
    <p style="font-size:0.8rem;color:var(--fg-dim);">{stable.length} stable releases tracked across 10 coding agents. Auto-updated daily from GitHub releases.</p>
    <ul style="list-style:none;padding:0;">
      {stable.map((r) => (
        <li style="display:flex;gap:0.6rem;align-items:baseline;padding:0.35rem 0;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:0.8rem;">
          <span style="color:var(--fg-dim);font-size:0.7rem;min-width:6.5rem;">{fmt(r.publishedAt)}</span>
          <span style="min-width:7.5rem;">{r.tool}</span>
          <a href={r.url} target="_blank" rel="noopener" style="color:var(--green);text-decoration:none;">{r.tag}</a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
