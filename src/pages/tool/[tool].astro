---
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import agents from '../../data/agents.json';

/** Only real coding agents get /tool/ hubs — not news tags like industry/launches. */
export async function getStaticPaths() {
  // Inline agent IDs so Astro's isolated getStaticPaths scope always has them
  const validIds = new Set((agents as { id: string }[]).map(a => a.id));
  const tools = new Set<string>(validIds);
  const posts = await getCollection('blog');
  for (const p of posts) {
    if (p.data.tool && validIds.has(p.data.tool)) {
      tools.add(p.data.tool);
    }
  }
  return Array.from(tools).map(tool => ({
    params: { tool },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const agentData = (agents as { id: string; name: string; type?: string }[]).find(
  a => a.id === tool
);

// Safety: never render hub pages for non-agent "tools"
if (!agentData) {
  return Astro.redirect('/blog/', 301);
}

const allPosts = (await getCollection('blog'))
  .filter(p => p.data.tool === tool)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const toolName = agentData.name;

// Build comprehensive description for SEO
const metaDescription = `Articles about ${toolName} (${agentData?.type || 'coding agent'}). ${allPosts.length} articles covering features, bugs, pricing, comparisons, and workflows. ${agentData?.description || ''}`.substring(0, 155);

// Count article types for tag filter
const tags: Record<string, number> = {};
for (const p of allPosts) {
  for (const t of (p.data.tags || [])) {
    tags[t] = (tags[t] || 0) + 1;
  }
}
const topTags = Object.entries(tags).sort((a, b) => b[1] - a[1]).slice(0, 6);

function formatDate(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title={`${toolName} articles — ${SITE_TITLE}`} description={metaDescription}>
  <div class="content" style="max-width:900px;margin:0 auto;padding:0 1.5rem;">

    <!-- Agent Header -->
    <div class="tool-header">
      <div>
        <h1 style="font-size:1.75rem;margin-bottom:0.25rem;">{toolName}</h1>
        {agentData && (
          <div class="tool-meta">
            <span class="tool-meta-item">
              <span class="meta-lbl">Type</span>
              <span>{agentData.type}</span>
            </span>
            <span class="tool-meta-item">
              <span class="meta-lbl">Pricing</span>
              <span class="meta-val">{agentData.pricing}</span>
            </span>
            <span class="tool-meta-item">
              <span class="meta-lbl">Open Source</span>
              <span class={agentData.openSource ? 'yes-text' : 'no-text'}>{agentData.openSource ? 'Yes' : 'No'}</span>
            </span>
            {agentData.stars && <span class="tool-meta-item">
              <span class="meta-lbl">Stars</span>
              <span>{(agentData.stars / 1000).toFixed(1)}K</span>
            </span>}
          </div>
        )}
        <p class="tool-count">{allPosts.length} article{allPosts.length !== 1 ? 's' : ''}</p>
        {agentData.description && (
          <p class="tool-desc">{agentData.description}</p>
        )}
      </div>
    </div>

        <!-- Agent Description -->
        {agentData.description && (
          <div class="tool-description" style="margin: 2rem 0; padding: 1.5rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px;">
            <h2 style="font-size: 1.1rem; font-family: var(--font-mono); color: var(--green); margin-bottom: 1rem;">About {toolName}</h2>
            <p style="font-size: 0.9rem; color: var(--fg-bright); line-height: 1.7; margin: 0;">{agentData.description}</p>
          </div>
        )}

        <!-- Recommended Use Case -->
        {agentData.recommended && (
          <div class="tool-recommended" style="margin: 1.5rem 0; padding: 1rem; background: var(--bg-alt); border-left: 3px solid var(--green); border-radius: 0 8px 8px 0;">
            <h3 style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--green); margin: 0 0 0.5rem;">Best for</h3>
            <p style="font-size: 0.9rem; color: var(--fg-bright); margin: 0;">{agentData.recommended}</p>
          </div>
        )}

        <!-- Pros & Cons -->
        {(agentData.pros || agentData.cons) && (
          <div class="tool-pros-cons" style="margin: 2rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            {agentData.pros && (
              <div class="tool-pros" style="padding: 1rem; background: var(--bg-alt); border: 1px solid var(--green); border-radius: 8px;">
                <h3 style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--green); margin: 0 0 0.75rem;">Pros</h3>
                <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.85rem; color: var(--fg-bright); line-height: 1.8;">
                  {agentData.pros.map(pro => <li>{pro}</li>)}
                </ul>
              </div>
            )}
            {agentData.cons && (
              <div class="tool-cons" style="padding: 1rem; background: var(--bg-alt); border: 1px solid var(--red); border-radius: 8px;">
                <h3 style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--red); margin: 0 0 0.75rem;">Cons</h3>
                <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.85rem; color: var(--fg-bright); line-height: 1.8;">
                  {agentData.cons.map(con => <li>{con}</li>)}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- Pricing & Type Details -->
        <div class="tool-details" style="margin: 2rem 0; padding: 1.5rem; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px;">
          <h2 style="font-size: 1.1rem; font-family: var(--font-mono); color: var(--green); margin-bottom: 1rem;">Details</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; font-size: 0.85rem;">
            <div>
              <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">Type</span>
              <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{agentData.type}</p>
            </div>
            <div>
              <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">Pricing</span>
              <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{agentData.pricing}</p>
            </div>
            {agentData.sweBench && agentData.sweBench !== '-' && (
              <div>
                <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">SWE-bench</span>
                <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{agentData.sweBench}</p>
              </div>
            )}
            <div>
              <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">Open Source</span>
              <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{agentData.openSource ? 'Yes' : 'No'}</p>
            </div>
            {agentData.stars && (
              <div>
                <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">GitHub Stars</span>
                <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{(agentData.stars / 1000).toFixed(1)}K</p>
              </div>
            )}
            {agentData.license && (
              <div>
                <span style="color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.75rem;">License</span>
                <p style="color: var(--fg-bright); margin: 0.25rem 0 0;">{agentData.license}</p>
              </div>
            )}
          </div>
        </div>

        <!-- Feature Strip -->
    {agentData?.features && (
      <div class="feature-strip">
        {Object.entries(agentData.features).slice(0, 8).map(([key, val]: [string, any]) => (
          <div class={`feature-pill ${val ? 'has' : 'no'}`} title={key}>
            <span class="feature-icon">{val ? '✓' : '—'}</span>
            <span class="feature-name">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Tag filter -->
    {topTags.length > 0 && (
      <div class="tag-filter">
        <span class="filter-lbl">Topics:</span>
        {topTags.map(([tag, count]: [string, number]) => (
          <a href={`/blog/tag/${tag}/`} class="filter-tag">{tag}<span class="tag-count">{count}</span></a>
        ))}
      </div>
    )}

    <!-- Article List -->
    <div class="article-list">
      {allPosts.map(post => (
        <a href={`/blog/${post.id}/`} class="article-row">
          <div class="article-date">{formatDate(post.data.pubDate)}</div>
          <div class="article-main">
            <div class="article-title">{post.data.title}</div>
            <div class="article-desc">{post.data.description?.substring(0, 130)}{post.data.description?.length > 130 ? '…' : ''}</div>
            <div class="article-tags">
              {(post.data.tags || []).slice(0, 3).map(t => <span class="mini-tag">#{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Cross-links -->
    <div class="cross-links">
      <a href="/blog/" class="cross-link">All articles →</a>
      <a href="/writers/" class="cross-link">Our writers →</a>
    </div>

  </div>

  <style is:global>
    .tool-header { padding: 2rem 0 1rem; }
    .tool-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0; }
    .tool-meta-item { font-family: var(--font-mono); font-size: 0.75rem; padding: 0.3rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; display: flex; gap: 0.4rem; align-items: center; }
    .meta-lbl { color: var(--fg-dim); font-size: 0.65rem; text-transform: uppercase; }
    .meta-val { color: var(--fg-bright); }
    .yes-text { color: var(--green); }
    .no-text { color: var(--fg-dim); }
    .tool-count { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-dim); margin: 0; }
    .tool-desc { font-size: 0.85rem; color: var(--fg-dim); line-height: 1.6; margin: 0.75rem 0 0; max-width: 600px; }

    .feature-strip { display: flex; gap: 0.3rem; flex-wrap: wrap; padding: 0.8rem 0; margin-bottom: 0.5rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .feature-pill { display: flex; align-items: center; gap: 0.25rem; font-family: var(--font-mono); font-size: 0.6rem; padding: 0.2rem 0.45rem; border-radius: 4px; border: 1px solid var(--border); }
    .feature-pill.has { border-color: var(--green); color: var(--green); }
    .feature-pill.no { border-color: var(--border); color: var(--fg-dim); opacity: 0.6; }
    .feature-icon { font-size: 0.55rem; }
    .feature-name { white-space: nowrap; }

    .tag-filter { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0; flex-wrap: wrap; }
    .filter-lbl { font-family: var(--font-mono); font-size: 0.7rem; color: var(--fg-dim); }
    .filter-tag { font-family: var(--font-mono); font-size: 0.65rem; padding: 0.15rem 0.5rem; border: 1px solid var(--border); border-radius: 4px; color: var(--fg-dim); text-decoration: none; display: flex; align-items: center; gap: 0.3rem; transition: border-color 0.15s; }
    .filter-tag:hover { border-color: var(--green); color: var(--green); }
    .tag-count { background: var(--border); padding: 0.05rem 0.3rem; border-radius: 3px; font-size: 0.55rem; color: var(--fg-dim); }

    .article-list { display: flex; flex-direction: column; }
    .article-row { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; padding: 0.75rem 0; text-decoration: none; color: var(--fg); border-bottom: 1px solid var(--border); transition: background 0.1s; }
    .article-row:hover { background: var(--bg-alt); margin: 0 -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem; border-radius: 4px; }
    .article-date { font-family: var(--font-mono); font-size: 0.72rem; color: var(--fg-dim); padding-top: 0.1rem; }
    .article-title { font-family: var(--font-mono); font-size: 0.88rem; font-weight: 600; line-height: 1.3; color: var(--fg-bright); margin-bottom: 0.2rem; }
    .article-desc { font-size: 0.78rem; color: var(--fg-dim); line-height: 1.4; margin-bottom: 0.3rem; }
    .article-tags { display: flex; gap: 0.25rem; flex-wrap: wrap; }
    .mini-tag { font-size: 0.58rem; padding: 0.05rem 0.35rem; border-radius: 3px; background: var(--border); color: var(--fg-dim); font-family: var(--font-mono); }

    .cross-links { display: flex; gap: 1rem; padding: 1.5rem 0; }
    .cross-link { font-family: var(--font-mono); font-size: 0.78rem; color: var(--green); text-decoration: none; }
    .cross-link:hover { text-decoration: underline; }
  </style>
</Layout>
