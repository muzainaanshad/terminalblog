---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`CLI — ${SITE_TITLE}`} description="terminalblog CLI — get the latest AI coding agent articles, comparisons, and security alerts from your terminal. Free, open source, no install needed.">
  <div class="content" style="max-width:700px;margin:0 auto;padding:0 1.5rem;">

    <div class="cli-header">
      <h1 style="font-size:1.3rem;margin:0 0 0.5rem;"><code class="cli-prompt"><span class="green">$</span> npx terminalblog</code></h1>
      <p class="cli-sub">Get the latest AI coding agent articles straight from your terminal.</p>
    </div>

    <div class="cli-about">
      <h2>What is terminalblog CLI?</h2>
      <p>terminalblog CLI is a free, open-source command-line tool that delivers the latest AI coding agent news, reviews, and comparisons directly to your terminal. It pulls from <a href="https://terminalblog.com">terminalblog.com</a>, the independent source for coding agent ecosystem coverage — security bugs, real adoption data, pricing breakdowns, and honest reviews of tools like Claude Code, Cursor, Codex, Hermes, and OpenCode.</p>
      <p>No account required. No tracking. Just run the command and read.</p>
    </div>

    <div class="cli-section">
      <h2>Install</h2>
      <div class="code-block">
        <code>npx terminalblog</code>
      </div>
      <p class="cli-note">No install needed. Node.js 18+ required.</p>
    </div>

    <div class="cli-section">
      <h2>Commands</h2>
      <table class="cli-table">
        <tr><td><code>terminalblog</code></td><td>Show latest articles</td></tr>
        <tr><td><code>terminalblog ls</code></td><td>Same as above</td></tr>
        <tr><td><code>terminalblog compare</code></td><td>Compare coding agents</td></tr>
        <tr><td><code>terminalblog help</code></td><td>Show help</td></tr>
      </table>
    </div>

    <div class="cli-section">
      <h2>Sample Output</h2>
      <pre class="cli-output"><span class="dim">  terminalblog — latest 547 articles</span>
<span class="dim">  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</span>

  <span class="bold">OpenClaw Just Shipped Claude Session Fleet</span>
  <span class="dim">Jul 11, 2026</span>  <span class="amber">#openclaw</span>
  <span class="blue">https://terminalblog.com/blog/openclaw-just-shipped-claude-session-fleet/</span>

  <span class="bold">Oh My Pi Is Crashing macOS With Native Grep</span>
  <span class="dim">Jul 11, 2026</span>  <span class="amber">#oh-my-pi #bug</span>
  <span class="blue">https://terminalblog.com/blog/oh-my-pi-crashing-macos-native-grep/</span>

<span class="dim">  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</span>
<span class="dim">  terminalblog.com — following the AI coding agent ecosystem</span></pre>
    </div>

    <div class="cli-section">
      <h2>Why use the CLI?</h2>
      <ul class="cli-features">
        <li><strong>Zero friction</strong> — no signup, no API keys, no config files</li>
        <li><strong>Distraction-free</strong> — skip the browser, read in your terminal</li>
        <li><strong>Always current</strong> — pulls fresh articles on every run</li>
        <li><strong>Open source</strong> — contribute on <a href="https://github.com/Anshad2u/terminalblog-cli">GitHub</a></li>
      </ul>
    </div>

    <div class="cli-section">
      <h2>Links</h2>
      <ul class="cli-links">
        <li><a href="https://github.com/Anshad2u/terminalblog-cli">GitHub →</a></li>
        <li><a href="https://www.npmjs.com/package/terminalblog">npm →</a></li>
        <li><a href="https://terminalblog.com">Website →</a></li>
      </ul>
    </div>

  </div>

  <style is:global>
    .cli-about { padding: 0.5rem 0 1rem; border-bottom: 1px solid var(--border); margin-bottom: 1rem; }
    .cli-about h2 { font-size: 1rem; font-family: var(--font-mono); color: var(--fg-bright); margin-bottom: 0.5rem; }
    .cli-about p { font-size: 0.82rem; color: var(--fg-dim); line-height: 1.6; margin: 0.3rem 0; }
    .cli-about a { color: var(--green); text-decoration: none; }
    .cli-about a:hover { text-decoration: underline; }
    .cli-features { list-style: none; padding: 0; margin: 0; }
    .cli-features li { font-size: 0.82rem; color: var(--fg-dim); line-height: 1.6; padding: 0.2rem 0; }
    .cli-features strong { color: var(--fg-bright); }
    .cli-features a { color: var(--green); text-decoration: none; }
    .cli-features a:hover { text-decoration: underline; }
    .cli-header { padding: 2.5rem 0 0.5rem; }
    .cli-prompt { font-size: 1.3rem; font-family: var(--font-mono); }
    .cli-sub { font-size: 0.85rem; color: var(--fg-dim); margin: 0.4rem 0 0; }
    .cli-section { margin: 1.5rem 0; }
    .cli-section h2 { font-size: 1rem; font-family: var(--font-mono); color: var(--fg-bright); margin-bottom: 0.75rem; }
    .code-block { background: #0c0c0c; border: 1px solid #1a1a1a; border-radius: 6px; padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.85rem; margin-bottom: 0.4rem; }
    .cli-note { font-size: 0.72rem; color: var(--fg-dim); font-family: var(--font-mono); }
    .cli-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .cli-table td { padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--border); font-family: var(--font-mono); }
    .cli-table td:first-child { color: var(--green); }
    .cli-output { background: #0c0c0c; border: 1px solid #1a1a1a; border-radius: 6px; padding: 1rem; font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.7; overflow-x: auto; }
    .cli-links { list-style: none; padding: 0; margin: 0; }
    .cli-links li { margin: 0.4rem 0; }
    .cli-links a { font-family: var(--font-mono); font-size: 0.82rem; color: var(--green); text-decoration: none; }
    .cli-links a:hover { text-decoration: underline; }
    .green { color: var(--green); }
    .dim { color: var(--fg-dim); }
    .bold { font-weight: 700; }
    .amber { color: var(--amber); }
    .blue { color: #60a5fa; }
  </style>
</Layout>
