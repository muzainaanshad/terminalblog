---
/**
 * HarnessChangelog — the daily "what changed in coding harnesses" feed.
 * Data: src/data/harness-changelog/releases.json (refreshed daily by fetch script).
 * Shows the last 14 days of stable releases, grouped by day, with prereleases collapsed.
 */
import releasesData from '../data/harness-changelog/releases.json';

const { releases, fetchedAt } = releasesData;

// group stable releases by day
const byDay = new Map();
for (const r of releases) {
  if (r.prerelease) continue;
  const day = r.publishedAt.slice(0, 10);
  if (!byDay.has(day)) byDay.set(day, []);
  byDay.get(day).push(r);
}
const days = [...byDay.entries()].slice(0, 14);

const fmt = (d) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const rel = (iso) => {
  const diff = Math.floor((Date.now() - new Date(iso)) / 86400000);
  if (diff <= 0) return 'today';
  if (diff === 1) return 'yesterday';
  return `${diff}d ago`;
};
const TOOL_COLORS = { 'Claude Code': '#d97757', 'Codex CLI': '#10a37f', 'OpenCode': '#7aa2f7', 'Gemini CLI': '#4285f4', 'Hermes Agent': '#a78bfa', 'Cline': '#3b82f6', 'Goose': '#f59e0b', 'Aider': '#22c55e', 'Crush': '#ec4899' };
---
<section class="changelog">
  <div class="feed-head">
    <h2>What changed in coding harnesses</h2>
    <p class="sub">Stable releases from {days.length ? fmt(days[days.length-1][0]) : '—'} to {days.length ? fmt(days[0][0]) : '—'}. Prereleases and nightlies excluded. <a href="/changelog/archive/">Full archive →</a></p>
  </div>
  {days.map(([day, items]) => (
    <div class="day">
      <div class="day-head">
        <span class="day-date">{fmt(day)}</span>
        {day === releases[0].publishedAt.slice(0,10) && <span class="today-badge">latest</span>}
      </div>
      {items.map((r) => (
        <div class="entry">
          <span class="tool-dot" style={`background:${TOOL_COLORS[r.tool] || '#888'}`}></span>
          <span class="tool-name">{r.tool}</span>
          <a class="tag-link" href={r.url} target="_blank" rel="noopener">{r.tag}</a>
          <span class="when">{rel(r.publishedAt)}</span>
        </div>
      ))}
    </div>
  ))}
  {days.length === 0 && <p class="empty">No stable releases in the feed yet — check back soon.</p>}
  <p class="updated">Feed refreshed {fetchedAt ? fetchedAt.slice(0,10) : 'recently'} · data from GitHub releases, auto-updated daily</p>
</section>

<style>
  .changelog { max-width: 720px; margin: 0 auto; }
  .feed-head h2 { font-family: var(--font-mono); font-size: 1.15rem; margin: 0 0 0.35rem; }
  .sub { font-size: 0.78rem; color: var(--fg-dim); margin: 0 0 1.5rem; }
  .sub a { color: var(--green); text-decoration: none; }
  .day { margin-bottom: 1.4rem; }
  .day-head { display: flex; gap: 0.6rem; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; margin-bottom: 0.5rem; }
  .day-date { font-family: var(--font-mono); font-size: 0.72rem; color: var(--amber); text-transform: uppercase; letter-spacing: 0.05em; }
  .today-badge { font-family: var(--font-mono); font-size: 0.6rem; background: var(--green); color: #000; padding: 0.1rem 0.45rem; border-radius: 3px; }
  .entry { display: flex; align-items: baseline; gap: 0.55rem; padding: 0.32rem 0; font-family: var(--font-mono); font-size: 0.82rem; }
  .tool-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; align-self: center; }
  .tool-name { color: var(--fg); min-width: 7.5rem; }
  .tag-link { color: var(--green); text-decoration: none; }
  .tag-link:hover { text-decoration: underline; }
  .when { margin-left: auto; color: var(--fg-dim); font-size: 0.68rem; }
  .empty { color: var(--fg-dim); font-family: var(--font-mono); font-size: 0.85rem; }
  .updated { font-size: 0.65rem; color: var(--fg-dim); margin-top: 1.5rem; }
</style>
