---
/**
 * Email capture — set PUBLIC_NEWSLETTER_ACTION to your provider form URL
 * (Beehiiv, Buttondown, ConvertKit, etc.). Without it, form shows setup hint.
 */
const action =
  import.meta.env.PUBLIC_NEWSLETTER_ACTION ||
  import.meta.env.NEWSLETTER_FORM_ACTION ||
  '';
const configured = Boolean(action);
---

<section class="newsletter" id="newsletter">
  <div class="newsletter-inner">
    <h2 class="newsletter-title">Coding Agent Weekly</h2>
    <p class="newsletter-sub">
      One email: security Bewares, leaderboard moves, and the few posts that matter.
      No just-shipped spam.
    </p>
    {configured ? (
      <form class="newsletter-form" action={action} method="post" target="_blank" rel="noopener">
        <label class="sr-only" for="newsletter-email">Email</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="you@company.com"
          autocomplete="email"
        />
        <button type="submit">Subscribe</button>
      </form>
    ) : (
      <div class="newsletter-fallback">
        <p>
          Newsletter form not configured yet. Set
          <code>PUBLIC_NEWSLETTER_ACTION</code> to your Beehiiv/Buttondown form action URL.
        </p>
        <p class="newsletter-alt">
          Meanwhile: follow
          <a href="https://x.com/terminalblog_en" target="_blank" rel="noopener">@terminalblog_en</a>
          · <a href="/rss.xml">RSS</a>
          · <a href="/cli/">CLI</a>
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .newsletter {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-alt);
  }
  .newsletter-inner { max-width: 520px; margin: 0 auto; text-align: center; }
  .newsletter-title {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    color: var(--fg-bright);
  }
  .newsletter-sub {
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin: 0 0 1rem;
    line-height: 1.45;
  }
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .newsletter-form input {
    flex: 1 1 200px;
    min-width: 180px;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .newsletter-form button {
    padding: 0.55rem 1rem;
    border: none;
    border-radius: 4px;
    background: var(--green);
    color: #000;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .newsletter-fallback {
    font-size: 0.8rem;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    line-height: 1.5;
  }
  .newsletter-fallback code {
    color: var(--green);
    font-size: 0.75rem;
  }
  .newsletter-alt { margin-top: 0.75rem; }
  .newsletter-alt a { color: var(--green); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
