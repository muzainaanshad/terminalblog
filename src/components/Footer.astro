---
import { SITE_TITLE, EDITOR_NAME, EDITOR_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="brand">
			<strong>{SITE_TITLE}</strong>
			<span>
				AI coding agent ecosystem coverage · Edited by
				<a href={EDITOR_URL} target="_blank" rel="noopener">{EDITOR_NAME}</a>
			</span>
		</div>
		<div class="copyright">
			&copy; {today.getFullYear()} — <a href="/about">about</a>
			· <a href="https://github.com/Anshad2u/terminalblog" target="_blank" rel="noopener">GitHub</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid rgba(255,255,255,0.06);
		background: rgba(15,10,26,0.5);
		padding: 3rem 1.5rem 4rem;
		margin-top: 4rem;
	}
	.inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		font-size: 0.875rem;
		color: rgba(255,255,255,0.4);
	}
	.brand { display: flex; flex-direction: column; gap: 0.25rem; }
	.brand strong { color: rgba(255,255,255,0.7); font-weight: 600; }
	.brand a, .copyright a { color: #14b8a6; text-decoration: none; }
	.brand a:hover, .copyright a:hover { text-decoration: underline; }
	@media (max-width: 600px) {
		.inner { flex-direction: column; gap: 1rem; }
	}
</style>
